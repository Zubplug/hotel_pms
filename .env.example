# Database
DATABASE_URL="postgresql://pms_user:pms_password@localhost:5432/hotel_pms?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"
# Public API rate limiting (required in production)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Signed CMS preview URLs (minimum 32 random characters)
CMS_PREVIEW_SECRET="replace-with-a-long-random-production-secret"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="development-secret-do-not-use-in-production"

# Vercel Cron authentication
CRON_SECRET="replace-with-a-long-random-production-secret"

# External Integrations (Scaffolded)
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""
RESEND_API_KEY=""
TERMII_API_KEY=""
# Beds24 Marketplace/reseller API credentials. Keep these server-side only.
BEDS24_ORGANIZATION_TOKEN=
BEDS24_ACCESS_TOKEN=
