<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>LodgeCore.LockAgent</AssemblyName>
    <RootNamespace>LodgeCore.LockAgent</RootNamespace>
    <Description>LodgeCore PMS hardware bridge for Deluns eLock (LockSDK V4.7)</Description>
    <Version>1.0.0</Version>
    <!-- Windows Service -->
    <WindowsPackageType>None</WindowsPackageType>
    <Prefer32Bit>true</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="8.0.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="System.Text.Json" Version="8.0.4" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- Copy Native DLLs to output dir -->
  <ItemGroup>
    <!-- Deluns SDK -->
    <None Include="LockSDK.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="des.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="DataReader.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="EasyD12_500.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="EasyZUSBMulti.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="HOOKS_M1.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="HSDApp.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="LockInfo.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="MF0SIM.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="PubFunc.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="PubFuns.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="RC500USB.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="RF50S.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="RF57S.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Rf_Rw.dll" CopyToOutputDirectory="PreserveNewest" />
    
    <!-- HS Lock SDK -->
    <Content Include="runtimes\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
