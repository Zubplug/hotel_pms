# ──────────────────────────────────────────────────────────────
# Stanzel Grand Resort — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.
# ──────────────────────────────────────────────────────────────

# ── LodgeCore API ──────────────────────────────────────────────
# Your property's Publishable Key (from LodgeCore → Settings → Standalone API).
# NOT prefixed with NEXT_PUBLIC_ — intentionally server-only.
LC_PUBLISHABLE_KEY=pk_live_REPLACE_ME

# LodgeCore API base URL (leave as-is unless self-hosted)
# LC_API_URL=https://lodgecore.vercel.app/api/v1/public

# ── Site Config ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://stanzelgrandresort.com

# ── Email / Contact Form ───────────────────────────────────────
# Resend API key — https://resend.com (free tier: 3,000 emails/month)
# If unset, enquiry submissions are only logged to console (dev mode).
RESEND_API_KEY=re_REPLACE_ME
CONTACT_EMAIL_TO=info@stanzelgrandresort.com
CONTACT_EMAIL_FROM=noreply@stanzelgrandresort.com
