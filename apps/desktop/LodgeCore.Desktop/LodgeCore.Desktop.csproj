<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<OutputType>WinExe</OutputType>
		<WindowsPackageType>MSIX</WindowsPackageType>
		<RootNamespace>LodgeCore.Desktop</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<EnableDefaultCssItems>false</EnableDefaultCssItems>

		<!-- Force x86 on Windows for Hardware SDK compatibility -->
		<RuntimeIdentifier>win-x86</RuntimeIdentifier>
		<PlatformTarget>x86</PlatformTarget>

		<!-- Display name -->
		<ApplicationTitle>LodgeCore Front Desk</ApplicationTitle>
		<!-- App Identifier -->
		<ApplicationId>com.lodgecore.frontdesk</ApplicationId>
		<!-- Versions -->
		<ApplicationDisplayVersion>1.2</ApplicationDisplayVersion>
		<ApplicationVersion>3</ApplicationVersion>

		<!-- MSIX Auto Update & Signing Configuration -->
		<GenerateAppInstallerFile>True</GenerateAppInstallerFile>
		<AppInstallerUri>https://hotel-pms-web-nine.vercel.app/api/desktop-update</AppInstallerUri>
		<AppxAutoUpdateEnabled>True</AppxAutoUpdateEnabled>
		<AppxUpdateFrequency>OnLaunch</AppxUpdateFrequency>
		<AppxShowProgress>True</AppxShowProgress>
		<AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
		<PackageCertificateKeyFile>Certificates\LodgeCore.pfx</PackageCertificateKeyFile>
		<PackageCertificatePassword>lodgecore2026</PackageCertificatePassword>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />
		<!-- Raw Assets (background audio, etc.) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
		<!-- SQLite & EF Core for Local Database -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.8" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.8" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.8" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
		<PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
		<PackageReference Include="System.IO.Ports" Version="8.0.0" />
		<PackageReference Include="System.Drawing.Common" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- Next.js Static Export Files -->
		<Content Include="wwwroot\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
	  <!-- Hardware SDK reference -->
	  <ProjectReference Include="..\..\..\hardware-agent\src\LodgeCore.HardwareAgent\LodgeCore.HardwareAgent.csproj" />
	</ItemGroup>

</Project>
