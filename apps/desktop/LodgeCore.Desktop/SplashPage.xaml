<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LodgeCore.Desktop.SplashPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#0B1220">

    <Grid>
        <!-- Animated background gradient via AbsoluteLayout -->
        <AbsoluteLayout HorizontalOptions="Fill" VerticalOptions="Fill">

            <!-- Deep dark background -->
            <BoxView
                AbsoluteLayout.LayoutFlags="All"
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                Color="#0B1220" />

            <!-- Subtle radial glow top-right -->
            <Ellipse
                AbsoluteLayout.LayoutFlags="PositionProportional"
                AbsoluteLayout.LayoutBounds="0.92, -0.15, 600, 600"
                Fill="#1D4ED8"
                Opacity="0.06" />

            <!-- Subtle radial glow bottom-left -->
            <Ellipse
                AbsoluteLayout.LayoutFlags="PositionProportional"
                AbsoluteLayout.LayoutBounds="-0.10, 1.10, 500, 500"
                Fill="#2563EB"
                Opacity="0.07" />

            <!-- Grid lines effect - horizontal -->
            <BoxView
                AbsoluteLayout.LayoutFlags="PositionProportional,WidthProportional"
                AbsoluteLayout.LayoutBounds="0.0, 0.3, 1, 1"
                Color="#1E293B"
                Opacity="0.40" />
            <BoxView
                AbsoluteLayout.LayoutFlags="PositionProportional,WidthProportional"
                AbsoluteLayout.LayoutBounds="0.0, 0.6, 1, 1"
                Color="#1E293B"
                Opacity="0.30" />

        </AbsoluteLayout>

        <!-- Main centered content -->
        <VerticalStackLayout
            x:Name="ContentPanel"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="0"
            Opacity="0">

            <!-- Logo icon container with glowing ring -->
            <Grid
                HorizontalOptions="Center"
                WidthRequest="140"
                HeightRequest="140">

                <!-- Outer glow ring -->
                <Ellipse
                    x:Name="OuterRing"
                    WidthRequest="140"
                    HeightRequest="140"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Stroke="#2563EB"
                    StrokeThickness="1"
                    Fill="Transparent"
                    Opacity="0.3"
                    Scale="1.0" />

                <!-- Inner ring -->
                <Ellipse
                    x:Name="InnerRing"
                    WidthRequest="112"
                    HeightRequest="112"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Stroke="#2563EB"
                    StrokeThickness="1.5"
                    Fill="#0F1E38"
                    Opacity="0.8" />

                <!-- Hotel building icon (Unicode-based text icon) -->
                <Label
                    Text="🏨"
                    FontSize="52"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />

            </Grid>

            <BoxView HeightRequest="32" Color="Transparent" />

            <!-- Brand name -->
            <Label
                Text="LodgeCore"
                FontSize="38"
                FontAttributes="Bold"
                TextColor="#FFFFFF"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                CharacterSpacing="-0.5" />

            <BoxView HeightRequest="6" Color="Transparent" />

            <!-- Tagline -->
            <Label
                Text="PROPERTY MANAGEMENT SYSTEM"
                FontSize="11"
                TextColor="#94A3B8"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                CharacterSpacing="2.5"
                FontAttributes="None" />

            <BoxView HeightRequest="48" Color="Transparent" />

            <!-- Loading bar container -->
            <Grid
                HorizontalOptions="Center"
                WidthRequest="220"
                HeightRequest="3">
                <!-- Track -->
                <BoxView
                    Color="#1E293B"
                    CornerRadius="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />
                <!-- Fill bar -->
                <BoxView
                    x:Name="LoadingBar"
                    Color="#2563EB"
                    CornerRadius="2"
                    HorizontalOptions="Start"
                    VerticalOptions="Fill"
                    WidthRequest="0" />
            </Grid>

            <BoxView HeightRequest="14" Color="Transparent" />

            <!-- Loading status text -->
            <Label
                x:Name="StatusLabel"
                Text="Initializing..."
                FontSize="12"
                TextColor="#475569"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                CharacterSpacing="0.3" />

        </VerticalStackLayout>

        <!-- Bottom version bar -->
        <VerticalStackLayout
            x:Name="VersionPanel"
            VerticalOptions="End"
            HorizontalOptions="Center"
            Spacing="4"
            Padding="0,0,0,24"
            Opacity="0">

            <!-- Divider -->
            <BoxView
                HeightRequest="1"
                WidthRequest="120"
                Color="#1E293B"
                HorizontalOptions="Center" />

            <BoxView HeightRequest="8" Color="Transparent" />

            <Label
                x:Name="VersionLabel"
                Text="v1.0.0"
                FontSize="11"
                TextColor="#334155"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                CharacterSpacing="0.5" />

            <Label
                Text="© 2026 LodgeCore · All rights reserved"
                FontSize="10"
                TextColor="#1E293B"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

    </Grid>
</ContentPage>
