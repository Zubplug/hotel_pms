  fromStatus         String?
  toStatus           String?
  performedBy        String            @db.Uuid
  reason             String?
  metadata           Json?
  idempotencyKey     String            @unique
  createdAt          DateTime          @default(now()) @db.Timestamptz

  @@index([propertyId, createdAt])
  @@index([posSessionId, createdAt])
  @@index([frontdeskSessionId, createdAt])
}

