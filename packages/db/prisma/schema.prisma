model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String       @db.Uuid
  property       Property     @relation(fields: [propertyId], references: [id])

  eventType     String
  aggregateType String
  aggregateId   String

  payload Json

  status String @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, DEAD_LETTER

  attemptCount  Int       @default(0)
  nextAttemptAt DateTime? @db.Timestamptz
  processedAt   DateTime? @db.Timestamptz

  lastError String?

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([propertyId, status, nextAttemptAt])
}

// -----------------------------------------------------------------------------
// OTA / CHANNEL MANAGER INTEGRATION
// -----------------------------------------------------------------------------

enum ChannelProvider {
  BEDS24
  CHANNEX
  BOOKING_COM
  EXPEDIA
}

model ChannelConnection {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String       @db.Uuid
  property       Property     @relation(fields: [propertyId], references: [id])

  provider           ChannelProvider
  status             String // 'CONNECTED', 'DEGRADED', 'ERROR', 'DISCONNECTED', 'SYNCING'
  externalPropertyId String
  credentialsRef     String // Encrypted string or vault reference

  lastSuccessfulSync DateTime? @db.Timestamptz
  lastInboundSync    DateTime? @db.Timestamptz
  lastOutboundSync   DateTime? @db.Timestamptz

  lastError   String?
  lastErrorAt DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  roomMappings     ChannelRoomMapping[]
  ratePlanMappings ChannelRatePlanMapping[]
  reservations     ChannelReservation[]

  @@unique([propertyId, provider])
}

model ChannelRoomMapping {
  id                  String            @id @default(uuid()) @db.Uuid
  channelConnectionId String            @db.Uuid
  channelConnection   ChannelConnection @relation(fields: [channelConnectionId], references: [id])

  lodgecoreRoomTypeId String? @db.Uuid
  externalRoomTypeId  String

  isActive Boolean @default(true)
  status   String  @default("MAPPED") // 'MAPPED', 'UNMAPPED', 'CONFLICT'

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([channelConnectionId, externalRoomTypeId])
}

model ChannelRatePlanMapping {
  id                  String            @id @default(uuid()) @db.Uuid
  channelConnectionId String            @db.Uuid
  channelConnection   ChannelConnection @relation(fields: [channelConnectionId], references: [id])

  lodgecoreRatePlanId String? @db.Uuid
  externalRatePlanId  String

  isActive Boolean @default(true)
  status   String  @default("MAPPED") // 'MAPPED', 'UNMAPPED', 'CONFLICT'

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([channelConnectionId, externalRatePlanId])
}

model ChannelReservation {
  id                  String            @id @default(uuid()) @db.Uuid
  channelConnectionId String            @db.Uuid
  channelConnection   ChannelConnection @relation(fields: [channelConnectionId], references: [id])

  externalReservationId String
  provider              ChannelProvider

  lodgecoreReservationId String? @db.Uuid // Nullable if import failed
  externalStatus         String // e.g. 'CONFIRMED', 'CANCELLED', 'MODIFIED'
  externalRevision       String?

  rawPayloadReference String? // Pointing to secure storage, DB size limit, or JSON string

  importedAt DateTime @default(now()) @db.Timestamptz
  modifiedAt DateTime @default(now()) @db.Timestamptz

  @@unique([channelConnectionId, externalReservationId])
}

model ChannelSyncEvent {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  organization   Organization    @relation(fields: [organizationId], references: [id])
  propertyId     String          @db.Uuid
  property       Property        @relation(fields: [propertyId], references: [id])
  provider       ChannelProvider

  direction String // 'INBOUND' | 'OUTBOUND'
  eventType String // 'RESERVATION', 'AVAILABILITY', 'RATE', 'ROOM_MAPPING'
  entityId  String? // LodgeCore ID being synced

  payload Json? // Used for audit details (do NOT store PCI/PII)

  status String // 'PENDING', 'PROCESSING', 'SUCCESS', 'FAILED', 'DEAD_LETTER'

  attemptCount  Int       @default(0)
  nextAttemptAt DateTime? @db.Timestamptz

  error     String?
  createdAt DateTime @default(now()) @db.Timestamptz
}

// -----------------------------------------------------------------------------
// SAAS CONTROL PLANE & BILLING
// -----------------------------------------------------------------------------

model BillingProduct {
  id                   String  @id @default(uuid()) @db.Uuid
  code                 String  @unique
  name                 String
  type                 String // 'BASE', 'ADDON'
  flutterwaveProductId String?
  active               Boolean @default(true)
  catalogVersion       Int     @default(1)
  metadata             Json?

  prices       BillingPrice[]
  entitlements Entitlement[]
  planItems    BillingPlanItem[]
  modules      Module[]
  organizationDiscounts OrganizationBillingDiscount[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model BillingPrice {
  id        String         @id @default(uuid()) @db.Uuid
  productId String         @db.Uuid
  product   BillingProduct @relation(fields: [productId], references: [id])

  flutterwavePriceId String? @unique
  amount             Int
  currency           String
  interval           String // 'month', 'year'
  catalogVersion     Int     @default(1)

  subscriptionItems SubscriptionItem[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([productId, interval, catalogVersion])
}

model BillingCustomer {
  id                    String       @id @default(uuid()) @db.Uuid
  organizationId        String       @unique @db.Uuid
  organization          Organization @relation(fields: [organizationId], references: [id])
  flutterwaveCustomerId String?      @unique

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model Subscription {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  planId         String?      @db.Uuid
  plan           BillingPlan? @relation(fields: [planId], references: [id])

  // Provider IDs are only present after a paid provider-backed subscription
  // exists. Trials are internal records and use internalReference instead.
  flutterwaveSubscriptionId String? @unique
  internalReference         String  @unique @default(uuid())
  status                    String // 'TRIALING', 'ACTIVE', 'PAST_DUE', 'PAUSED', 'CANCELED', 'INCOMPLETE'

  currentPeriodStart DateTime  @db.Timestamptz
  currentPeriodEnd   DateTime  @db.Timestamptz
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime? @db.Timestamptz
  trialEndsAt        DateTime? @db.Timestamptz
  scopePropertyIds   String[]  @default([]) @db.Uuid
  pastDueSince       DateTime? @db.Timestamptz

  items        SubscriptionItem[]
  trialHistory TrialHistory?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([organizationId, status])
  @@index([status, trialEndsAt])
}

// Permanent record of an organisation's one allowed lifetime trial. The
// unique organizationId is the database-level eligibility guarantee; the
// service still uses a transaction and handles unique conflicts explicitly.
model TrialHistory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @unique @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId String       @unique @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  planCode       String
  status         String       @default("STARTED") // STARTED | CONVERTED | EXPIRED | CANCELLED
  startedAt      DateTime     @db.Timestamptz
  endedAt        DateTime?    @db.Timestamptz
  source         String       @default("SELF_SERVE")
  metadata       Json?
  createdAt      DateTime     @default(now()) @db.Timestamptz
  updatedAt      DateTime     @updatedAt @db.Timestamptz

  @@index([status, endedAt])
}

model SubscriptionItem {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  priceId  String       @db.Uuid
  price    BillingPrice @relation(fields: [priceId], references: [id])
  quantity Int          @default(1)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([subscriptionId, priceId])
}

model Entitlement {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String?      @db.Uuid
  property       Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  productCode String
  product     BillingProduct @relation(fields: [productCode], references: [code])
  scopeKey    String         @unique

  status   String // 'ACTIVE', 'SUSPENDED'
  quantity Int?
  startsAt DateTime @default(now()) @db.Timestamptz

  activatedAt      DateTime  @default(now()) @db.Timestamptz
  suspendedAt      DateTime? @db.Timestamptz
  expiresAt        DateTime? @db.Timestamptz
  suspensionReason String?
  metadata         Json?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([organizationId, propertyId, status])
}

model BillingEvent {
  id                 String  @id @default(uuid()) @db.Uuid
  organizationId     String? @db.Uuid // Optional because some Flutterwave events might not have customer mapped yet
  flutterwaveEventId String  @unique
  type               String
  payload            Json

  createdAt DateTime @default(now()) @db.Timestamptz
}

model BillingInvoice {
  id                        String       @id @default(uuid()) @db.Uuid
  organizationId            String       @db.Uuid
  organization              Organization @relation(fields: [organizationId], references: [id])
  flutterwaveInvoiceId      String       @unique
  flutterwaveCustomerId     String?
  flutterwaveSubscriptionId String?
  status                    String
  currency                  String
  subtotal                  Int
  total                     Int
  amountPaid                Int
  amountDue                 Int
  periodStart               DateTime?    @db.Timestamptz
  periodEnd                 DateTime?    @db.Timestamptz
  hostedInvoiceUrl          String?
  invoicePdf                String?
  payload                   Json
  createdAt                 DateTime     @default(now()) @db.Timestamptz
  updatedAt                 DateTime     @updatedAt @db.Timestamptz

  @@index([organizationId, createdAt])
}

// -----------------------------------------------------------------------------
// LODGECORE CONTROL PLANE
// -----------------------------------------------------------------------------

model BillingPlan {
  id            String            @id @default(uuid()) @db.Uuid
  code          String            @unique
  name          String
  description   String?
  active        Boolean           @default(true)
  displayOrder  Int               @default(0)
  metadata      Json?
  items         BillingPlanItem[]
  subscriptions Subscription[]
  organizationDiscounts OrganizationBillingDiscount[]
  createdAt     DateTime          @default(now()) @db.Timestamptz
  updatedAt     DateTime          @updatedAt @db.Timestamptz
}

model OrganizationBillingDiscount {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String?      @db.Uuid
  plan           BillingPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  productId      String?      @db.Uuid
  product        BillingProduct? @relation(fields: [productId], references: [id], onDelete: Cascade)
