  currency       String?
  deviceId       String?
  terminalId     String?
  approvalId     String?
  businessDate   DateTime @db.Date
  idempotencyKey String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@index([propertyId, createdAt])
  @@index([operatorId, createdAt])
  @@index([supervisorId, createdAt])
}

enum FolioItemSource {
  ROOM_CHARGE
  DAY_USE_ROOM_CHARGE
  ROOM_UPGRADE
  ROOM_DOWNGRADE_CREDIT
  MANUAL
  POS
  RESTAURANT
  BAR
  SPA
  LAUNDRY
  TRANSPORT
  CITY_LEDGER
  TELEPHONE
  INTERNET
  MINIBAR
  OTHER
}

enum RevenueCategory {
  ROOM
  FNB
  OTHER
  TAX
}

model FolioItem {
  id      String @id @default(uuid()) @db.Uuid
  folioId String @db.Uuid
  folio   Folio  @relation(fields: [folioId], references: [id])

  reservationId String?      @db.Uuid
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  guestId String? @db.Uuid
  guest   Guest?  @relation(fields: [guestId], references: [id])

  businessDate    DateTime        @db.Date
  type            String // 'CHARGE' | 'PAYMENT' | 'REFUND' | 'DISCOUNT' | 'ADJUSTMENT' | 'TAX'
  source          FolioItemSource
  revenueCategory RevenueCategory @default(OTHER)
  // Fine-grained revenue classification used by event billing and reporting.
  // Null preserves the existing room/POS/manual folio behaviour.
  revenueClass    String?

  description String

  quantity   Decimal @default(1) @db.Decimal(10, 4)
  unitAmount Decimal @db.Decimal(18, 4)
  amount     Decimal @db.Decimal(18, 4)
  currency   String

  baseAmount   Decimal  @db.Decimal(18, 4)
  exchangeRate Decimal? @db.Decimal(18, 8)

  taxId              String? @db.Uuid
  discountId         String? @db.Uuid
  posTransactionId   String?
  discountApprovalId String?
  targetFolioItemId  String? @db.Uuid

  voidedAt   DateTime? @db.Timestamptz
  voidedBy   String?   @db.Uuid
  voidReason String?

  postedBy String @db.Uuid

  // Late Posting & Audit Fields
  deviceId             String?
  operationId          String?
  isLatePosting        Boolean     @default(false)
  latePostingReason    String?
  originalBusinessDate DateTime?   @db.Date
  syncedAt             DateTime?   @db.Timestamptz
  nightAuditRunId      String?     @db.Uuid
  nightAudit           NightAudit? @relation(fields: [nightAuditRunId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([folioId, operationId])
  @@index([revenueClass])
}

enum PaymentMethod {
  COMPLIMENTARY
  CASH
  BANK_TRANSFER
  POS
  CARD
  CARD_OFFLINE
  PAYMENT_GATEWAY
  MOBILE_PAYMENT
  CHEQUE
  ROOM_CHARGE
  CITY_LEDGER
  OTHER
}

model Payment {
  id                 String            @id @default(uuid()) @db.Uuid
  folioId            String            @db.Uuid
  folio              Folio             @relation(fields: [folioId], references: [id])
  eventInvoiceId     String?           @db.Uuid
  eventInvoice       EventInvoice?     @relation(fields: [eventInvoiceId], references: [id])
  reservationId      String?           @db.Uuid
  reservation        Reservation?      @relation(fields: [reservationId], references: [id])
  frontdeskSessionId String?           @db.Uuid
  frontdeskSession   FrontdeskSession? @relation(fields: [frontdeskSessionId], references: [id])
  propertyId         String            @db.Uuid
  property           Property          @relation(fields: [propertyId], references: [id])

  method                PaymentMethod
  collectionSource      String        @default("FRONT_DESK") // FRONT_DESK | RECEIVABLES | OTHER
  provider              String?
  providerTransactionId String?
  providerRef           String?
  terminalId            String?
  reference             String?
  authorizationCode     String?

  amount       Decimal  @db.Decimal(18, 4)
  currency     String
  baseAmount   Decimal  @db.Decimal(18, 4)
  exchangeRate Decimal? @db.Decimal(18, 8)

  status         String // 'PENDING' | 'COMPLETED' | 'FAILED' | 'REFUNDED'
  businessDate   DateTime @db.Date
  idempotencyKey String?  @unique
  receiptNumber  String?  @unique

  receivedBy String  @db.Uuid // Staff ID
  notes      String?

  // Late Posting & Audit Fields
  deviceId             String?
  operationId          String?
  isLatePosting        Boolean   @default(false)
  latePostingReason    String?
  originalBusinessDate DateTime? @db.Date
  syncedAt             DateTime? @db.Timestamptz

  // Transaction Verification
  verificationStatus TransactionVerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?                     @db.Timestamptz
  verifiedById       String?                       @db.Uuid
  verificationNotes  String?

  refunds               Refund[]
  refundRequests        RefundRequest[]
  transactionExceptions TransactionException[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([frontdeskSessionId])
  @@index([propertyId, businessDate])
}

model Refund {
  id         String   @id @default(uuid()) @db.Uuid
  paymentId  String?  @db.Uuid
  payment    Payment? @relation(fields: [paymentId], references: [id])
  folioId    String?  @db.Uuid
  folio      Folio?   @relation(fields: [folioId], references: [id])
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])

  refundRequestId String?        @unique @db.Uuid
  refundRequest   RefundRequest? @relation(fields: [refundRequestId], references: [id])

  amount           Decimal @db.Decimal(18, 4)
  currency         String
  method           String  @default("ORIGINAL_PAYMENT")
  reason           String
  authorizedBy     String  @db.Uuid
  providerRefundId String?

  bookingPaymentTransactionId String?                    @unique @db.Uuid
  bookingPaymentTransaction   BookingPaymentTransaction? @relation("BookingPaymentLateRefund", fields: [bookingPaymentTransactionId], references: [id])

  status         String // 'PENDING' | 'COMPLETED' | 'FAILED'
  businessDate   DateTime @db.Date
  idempotencyKey String?  @unique

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([propertyId, businessDate])
}

enum RefundRequestStatus {
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
  CANCELLED
  EXPIRED
}

model RefundRequest {
  id                String  @id @default(uuid()) @db.Uuid
  organizationId    String  @db.Uuid
  propertyId        String  @db.Uuid
  reservationId     String? @db.Uuid
  folioId           String? @db.Uuid
  paymentId         String? @db.Uuid
  guestId           String? @db.Uuid
  cityLedgerEntryId String? @db.Uuid

  organization    Organization     @relation(fields: [organizationId], references: [id])
  property        Property         @relation(fields: [propertyId], references: [id])
  reservation     Reservation?     @relation(fields: [reservationId], references: [id])
  folio           Folio?           @relation(fields: [folioId], references: [id])
  payment         Payment?         @relation(fields: [paymentId], references: [id])
  cityLedgerEntry CityLedgerEntry? @relation(fields: [cityLedgerEntryId], references: [id])

  requestedAmount            Decimal             @db.Decimal(18, 4)
  approvedAmount             Decimal?            @db.Decimal(18, 4)
  currency                   String
  requestedMethod            String              @default("ORIGINAL_PAYMENT")
  approvedMethod             String?
  bankAccountName            String?
  bankAccountNumberEncrypted String?
  bankAccountLast4           String?
  bankName                   String?
  bankCode                   String?
  category                   String
  reason                     String
  supportingNotes            String?
  status                     RefundRequestStatus @default(PENDING_APPROVAL)

  requestedById       String  @db.Uuid
  currentApproverId   String? @db.Uuid
  approvalRoleId      String? @db.Uuid
  currentApprovalStep Int     @default(1)
  requestedBy         User    @relation("RefundRequestedBy", fields: [requestedById], references: [id])
  currentApprover     User?   @relation("RefundCurrentApprover", fields: [currentApproverId], references: [id])
  approvalRole        Role?   @relation(fields: [approvalRoleId], references: [id])

  idempotencyKey String    @unique
  expiresAt      DateTime? @db.Timestamptz
