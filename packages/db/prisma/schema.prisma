enum EventStatus {
  INQUIRY
  TENTATIVE
  CONFIRMED
  IN_SERVICE
  COMPLETED
  CANCELLED
}

enum EventFinancialStatus {
  QUOTE
  DEPOSIT_DUE
  PARTIALLY_PAID
  PAID
  AR_OUTSTANDING
  SETTLED
}

enum BeoStatus {
  DRAFT
  REVIEW
  APPROVED
  ISSUED
  AMENDED
}

model Event {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])

  name         String
  contactName  String
  contactPhone String?
  contactEmail String?

  guestId            String?           @db.Uuid
  guest              Guest?            @relation(fields: [guestId], references: [id])
  corporateAccountId String?           @db.Uuid
  corporateAccount   CorporateAccount? @relation(fields: [corporateAccountId], references: [id])

  status          EventStatus          @default(INQUIRY)
  financialStatus EventFinancialStatus @default(QUOTE)

  startDate DateTime @db.Timestamptz
  endDate   DateTime @db.Timestamptz

  expectedGuests Int
  actualGuests   Int?
  notes          String?

  banquetPackageId String?         @db.Uuid
  banquetPackage   BanquetPackage? @relation(fields: [banquetPackageId], references: [id])

  recurrenceRule Json? // Structured JSON: { frequency: "WEEKLY", daysOfWeek: [2,6], until: "2026-12-31" }

  bookings         EventBooking[]
  invoices         EventInvoice[]
  leaseContract    LeaseContract?
  beos             BanquetEventOrder[]
  changeOrders     EventChangeOrder[]
  referralBookings ReferralBooking[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model EventBooking {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id])

  hallId String @db.Uuid
  hall   Hall   @relation(fields: [hallId], references: [id])

  startTime DateTime @db.Timestamptz
  endTime   DateTime @db.Timestamptz

  // Buffers to prevent setup/teardown conflicts
  setupBufferMinutes    Int @default(0)
  teardownBufferMinutes Int @default(0)

  status             String  @default("ACTIVE") // ACTIVE, CANCELLED
  isException        Boolean @default(false)
  cancellationReason String?

  equipmentBookings EventEquipmentBooking[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // NOTE: Database transactional constraints should enforce no overlap for (hallId, startTime - setup, endTime + teardown)
  @@index([hallId, startTime, endTime])
}

model LeaseContract {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])

  hallId String @db.Uuid
  hall   Hall   @relation(fields: [hallId], references: [id])

  corporateAccountId String?           @db.Uuid
  corporateAccount   CorporateAccount? @relation(fields: [corporateAccountId], references: [id])
  eventId            String?           @unique @db.Uuid
  event              Event?            @relation(fields: [eventId], references: [id])

  contactName  String
  contactEmail String?

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  usageFrequency   String  @default("WEEKLY") // PER_USE, DAILY, WEEKLY
  billingFrequency String // PER_USE, WEEKLY, MONTHLY, QUARTERLY, YEARLY
  billingDates     Json?
  usageDays        Json?
  startTime        String?
  endTime          String?
  currency         String  @default("NGN")
  rate             Decimal @db.Decimal(18, 4)
  depositAmount    Decimal @default(0) @db.Decimal(18, 4)

  isActive          Boolean @default(true)
  cancellationTerms String?

  schedules LeaseBillingSchedule[]
  segments  LeaseContractSegment[]
  createdBy String?                @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model LeaseContractSegment {
  id              String                     @id @default(uuid()) @db.Uuid
  leaseContractId String                     @db.Uuid
  leaseContract   LeaseContract              @relation(fields: [leaseContractId], references: [id], onDelete: Cascade)
  hallId          String                     @db.Uuid
  hall            Hall                       @relation(fields: [hallId], references: [id])
  usageDays       Json
  startTime       String
  endTime         String
  rate            Decimal                    @db.Decimal(18, 4)
  isActive        Boolean                    @default(true)
  scheduleLines   LeaseBillingScheduleLine[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([leaseContractId])
  @@index([hallId, startTime, endTime])
}

model LeaseBillingSchedule {
  id              String        @id @default(uuid()) @db.Uuid
  leaseContractId String        @db.Uuid
  leaseContract   LeaseContract @relation(fields: [leaseContractId], references: [id])

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  dueDate     DateTime @db.Date
  usageCount  Int      @default(1)
  amount      Decimal  @db.Decimal(18, 4)
  status      String   @default("PENDING") // PENDING, INVOICED, PAID, VOID

  invoiceId String?                    @unique @db.Uuid
  invoice   EventInvoice?              @relation(fields: [invoiceId], references: [id])
  lines     LeaseBillingScheduleLine[]

  createdAt DateTime @default(now()) @db.Timestamptz
}

model LeaseBillingScheduleLine {
  id         String               @id @default(uuid()) @db.Uuid
  scheduleId String               @db.Uuid
  schedule   LeaseBillingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  segmentId  String               @db.Uuid
  segment    LeaseContractSegment @relation(fields: [segmentId], references: [id], onDelete: Restrict)
  usageCount Int                  @default(0)
  amount     Decimal              @db.Decimal(18, 4)

  @@unique([scheduleId, segmentId])
  @@index([segmentId])
}

model BanquetEventOrder {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id])

  version Int       @default(1)
  status  BeoStatus @default(DRAFT)

  // Denormalized snapshot of event details for immutable operational contract
  snapshotData Json

  issuedAt   DateTime? @db.Timestamptz
  approvedBy String?   @db.Uuid // Staff ID

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([eventId, version])
}

model EventChangeOrder {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id])

  description      String
  commercialImpact Decimal @default(0) @db.Decimal(18, 4) // Added/removed cost

  status String @default("PENDING") // PENDING, APPROVED, REJECTED

  requestedBy String? @db.Uuid
  approvedBy  String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
}

model EventInvoice {
  id                   String                @id @default(uuid()) @db.Uuid
  eventId              String?               @db.Uuid
  event                Event?                @relation(fields: [eventId], references: [id])
  propertyId           String?               @db.Uuid
  property             Property?             @relation(fields: [propertyId], references: [id])
  leaseBillingSchedule LeaseBillingSchedule?

  subTotal      Decimal @default(0) @db.Decimal(18, 4)
  totalDiscount Decimal @default(0) @db.Decimal(18, 4)
  totalTax      Decimal @default(0) @db.Decimal(18, 4)
  totalAmount   Decimal @db.Decimal(18, 4)
  paidAmount    Decimal @db.Decimal(18, 4)
  currency      String  @default("NGN")

  status String @default("UNPAID") // DRAFT, UNPAID, PARTIAL, PAID, VOID

  // Operational approval lifecycle is deliberately separate from payment status.
  // A draft can be reviewed without creating a folio charge or city-ledger AR.
  workflowStatus    String    @default("DRAFT") // DRAFT, SUBMITTED, IN_REVIEW, APPROVED, REJECTED, ISSUED
  requestedDiscount Decimal   @default(0) @db.Decimal(18, 4)
  discountReason    String?
  submittedBy       String?   @db.Uuid
  submittedAt       DateTime? @db.Timestamptz
  reviewedBy        String?   @db.Uuid
  reviewedAt        DateTime? @db.Timestamptz
  approvedBy        String?   @db.Uuid
  approvedAt        DateTime? @db.Timestamptz
  rejectedBy        String?   @db.Uuid
  rejectedAt        DateTime? @db.Timestamptz
  rejectionReason   String?
  issuedBy          String?   @db.Uuid
  issuedAt          DateTime? @db.Timestamptz
  version           Int       @default(1)

  // Link to existing financial infrastructure
  folioId String? @db.Uuid
  folio   Folio?  @relation(fields: [folioId], references: [id])

  cityLedgerAccountId String?            @db.Uuid
  cityLedgerAccount   CityLedgerAccount? @relation(fields: [cityLedgerAccountId], references: [id])
  cityLedgerInvoice   CityLedgerInvoice?

  items    EventInvoiceItem[]
  payments Payment[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([workflowStatus])
  @@index([eventId, workflowStatus])
}

model EventInvoiceItem {
  id        String       @id @default(uuid()) @db.Uuid
  invoiceId String       @db.Uuid
  invoice   EventInvoice @relation(fields: [invoiceId], references: [id])

  description String
  category    String  @default("OTHER") // HALL, EQUIPMENT, FOOD, OTHER
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(18, 4)

  grossAmount       Decimal @default(0) @db.Decimal(18, 4)
  requestedDiscount Decimal @default(0) @db.Decimal(18, 4)
  discountAmount    Decimal @default(0) @db.Decimal(18, 4)
  taxAmount         Decimal @default(0) @db.Decimal(18, 4)
  totalPrice        Decimal @db.Decimal(18, 4)

  discountReason     String?
  discountApprovedBy String?   @db.Uuid
  discountApprovedAt DateTime? @db.Timestamptz
  discountStatus     String    @default("PENDING") // PENDING, APPROVED, REJECTED

  taxId      String? @db.Uuid
  discountId String? @db.Uuid
}

