model OrganizationApprovalRequest {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation("OrganizationApprovalRequests", fields: [organizationId], references: [id], onDelete: Cascade)
  requestedById  String   @db.Uuid
  requestedBy    User     @relation("OrganizationApprovalRequestedBy", fields: [requestedById], references: [id])
  reviewedById   String?  @db.Uuid
  reviewedBy     User?    @relation("OrganizationApprovalReviewedBy", fields: [reviewedById], references: [id])
  type           String
  status         String   @default("PENDING")
  reason         String?
  payload        Json
  reviewNotes    String?
  requestedAt    DateTime @default(now()) @db.Timestamptz
  reviewedAt     DateTime? @db.Timestamptz
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  @@index([organizationId, status])
  @@index([requestedById, status])
}

/// Human portal identity for an approved PMS CorporateAccount. This is
/// separate from server-to-server API credentials and is scoped to one
/// corporate account and property.
model CorporatePortalIdentity {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @db.Uuid
  propertyId         String    @db.Uuid
  corporateAccountId String    @unique @db.Uuid
  email              String
  passwordHash       String?
  passwordSetAt      DateTime? @db.Timestamptz
  status             String    @default("ACTIVE") // ACTIVE | SUSPENDED | REVOKED
  lastLoginAt        DateTime? @db.Timestamptz
  createdAt          DateTime  @default(now()) @db.Timestamptz
  updatedAt          DateTime  @updatedAt @db.Timestamptz

  organization     Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property         Property                    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  corporateAccount CorporateAccount            @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)
  loginTokens      CorporatePortalLoginToken[]
  sessions         CorporatePortalSession[]

  @@unique([propertyId, email])
  @@index([organizationId, propertyId, status])
}

model CorporatePortalLoginToken {
  id         String    @id @default(uuid()) @db.Uuid
  identityId String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz
  usedAt     DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  identity CorporatePortalIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, expiresAt, usedAt])
}

model CorporatePortalSession {
  id         String    @id @default(uuid()) @db.Uuid
  identityId String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz
  revokedAt  DateTime? @db.Timestamptz
  lastUsedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  identity CorporatePortalIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, expiresAt, revokedAt])
}

model Building {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @db.Uuid
  property    Property @relation(fields: [propertyId], references: [id])
  name        String
  code        String
  floorsCount Int      @map("floors")
  description String?
  isActive    Boolean  @default(true)

  floors Floor[]
  rooms  Room[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model Floor {
  id          String   @id @default(uuid()) @db.Uuid
  buildingId  String   @db.Uuid
  building    Building @relation(fields: [buildingId], references: [id])
  propertyId  String   @db.Uuid
  number      Int
  name        String
  code        String?
  description String?
  isActive    Boolean  @default(true)

  rooms Room[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([buildingId, number])
}

model RoomType {
  id                      String   @id @default(uuid()) @db.Uuid
  propertyId              String   @db.Uuid
  property                Property @relation(fields: [propertyId], references: [id])
  name                    String
  code                    String
  description             String?
  maxOccupancy            Int
  maxAdults               Int      @default(2)
  maxChildren             Int      @default(0)
  defaultBedConfig        String
  amenities               String[]
  photos                  String[]
  baseRate                Decimal  @db.Decimal(18, 4)
  currency                String
  isActive                Boolean  @default(true)
  referralEnabled         Boolean  @default(true)
  referralCommissionMode  String   @default("PERCENT") // PERCENT | AMOUNT
  referralCommissionValue Decimal  @default(0) @db.Decimal(18, 4)

  rooms              Room[]
  rates              Rate[]
  seasonalRates      SeasonalRate[]
  referralBookings   ReferralBooking[]
  reachMedia         ReachPropertyMedia[]
  corporateRateRules CorporateRateRule[]

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz
}

enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  DIRTY
  CLEANING
  CLEAN
  INSPECTED
  OUT_OF_ORDER
  OUT_OF_SERVICE
  MAINTENANCE
  BLOCKED
}

enum HousekeepingStatus {
  PENDING
  ASSIGNED
  CLEANING
  CLEAN
  INSPECTED
  CANCELLED
  MAINTENANCE_REQUIRED
}

enum RoomMaintenanceStatus {
  NONE
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum RoomStatusSource {
  MANUAL
  CHECK_IN
  CHECK_OUT
  HOUSEKEEPING
  MAINTENANCE
  RESERVATION
  SYSTEM
}

model Room {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  buildingId String   @db.Uuid
  building   Building @relation(fields: [buildingId], references: [id])
  floorId    String   @db.Uuid
  floor      Floor    @relation(fields: [floorId], references: [id])
  roomTypeId String   @db.Uuid
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])

  number           String
  code             String?  @unique // optional globally-unique identifier
  displayName      String?
  name             String?
  maxOccupancy     Int
  maxAdults        Int      @default(2)
  maxChildren      Int      @default(0)
  floorPosition    Int? // position on floor plan
  bedConfiguration String
  squareMeters     Decimal? @db.Decimal(8, 2)
  view             String?
  amenities        String[]
  photos           String[]
  description      String?

  status             RoomStatus
  housekeepingStatus HousekeepingStatus
  maintenanceStatus  RoomMaintenanceStatus @default(NONE)
  isAccessible       Boolean               @default(false)
  isActive           Boolean               @default(true)
  notes              String?

  roomBlocks                    RoomBlock[]
  reservationRooms              ReservationRoom[]
  housekeepingTasks             HousekeepingTask[]
  doorLocks                     DoorLock[]
  lockCredentials               LockCredential[]
  lockOperations                LockOperation[]
  statusHistory                 RoomStatusHistory[]
  guestAmenityStockTransactions StockTransaction[]  @relation("GuestAmenityStockRoom")

  createdAt     DateTime       @default(now()) @db.Timestamptz
  updatedAt     DateTime       @updatedAt @db.Timestamptz
  deletedAt     DateTime?      @db.Timestamptz
  laundryOrders LaundryOrder[]

  @@unique([propertyId, number])
}

model Amenity {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  name       String
  category   String
  icon       String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

enum BlockType {
  MAINTENANCE
  OUT_OF_ORDER
  OUT_OF_SERVICE
  HOUSE_USE
  OWNER_USE
  COMPLIMENTARY
  INVENTORY_BLOCK
  DEEP_CLEAN
  OTHER
}

model RoomBlock {
  id           String    @id @default(uuid()) @db.Uuid
  roomId       String    @db.Uuid
  room         Room      @relation(fields: [roomId], references: [id])
  propertyId   String    @db.Uuid
  type         BlockType
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  reason       String
  notes        String?
  authorizedBy String    @db.Uuid // Staff ID
  status       String    @default("ACTIVE") // ACTIVE | CANCELLED

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model RoomStatusHistory {
  id         String @id @default(uuid()) @db.Uuid
  roomId     String @db.Uuid
  room       Room   @relation(fields: [roomId], references: [id])
  propertyId String @db.Uuid

  previousStatus RoomStatus
  newStatus      RoomStatus
  source         RoomStatusSource
  referenceId    String? // e.g. reservation ID, block ID
  changedBy      String?          @db.Uuid // Staff ID; null if system
  reason         String?

  createdAt DateTime @default(now()) @db.Timestamptz
}

// -----------------------------------------------------------------------------
// AVAILABILITY & RATES
// -----------------------------------------------------------------------------

enum RatePlanType {
  STANDARD
  CORPORATE
  GROUP
  PROMOTIONAL
  SEASONAL
  GOVERNMENT
  CUSTOM
}

model RatePlan {
  id                    String       @id @default(uuid()) @db.Uuid
  propertyId            String       @db.Uuid
  property              Property     @relation(fields: [propertyId], references: [id])
  name                  String
  code                  String
  description           String?
  type                  RatePlanType
  isPublic              Boolean      @default(true)
  isActive              Boolean      @default(true)
  includeFoodAllocation Boolean      @default(false)

  minStay            Int        @default(1)
  maxStay            Int?
  advanceBookingDays Int?
  blackoutDates      DateTime[] @db.Date

  cancellationPolicyId String?             @db.Uuid
  cancellationPolicy   CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])
  depositPolicyId      String?             @db.Uuid
  depositPolicy        DepositPolicy?      @relation(fields: [depositPolicyId], references: [id])
  noShowPolicyId       String?             @db.Uuid
  noShowPolicy         NoShowPolicy?       @relation(fields: [noShowPolicyId], references: [id])

  rates              Rate[]
  seasonalRates      SeasonalRate[]
  corporateRateRules CorporateRateRule[]
  reservations       Reservation[]

  createdAt        DateTime           @default(now()) @db.Timestamptz
  updatedAt        DateTime           @updatedAt @db.Timestamptz
  deletedAt        DateTime?          @db.Timestamptz
  CorporateAccount CorporateAccount[]
}

model Rate {
  id         String   @id @default(uuid()) @db.Uuid
  ratePlanId String   @db.Uuid
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id])
  roomTypeId String   @db.Uuid
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])
  propertyId String   @db.Uuid

  amount   Decimal @db.Decimal(18, 4)
  currency String

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  dayOfWeek     Int[] // 0=Sun, 6=Sat

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model SeasonalRate {
  id         String   @id @default(uuid()) @db.Uuid
  ratePlanId String   @db.Uuid
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id])
  roomTypeId String   @db.Uuid
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])

  name     String
  amount   Decimal @db.Decimal(18, 4)
  currency String

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model CancellationPolicy {
  id                 String   @id @default(uuid()) @db.Uuid
  propertyId         String   @db.Uuid
  property           Property @relation(fields: [propertyId], references: [id])
  name               String
  type               String // 'FLEXIBLE' | 'MODERATE' | 'STRICT' | 'NON_REFUNDABLE'
  hoursBeforeCheckIn Int
  penaltyType        String // 'NONE' | 'FIRST_NIGHT' | 'PERCENTAGE' | 'FLAT'
  penaltyValue       Decimal  @db.Decimal(18, 4)

  ratePlans          RatePlan[]
  reservations       Reservation[]
  corporateRateRules CorporateRateRule[]
}

model DepositPolicy {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @db.Uuid
  property     Property @relation(fields: [propertyId], references: [id])
  name         String
  required     Boolean
  type         String // 'PERCENTAGE' | 'FLAT' | 'FIRST_NIGHT'
  value        Decimal  @db.Decimal(18, 4)
  dueAtBooking Boolean

  ratePlans          RatePlan[]
  reservations       Reservation[]
  corporateRateRules CorporateRateRule[]
}

model NoShowPolicy {
  id                            String   @id @default(uuid()) @db.Uuid
  propertyId                    String   @db.Uuid
  property                      Property @relation(fields: [propertyId], references: [id])
  name                          String
  chargeType                    String // 'NONE' | 'FIRST_NIGHT' | 'FULL_STAY' | 'PERCENTAGE'
  chargeValue                   Decimal  @db.Decimal(18, 4)
  cutoffTime                    String   @default("02:00")
  gracePeriodMinutes            Int      @default(0)
  refundableUnusedNights        Boolean  @default(true)
  allowReinstatement            Boolean  @default(true)
  reinstatementRequiresApproval Boolean  @default(true)
  exceptionRequiresApproval     Boolean  @default(true)

  ratePlans          RatePlan[]
  reservations       Reservation[]
  corporateRateRules CorporateRateRule[]
}

model ExchangeRate {
  id            String   @id @default(uuid()) @db.Uuid
  propertyId    String   @db.Uuid
  property      Property @relation(fields: [propertyId], references: [id])
  fromCurrency  String
  toCurrency    String
  rate          Decimal  @db.Decimal(18, 8)
  source        String
  effectiveDate DateTime @db.Date
  createdBy     String   @db.Uuid // Staff ID

