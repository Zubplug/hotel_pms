model NotificationTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  event          String
  channels       String[]
  subject        String?
  bodyHtml       String?
  bodySms        String?
  variables      String[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String?      @db.Uuid

  userId    String? @db.Uuid
  userEmail String?
  userRole  String?

  action     String
  resource   String
  resourceId String

  previousValue Json?
  newValue      Json?

  ipAddress String?
  userAgent String?
  requestId String

  createdAt DateTime @default(now()) @db.Timestamptz
}

model AgentEnrollmentToken {
  id         String         @id @default(uuid()) @db.Uuid
  propertyId String         @db.Uuid
  property   Property       @relation(fields: [propertyId], references: [id])
  agentId    String?        @db.Uuid
  agent      HardwareAgent? @relation(fields: [agentId], references: [id])
  tokenHash  String         @unique // bcrypt hash — never store plain
  expiresAt  DateTime       @db.Timestamptz
  usedAt     DateTime?      @db.Timestamptz
  createdBy  String         @db.Uuid
  createdAt  DateTime       @default(now()) @db.Timestamptz

  @@index([propertyId])
}

enum ReservationPriorityType {
  VIP
  LOYALTY
  ACCESSIBILITY
  BACK_TO_BACK
  MANAGEMENT
  SPECIAL_REQUEST
}

model ReservationPriority {
  id            String                  @id @default(uuid()) @db.Uuid
  reservationId String                  @db.Uuid
  reservation   Reservation             @relation(fields: [reservationId], references: [id])
  type          ReservationPriorityType
  level         Int                     @default(1)
  reason        String?
  createdBy     String?                 @db.Uuid
  expiresAt     DateTime?               @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([reservationId, type])
}

