  updatedAt      DateTime  @updatedAt @db.Timestamptz

  refund    Refund?
  approvals RefundApproval[]

  @@index([propertyId, status])
  @@index([paymentId, status])
  @@index([cityLedgerEntryId, status])
  @@index([currentApproverId, status])
}

model RefundApproval {
  id              String   @id @default(uuid()) @db.Uuid
  refundRequestId String   @db.Uuid
  approverId      String   @db.Uuid
  decision        String
  stepOrder       Int      @default(1)
  comments        String?
  decidedAt       DateTime @default(now()) @db.Timestamptz

  refundRequest RefundRequest @relation(fields: [refundRequestId], references: [id])
  approver      User          @relation("RefundApprover", fields: [approverId], references: [id])

  @@index([refundRequestId, decidedAt])
}

model RefundApprovalRule {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
