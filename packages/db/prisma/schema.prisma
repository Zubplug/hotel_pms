  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  @@index([userId, expiresAt, usedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  @@index([userId, expiresAt, usedAt])
}

model EmployeeInvitation {
  id             String       @id @default(uuid()) @db.Uuid
  staffId        String       @db.Uuid
  staff          Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation("EmployeeInvitationUser", fields: [userId], references: [id], onDelete: Cascade)
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  expiresAt      DateTime     @db.Timestamptz
  acceptedAt     DateTime?    @db.Timestamptz
  invitedById    String       @db.Uuid
  invitedBy      User         @relation("EmployeeInvitationInvitedBy", fields: [invitedById], references: [id])
  createdAt      DateTime     @default(now()) @db.Timestamptz
  updatedAt      DateTime     @updatedAt @db.Timestamptz

  @@index([staffId])
  @@index([userId])
  @@index([organizationId, expiresAt, acceptedAt])
}

// -----------------------------------------------------------------------------
// INTEGRATIONS
// -----------------------------------------------------------------------------

model HardwareAgent {
  id                 String    @id @default(uuid()) @db.Uuid
  propertyId         String    @db.Uuid
  property           Property  @relation(fields: [propertyId], references: [id])
  name               String
  deviceId           String    @unique
  status             String // 'ONLINE' | 'OFFLINE'
  hardwareStatus     String    @default("UNKNOWN") // 'READY' | 'DEGRADED' | 'OFFLINE' | 'UNKNOWN'
  agentSecretHash    String // bcrypt hash of the generated agent secret
  agentVersion       String?
  sdkVersion         String?
  hostname           String?
  sdkLockType        Int? // 4 = RF57, 5 = RF50
  comPort            String? // e.g. "COM3"
  lastHeartbeat      DateTime? @db.Timestamptz
  lastConnectedAt    DateTime? @db.Timestamptz
  lastDisconnectedAt DateTime? @db.Timestamptz
  enabled            Boolean   @default(true)
  createdAt          DateTime  @default(now()) @db.Timestamptz

  operations       LockOperation[]
  commands         LockCommand[]
  lockEvents       LockEvent[]
  enrollmentTokens AgentEnrollmentToken[]
}

model DoorLock {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  roomId     String?  @db.Uuid
  room       Room?    @relation(fields: [roomId], references: [id])

  lockCode     String    @unique
  provider     String
  serialNumber String?
  status       String // 'ONLINE' | 'OFFLINE' | 'ERROR'
  batteryLevel Int?
  lastSyncAt   DateTime? @db.Timestamptz
  metadata     Json?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  credentials LockCredential[]
  operations  LockOperation[]
}

model LockCredential {
  id            String      @id @default(uuid()) @db.Uuid
  reservationId String      @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  guestId       String?     @db.Uuid
  guest         Guest?      @relation(fields: [guestId], references: [id])
  roomId        String      @db.Uuid
  room          Room        @relation(fields: [roomId], references: [id])
  lockId        String      @db.Uuid
  lock          DoorLock    @relation(fields: [lockId], references: [id])

  credentialType String // 'rfid' | 'pin' | 'mobile' | 'nfc'
  status         String // 'PENDING' | 'ACTIVE' | 'REVOKED' | 'EXPIRED' | 'FAILED'
  validFrom      DateTime @db.Timestamptz
  validUntil     DateTime @db.Timestamptz

  cardSerialNumber String?
  issueOperationId String? @db.Uuid

  issuedAt  DateTime? @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz
  metadata  Json?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model LockOperation {
  id             String       @id @default(uuid()) @db.Uuid
  idempotencyKey String?      @unique
  propertyId     String       @db.Uuid
  property       Property     @relation(fields: [propertyId], references: [id])
  lockId         String?      @db.Uuid
  lock           DoorLock?    @relation(fields: [lockId], references: [id])
  roomId         String?      @db.Uuid
  room           Room?        @relation(fields: [roomId], references: [id])
  reservationId  String?      @db.Uuid
  reservation    Reservation? @relation(fields: [reservationId], references: [id])
  credentialId   String?      @db.Uuid

  commandId String?      @unique @db.Uuid
  command   LockCommand? @relation(fields: [commandId], references: [id])

  operation String // 'CREATE_CREDENTIAL' | 'ENCODE_CARD' | 'VERIFY_CARD' | 'REVOKE_CREDENTIAL'
  status    String // 'QUEUED' | 'DISPATCHING' | 'WAITING_FOR_CARD' | 'CARD_DETECTED' | 'ENCODING' | 'VERIFYING' | 'ACTIVE' | 'FAILED' | 'REVOKING' | 'REVOKED'

  errorCode    String?
  errorMessage String?
  payloadHash  String?
  attemptCount Int     @default(0)

  requestedAt DateTime  @default(now()) @db.Timestamptz
  startedAt   DateTime? @db.Timestamptz
  completedAt DateTime? @db.Timestamptz

  agentId String?        @db.Uuid
  agent   HardwareAgent? @relation(fields: [agentId], references: [id])

  deviceId String?
  metadata Json?
}

model LockCommand {
  id          String         @id @default(uuid()) @db.Uuid
  operationId String         @db.Uuid
  operation   LockOperation?

  agentId String        @db.Uuid
  agent   HardwareAgent @relation(fields: [agentId], references: [id])

  commandType String
  payload     Json
  status      String // 'QUEUED' | 'CLAIMED' | 'PROCESSING' | 'COMPLETED' | 'FAILED' | 'DEAD_LETTER' | 'CANCELLED'

  attempts Int @default(0)

  availableAt    DateTime  @default(now()) @db.Timestamptz
  claimedAt      DateTime? @db.Timestamptz
  leaseExpiresAt DateTime? @db.Timestamptz
  completedAt    DateTime? @db.Timestamptz

  errorCode    String?
  errorMessage String?
  responseData Json?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

// Durable audit trail for every hardware step. Used for debugging guest key issues.
model LockEvent {
  id            String         @id @default(uuid()) @db.Uuid
  propertyId    String         @db.Uuid
  property      Property       @relation(fields: [propertyId], references: [id])
  agentId       String?        @db.Uuid
  agent         HardwareAgent? @relation(fields: [agentId], references: [id])
  roomId        String?        @db.Uuid
  reservationId String?        @db.Uuid
  credentialId  String?        @db.Uuid
  operationId   String?        @db.Uuid
  commandId     String?        @db.Uuid

  eventType String // AGENT_CONNECTED | AGENT_DISCONNECTED | COMMAND_RECEIVED | CARD_WAITING |
  // CARD_DETECTED | ENCODING_STARTED | ENCODING_COMPLETED | VERIFICATION_STARTED |
  // VERIFICATION_COMPLETED | REVOCATION_STARTED | REVOCATION_COMPLETED |
  // HARDWARE_ERROR | SDK_ERROR
  payload   Json?

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([propertyId, createdAt])
  @@index([operationId])
  @@index([reservationId])
}

model IntegrationConfig {
  id              String   @id @default(uuid()) @db.Uuid
  propertyId      String   @db.Uuid
  property        Property @relation(fields: [propertyId], references: [id])
  type            String // 'payment' | 'lock' | 'email' | 'sms' | 'ota' | 'pos' | 'gov'
  provider        String
  isActive        Boolean  @default(false)
  configEncrypted String
  webhookUrl      String?

  lastHealthCheck DateTime? @db.Timestamptz
  healthStatus    String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model GovernmentSubmission {
  id           String    @id @default(uuid()) @db.Uuid
  propertyId   String    @db.Uuid
  property     Property  @relation(fields: [propertyId], references: [id])
  provider     String
  reportType   String
  businessDate DateTime  @db.Date
  status       String // 'pending' | 'submitted' | 'accepted' | 'rejected'
  payload      Json
  response     Json?
  submittedAt  DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

// -----------------------------------------------------------------------------
// NOTIFICATIONS & AUDIT
// -----------------------------------------------------------------------------

model Notification {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String?      @db.Uuid

  recipientType  String // 'staff' | 'guest'
  recipientId    String? @db.Uuid
  recipientEmail String?
  recipientPhone String?

  channel    String // 'email' | 'sms' | 'push' | 'whatsapp' | 'in_app'
  templateId String? @db.Uuid

  subject String?
  body    String

  status   String // 'pending' | 'sent' | 'failed' | 'bounced'
  sentAt   DateTime? @db.Timestamptz
  error    String?
  metadata Json?

  priority String? // 'P0' | 'P1' | 'P2' | 'P3'
  category String? // 'CRITICAL' | 'APPROVALS' | 'OPERATIONS' | 'GUESTS' | 'FINANCE'
  groupKey String? // For grouping related notifications
  readAt   DateTime? @db.Timestamptz
  action   String? // Deep link or action ID

  createdAt DateTime @default(now()) @db.Timestamptz
}

model NotificationTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  event          String
  channels       String[]
  subject        String?
  bodyHtml       String?
  bodySms        String?
  variables      String[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String?      @db.Uuid

  userId    String? @db.Uuid
  userEmail String?
  userRole  String?

  impersonatorUserId String? @db.Uuid

  action     String
  resource   String
  resourceId String

  previousValue Json?
  newValue      Json?

  ipAddress String?
  userAgent String?
  requestId String

  createdAt DateTime @default(now()) @db.Timestamptz

  // ⚠️  DEPLOYMENT NOTE: When Prisma generates the migration SQL for these indexes,
  //     manually edit it to use `CREATE INDEX CONCURRENTLY` instead of `CREATE INDEX`
  //     to avoid table-level write locks on production. Run during off-peak hours and
  //     monitor pg_stat_activity / lock contention before and after.
  @@index([organizationId, createdAt])
  @@index([propertyId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model AgentEnrollmentToken {
  id         String         @id @default(uuid()) @db.Uuid
  propertyId String         @db.Uuid
  property   Property       @relation(fields: [propertyId], references: [id])
  agentId    String?        @db.Uuid
  agent      HardwareAgent? @relation(fields: [agentId], references: [id])
  tokenHash  String         @unique // bcrypt hash — never store plain
  expiresAt  DateTime       @db.Timestamptz
  usedAt     DateTime?      @db.Timestamptz
  createdBy  String         @db.Uuid
  createdAt  DateTime       @default(now()) @db.Timestamptz

  @@index([propertyId])
}

enum ReservationPriorityType {
  VIP
  LOYALTY
  ACCESSIBILITY
  BACK_TO_BACK
  MANAGEMENT
  SPECIAL_REQUEST
}

model ReservationPriority {
  id            String                  @id @default(uuid()) @db.Uuid
  reservationId String                  @db.Uuid
  reservation   Reservation             @relation(fields: [reservationId], references: [id])
  type          ReservationPriorityType
  level         Int                     @default(1)
  reason        String?
  createdBy     String?                 @db.Uuid
  expiresAt     DateTime?               @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([reservationId, type])
}

// -----------------------------------------------------------------------------
// INVENTORY & PROCUREMENT (Phase 1)
// -----------------------------------------------------------------------------

enum UnitOfMeasure {
  UNIT
  EACH
  KG
  GRAM
  TONNE
  LITRE
  ML
  GALLON
  PIECE
  PAIR
  SET
  DOZEN
  BOX
  BOTTLE
  CAN
  JAR
  TIN
  SACHET
  PACK
  CART
  CARTON
  CASE
  PALLET
  BAG
  BUNDLE
  ROLL
  MUDU
  DERICA
  PORTION
  SERVING
  SCOOP
  LADLE
  CUP
  GLASS
  PLATE
  BOWL
  TRAY
  CRATE
  SACK
  BASKET
  PAIL
  JERRYCAN
  DRUM
  LOAF
  SLICE
  STICK
  BUNCH
  HEAD
}

enum FnbClass {
  FOOD
  BEVERAGE
  OTHER
}

enum StockItemType {
  SELLABLE
  RAW_MATERIAL
  CONSUMABLE
  CLEANING
  HOUSEKEEPING
  ASSET
  PACKAGING
}

model UnitOfMeasureConversion {
  id         String        @id @default(uuid()) @db.Uuid
  propertyId String        @db.Uuid
  property   Property      @relation(fields: [propertyId], references: [id])
  fromUnit   UnitOfMeasure
  toUnit     UnitOfMeasure
  ratio      Decimal       @db.Decimal(18, 6)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  propertyId    String   @db.Uuid
  property      Property @relation(fields: [propertyId], references: [id])
  name          String
  contactName   String?
  email         String?
  phone         String?
  address       String?
  taxIdentifier String?
  isActive      Boolean  @default(true)

  purchaseOrders   PurchaseOrder[]
  supplierInvoices SupplierInvoice[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

model Warehouse {
  id                String      @id @default(uuid()) @db.Uuid
  propertyId        String      @db.Uuid
  property          Property    @relation(fields: [propertyId], references: [id])
  name              String
  location          String?
  isActive          Boolean     @default(true)
  posOutletId       String?     @unique @db.Uuid
  posOutlet         PosOutlet?  @relation(fields: [posOutletId], references: [id])
  parentWarehouseId String?     @db.Uuid
  parentWarehouse   Warehouse?  @relation("WarehouseHierarchy", fields: [parentWarehouseId], references: [id])
  childWarehouses   Warehouse[] @relation("WarehouseHierarchy")

  stockItems    StockItem[]
  transactions  StockTransaction[]
  transfersFrom StockTransfer[]    @relation("TransferFrom")
  transfersTo   StockTransfer[]    @relation("TransferTo")
  stocktakes    Stocktake[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

model InventoryCategory {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  name       String
  isActive   Boolean  @default(true)

  stockItems StockItem[]
  stocktakes Stocktake[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@unique([propertyId, name])
}

model StockItem {
  id          String    @id @default(uuid()) @db.Uuid
  propertyId  String    @db.Uuid
  property    Property  @relation(fields: [propertyId], references: [id])
  warehouseId String    @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  categoryId        String?            @db.Uuid
  inventoryCategory InventoryCategory? @relation(fields: [categoryId], references: [id])

  name      String
  sku       String?
  barcode   String?
  baseUnit  UnitOfMeasure
  stockType StockItemType @default(CONSUMABLE)

  costPrice      Decimal  @default(0) @db.Decimal(18, 4)
  quantityOnHand Decimal  @default(0) @db.Decimal(18, 4)
  reorderLevel   Decimal? @db.Decimal(18, 4)

  isActive Boolean @default(true)

  recipeIngredients RecipeIngredient[]
  transactions      StockTransaction[]
  alerts            InventoryAlert[]
  transferItems     StockTransferItem[]
  costAdjustments   CostAdjustment[]
  kitchenWaste      KitchenWasteEntry[]
  stocktakeItems    StocktakeItem[]
  stockUnits        StockItemUnit[]
  modifierLinks     PosProductModifier[] @relation("ModifierStockItem")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@unique([propertyId, barcode])
}

/// Item-specific packaging conversions, e.g. 1 CARTON = 12 BOTTLE.
model StockItemUnit {
  id             String        @id @default(uuid()) @db.Uuid
  stockItemId    String        @db.Uuid
  stockItem      StockItem     @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  unit           UnitOfMeasure
  unitsInBase    Decimal       @db.Decimal(18, 6)
  /// Price of one purchase unit in the property's currency, when this is the purchase unit.
  purchaseCost   Decimal?      @db.Decimal(18, 2)
  barcode        String?
  isPurchaseUnit Boolean       @default(false)
  isIssueUnit    Boolean       @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([stockItemId, unit])
}

enum AdjustmentReason {
  SPOILAGE
  THEFT
  DAMAGE
  MISCOUNT
  WASTE
  EXPIRY
  OPENING_BALANCE
  OTHER
}

enum StockTransactionSource {
  RECEIPT
  SALE
  GUEST_AMENITY
  TRANSFER
  ADJUSTMENT
  WASTE
  RETURN
  POS_VOID
  POS_REFUND
}

enum KitchenWasteStatus {
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
}

enum KitchenWasteReason {
  SPOILAGE
  OVER_PRODUCTION
  BURNED
  DAMAGED
  RETURNED
  WRONG_ORDER
  OTHER
}

model StockTransaction {
  id          String    @id @default(uuid()) @db.Uuid
  propertyId  String    @db.Uuid
  property    Property  @relation(fields: [propertyId], references: [id])
  stockItemId String    @db.Uuid
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])

  reservationId String?      @db.Uuid
  reservation   Reservation? @relation("GuestAmenityStock", fields: [reservationId], references: [id])
  roomId        String?      @db.Uuid
  room          Room?        @relation("GuestAmenityStockRoom", fields: [roomId], references: [id])

  source   StockTransactionSource
  quantity Decimal                @db.Decimal(18, 4)
  unitCost Decimal                @db.Decimal(18, 4)

  reference  String?
  notes      String?
  reason     AdjustmentReason?
  approvalId String?

  businessDate DateTime @db.Date

  operationId String? @unique
  deviceId    String?
  userId      String? @db.Uuid

  timestamp DateTime @default(now()) @db.Timestamptz

  quantityBefore Decimal @default(0) @db.Decimal(18, 4)
  quantityAfter  Decimal @default(0) @db.Decimal(18, 4)
  totalValue     Decimal @default(0) @db.Decimal(18, 4)
  currency       String  @default("NGN")

  warehouseId String?    @db.Uuid
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  grnId String?            @db.Uuid
  grn   GoodsReceivedNote? @relation(fields: [grnId], references: [id])

  transferId String?        @db.Uuid
  transfer   StockTransfer? @relation(fields: [transferId], references: [id])

  @@index([propertyId, reservationId, businessDate])
  @@index([propertyId, roomId, businessDate])
}

model KitchenWasteEntry {
  id                 String             @id @default(uuid()) @db.Uuid
  propertyId         String             @db.Uuid
  property           Property           @relation(fields: [propertyId], references: [id])
  outletId           String?            @db.Uuid
  stockItemId        String             @db.Uuid
  stockItem          StockItem          @relation(fields: [stockItemId], references: [id])
  quantity           Decimal            @db.Decimal(18, 4)
  unitOfMeasure      UnitOfMeasure
  baseQuantity       Decimal            @db.Decimal(18, 4)
  unitCost           Decimal            @db.Decimal(18, 4)
  totalValue         Decimal            @db.Decimal(18, 4)
  reason             KitchenWasteReason
  notes              String?
  orderId            String?            @db.Uuid
  productionBatchId  String?            @db.Uuid
  status             KitchenWasteStatus @default(SUBMITTED)
  createdBy          String             @db.Uuid
  approvedBy         String?            @db.Uuid
  approvedAt         DateTime?          @db.Timestamptz
  rejectedBy         String?            @db.Uuid
  rejectedAt         DateTime?          @db.Timestamptz
  rejectionReason    String?
  postedBy           String?            @db.Uuid
  postedAt           DateTime?          @db.Timestamptz
  stockTransactionId String?            @unique @db.Uuid
  createdAt          DateTime           @default(now()) @db.Timestamptz
  updatedAt          DateTime           @updatedAt @db.Timestamptz

  @@index([propertyId, status, createdAt])
  @@index([stockItemId, createdAt])
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  REJECTED
  CANCELLED
  CLOSED
}

model PurchaseOrder {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  poNumber      String              @unique
  status        PurchaseOrderStatus @default(DRAFT)
  /// ACCOUNTANT while awaiting first approval; GENERAL_MANAGER while awaiting final approval.
  approvalStage String?             @default("ACCOUNTANT")
  expectedDate  DateTime?           @db.Date
  totalAmount   Decimal             @default(0) @db.Decimal(18, 4)
  paidAmount    Decimal             @default(0) @db.Decimal(18, 4)
  paymentStatus String              @default("UNPAID") // UNPAID, PARTIAL, PAID
  notes         String?

  currency                 String    @default("NGN")
  rejectedBy               String?   @db.Uuid
  rejectedAt               DateTime? @db.Timestamptz
  rejectedReason           String?
  accountantApprovedBy     String?   @db.Uuid
  accountantApprovedAt     DateTime? @db.Timestamptz
  generalManagerApprovedBy String?   @db.Uuid
  generalManagerApprovedAt DateTime? @db.Timestamptz
  cancelledBy              String?   @db.Uuid
  cancelledAt              DateTime? @db.Timestamptz

  items            PurchaseOrderItem[]
  grns             GoodsReceivedNote[]
  supplierInvoices SupplierInvoice[]
  payments         SupplierPayment[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

model PurchaseOrderItem {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  stockItemId     String?       @db.Uuid
  description     String

  quantity         Decimal       @db.Decimal(18, 4)
  unitOfMeasure    UnitOfMeasure
  unitPrice        Decimal       @db.Decimal(18, 4)
  totalPrice       Decimal       @db.Decimal(18, 4)
  conversionToBase Decimal       @default(1) @db.Decimal(18, 6)

  receivedQty Decimal @default(0) @db.Decimal(18, 4)
}

enum GoodsReceivedNoteStatus {
  DRAFT
  SUBMITTED
  APPROVED
