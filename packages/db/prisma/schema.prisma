model PosOutlet {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  name       String
  type       String
  isActive   Boolean  @default(true)

  categories ProductCategory[]
  sessions   PosSession[]
  orders     PosOrder[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  devices     PosDevice[]
  staffAccess StaffPosOutletAccess[]
  floorPlans  PosFloorPlan[]
}

model PosFloorPlan {
  id       String    @id @default(uuid()) @db.Uuid
  outletId String    @db.Uuid
  outlet   PosOutlet @relation(fields: [outletId], references: [id])
  name     String
  isActive Boolean   @default(true)

  tables PosTable[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model PosTable {
  id          String       @id @default(uuid()) @db.Uuid
  floorPlanId String       @db.Uuid
  floorPlan   PosFloorPlan @relation(fields: [floorPlanId], references: [id])

  name      String
  capacity  Int
  positionX Int    @default(0)
  positionY Int    @default(0)

  currentOrderId String? @db.Uuid

  isActive Boolean @default(true)

  orders PosOrder[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model ProductCategory {
  id                String            @id @default(uuid()) @db.Uuid
  outletId          String            @db.Uuid
  outlet            PosOutlet         @relation(fields: [outletId], references: [id])
  name              String
  isActive          Boolean           @default(true)
  sortOrder         Int               @default(0)
  productionStation ProductionStation @default(KITCHEN)

  products PosProduct[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model PosProduct {
  id                String             @id @default(uuid()) @db.Uuid
  propertyId        String             @db.Uuid
  property          Property           @relation(fields: [propertyId], references: [id])
  categoryId        String             @db.Uuid
  category          ProductCategory    @relation(fields: [categoryId], references: [id])

  name              String
  description       String?
  price             Decimal            @db.Decimal(18, 4)
  taxRate           Decimal            @default(0) @db.Decimal(5, 2)
  isActive          Boolean            @default(true)
  image             String?
  productionStation ProductionStation?

  ingredients RecipeIngredient[]
  modifiers   PosProductModifier[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

model PosProductModifier {
  id        String     @id @default(uuid()) @db.Uuid
  productId String     @db.Uuid
  product   PosProduct @relation(fields: [productId], references: [id])

  name     String
  price    Decimal @default(0) @db.Decimal(18, 4)
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz
}

model RecipeIngredient {
  id          String     @id @default(uuid()) @db.Uuid
  productId   String     @db.Uuid
  product     PosProduct @relation(fields: [productId], references: [id])
  stockItemId String     @db.Uuid
  stockItem   StockItem  @relation(fields: [stockItemId], references: [id])

  quantity      Decimal       @db.Decimal(18, 4)
  unitOfMeasure UnitOfMeasure

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

enum PosSessionStatus {
  OPEN
  CLOSED
  RECONCILED
  RECONCILIATION_REQUIRED
}

model PosSession {
  id       String    @id @default(uuid()) @db.Uuid
  outletId String    @db.Uuid
  outlet   PosOutlet @relation(fields: [outletId], references: [id])

  status       PosSessionStatus @default(OPEN)
  businessDate DateTime         @db.Date

  openingCash  Decimal  @default(0) @db.Decimal(18, 4)
  cashSales    Decimal  @default(0) @db.Decimal(18, 4)
  cashRefunds  Decimal  @default(0) @db.Decimal(18, 4)
  cashIn       Decimal  @default(0) @db.Decimal(18, 4)
  cashOut      Decimal  @default(0) @db.Decimal(18, 4)
  expectedCash Decimal  @default(0) @db.Decimal(18, 4)
  actualCash   Decimal? @db.Decimal(18, 4)
  variance     Decimal? @db.Decimal(18, 4)

  openedBy   String    @db.Uuid
  closedBy   String?   @db.Uuid
  approvedBy String?   @db.Uuid
  openedAt   DateTime  @default(now()) @db.Timestamptz
  closedAt   DateTime? @db.Timestamptz
  approvedAt DateTime? @db.Timestamptz

  deviceId String    @db.Uuid
  device   PosDevice @relation(fields: [deviceId], references: [id])

  propertyId String?   @db.Uuid
  property   Property? @relation(fields: [propertyId], references: [id])

    orders PosOrder[]

  cashMovements       PosCashMovement[]
  receiptAudits       PosReceiptAudit[]
  authorizationAudits PosAuthorizationAudit[]
  settlements         PosSettlement[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

enum PosCashMovementType {
  PAID_OUT
  CASH_DROP
  CASH_TRANSFER_IN
  CASH_TRANSFER_OUT
  FLOAT_ADJUSTMENT
  SETTLED_ACTUAL
  VARIANCE
}

model PosCashMovement {
  id               String              @id @default(uuid()) @db.Uuid
  propertyId       String              @db.Uuid
  deviceId         String
  posSessionId     String              @db.Uuid
  userId           String              @db.Uuid
  amount           Decimal             @db.Decimal(18, 4)
  type             PosCashMovementType
  reasonCode       String
  notes            String?
  receiptReference String?
  operationId      String              @unique
  businessDate     DateTime?           @db.Date
  authorizedBy     String?             @db.Uuid

  session PosSession @relation(fields: [posSessionId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
}

model PosSettlement {
  id             String    @id @default(uuid()) @db.Uuid
  sessionId      String    @db.Uuid
  propertyId     String    @db.Uuid
  outletId       String    @db.Uuid
  deviceId       String
  sessionOwnerId String    @db.Uuid
  operatorId     String    @db.Uuid
  businessDate   DateTime? @db.Date
  expectedCash   Decimal   @db.Decimal(18, 4)
  actualCash     Decimal   @db.Decimal(18, 4)
  variance       Decimal   @db.Decimal(18, 4)
  authorizerId   String?   @db.Uuid
  settledAt      DateTime  @db.Timestamptz
  status         String    @default("SETTLED")
  operationId    String    @unique

  session PosSession @relation(fields: [sessionId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
}

enum PosReceiptType {
  SALE_RECEIPT
  REFUND_RECEIPT
  VOID_RECEIPT
  REPRINT
  DUPLICATE_COPY
}

model PosReceiptAudit {
  id           String         @id @default(uuid()) @db.Uuid
  propertyId   String         @db.Uuid
  orderId      String?        @db.Uuid
  deviceId     String
  posSessionId String?        @db.Uuid
  userId       String         @db.Uuid
  type         PosReceiptType
  reason       String?
  printCount   Int            @default(1)
  operationId  String         @unique
  businessDate DateTime       @db.Date

  session PosSession? @relation(fields: [posSessionId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
}

model PosAuthorizationAudit {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @db.Uuid
  deviceId     String
  sessionId    String?  @db.Uuid
  requestedBy  String   @db.Uuid
  authorizedBy String   @db.Uuid
  action       String
  reason       String?
  operationId  String   @unique
  businessDate DateTime @db.Date

  session PosSession? @relation(fields: [sessionId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
}

enum PosOrderStatus {
  SUBMITTED
  IN_SERVICE
  CLOSED
  VOIDED
}

enum ProductionStation {
  KITCHEN
  BAR
  DIRECT
  NONE
}

enum PosProductionBatchStatus {
  PENDING
  ACKNOWLEDGED
  PREPARING
  READY
  COMPLETED
}

enum PosOrderPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model PosOrder {
  id         String     @id @default(uuid()) @db.Uuid
  propertyId String     @db.Uuid
  property   Property   @relation(fields: [propertyId], references: [id])
  outletId   String     @db.Uuid
  outlet     PosOutlet  @relation(fields: [outletId], references: [id])
  sessionId  String     @db.Uuid
  session    PosSession @relation(fields: [sessionId], references: [id])
  folioId    String?    @db.Uuid
  folio      Folio?     @relation(fields: [folioId], references: [id])

  serverStaffId String? @db.Uuid
  serverStaff   Staff?  @relation(fields: [serverStaffId], references: [id])

  orderNumber   String               @unique
  status        PosOrderStatus       @default(SUBMITTED)
  paymentStatus PosOrderPaymentStatus @default(UNPAID)
  businessDate  DateTime             @db.Date

  subtotal  Decimal @default(0) @db.Decimal(18, 4)
  taxAmount Decimal @default(0) @db.Decimal(18, 4)
  discount  Decimal @default(0) @db.Decimal(18, 4)
  total     Decimal @default(0) @db.Decimal(18, 4)

  notes       String?
  tableNumber String?
  tableId     String?   @db.Uuid
  table       PosTable? @relation(fields: [tableId], references: [id])

  guestCount    Int     @default(1)
  serviceCharge Decimal @default(0) @db.Decimal(18, 4)
  tipAmount     Decimal @default(0) @db.Decimal(18, 4)

  operationId String?   @unique
  deviceId    String?
  closedAt    DateTime? @db.Timestamptz

  items             PosOrderItem[]
  payments          PosPayment[]
  voids             PosVoid[]
  discounts         PosDiscount[]
  checks            PosCheck[]
  kots              PosKot[]
  productionBatches PosProductionBatch[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

model PosOrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  order       PosOrder @relation(fields: [orderId], references: [id])
  productId   String?  @db.Uuid
  productName String

  quantity  Decimal @db.Decimal(18, 4)
  unitPrice Decimal @db.Decimal(18, 4)

  subtotal  Decimal @db.Decimal(18, 4)
  discount  Decimal @default(0) @db.Decimal(18, 4)
  taxRate   Decimal @default(0) @db.Decimal(5, 2)
  taxAmount Decimal @default(0) @db.Decimal(18, 4)
  total     Decimal @db.Decimal(18, 4)

  notes           String?
  course          Int?
  kitchenStatus   String?
  sentToKitchenAt DateTime? @db.Timestamptz
  voidReason      String?

  checkId String?   @db.Uuid
  check   PosCheck? @relation(fields: [checkId], references: [id])
  kotId   String?   @db.Uuid
  kot     PosKot?   @relation(fields: [kotId], references: [id])

  modifiers            PosOrderItemModifier[]
  productionBatchItems PosProductionBatchItem[]

  createdAt DateTime @default(now()) @db.Timestamptz
}

model PosOrderItemModifier {
  id          String       @id @default(uuid()) @db.Uuid
  orderItemId String       @db.Uuid
  orderItem   PosOrderItem @relation(fields: [orderItemId], references: [id])

  name  String
  price Decimal @default(0) @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @db.Timestamptz
}

model PosCheck {
  id      String   @id @default(uuid()) @db.Uuid
  orderId String   @db.Uuid
  order   PosOrder @relation(fields: [orderId], references: [id])

  checkNumber  String
  total        Decimal  @default(0) @db.Decimal(18, 4)
  status       String   @default("OPEN")
  operationId  String?  @unique
  businessDate DateTime @db.Date

  items PosOrderItem[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model PosKot {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  order     PosOrder @relation(fields: [orderId], references: [id])
  outletId  String   @db.Uuid
  deviceId  String
  createdBy String   @db.Uuid

  kotNumber    String
  status       String   @default("PENDING")
  printStatus  String   @default("QUEUED")
  operationId  String?  @unique
  businessDate DateTime @db.Date
  printerId    String?
  attemptCount Int      @default(0)

  printedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  items PosOrderItem[]
}

enum PosPaymentStatus {
  PENDING
  AUTHORIZED
  CONFIRMED
  PAID
  FAILED
  REFUNDED
  VOIDED
  REQUIRES_REVIEW
  PENDING_GATEWAY
  REFUND_PENDING
  REFUND_COMPLETED
}

model PosPayment {
  id      String   @id @default(uuid()) @db.Uuid
  orderId String   @db.Uuid
  order   PosOrder @relation(fields: [orderId], references: [id])

  method   PaymentMethod
  status   PosPaymentStatus @default(PENDING)
  amount   Decimal          @db.Decimal(18, 4)
  currency String           @default("NGN")

  reference            String?
  gateway              String?
  gatewayTransactionId String?

  operationId  String?  @unique
  businessDate DateTime @db.Date
  deviceId     String?

  paidAt DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model PosVoid {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  order       PosOrder @relation(fields: [orderId], references: [id])
  orderItemId String?  @db.Uuid

  reason       String
  authorizerId String? @db.Uuid

  operationId  String?  @unique
  businessDate DateTime @db.Date
  deviceId     String?

  createdAt DateTime @default(now()) @db.Timestamptz
}

model PosDiscount {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  order       PosOrder @relation(fields: [orderId], references: [id])
  orderItemId String?  @db.Uuid

  type         String // 'PERCENTAGE' | 'FLAT'
  amount       Decimal @db.Decimal(18, 4)
  authorizerId String? @db.Uuid

  operationId  String?  @unique
  businessDate DateTime @db.Date
  deviceId     String?

  createdAt DateTime @default(now()) @db.Timestamptz
}

// -----------------------------------------------------------------------------
// POS PRODUCTION BATCHES (Service-first waiter flow)
// -----------------------------------------------------------------------------

model PosProductionBatch {
  id             String                   @id @default(uuid()) @db.Uuid
  orderId        String                   @db.Uuid
  order          PosOrder                 @relation(fields: [orderId], references: [id])
  batchNumber    Int
  station        ProductionStation
  status         PosProductionBatchStatus @default(PENDING)
  firedAt        DateTime                 @default(now()) @db.Timestamptz
  firedByStaffId String?                  @db.Uuid
  firedByStaff   Staff?                   @relation(fields: [firedByStaffId], references: [id])
  items          PosProductionBatchItem[]
  createdAt      DateTime                 @default(now()) @db.Timestamptz
}

model PosProductionBatchItem {
  id          String             @id @default(uuid()) @db.Uuid
  batchId     String             @db.Uuid
  batch       PosProductionBatch @relation(fields: [batchId], references: [id])
  orderItemId String             @db.Uuid
  orderItem   PosOrderItem       @relation(fields: [orderItemId], references: [id])
  productName String
  quantity    Decimal            @db.Decimal(18, 4)
  modifiers   Json?
  course      Int?
  createdAt   DateTime           @default(now()) @db.Timestamptz
}
