model NightAudit {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @db.Uuid
  property     Property @relation(fields: [propertyId], references: [id])
  businessDate DateTime @db.Date

  status       String // 'PENDING' | 'IN_PROGRESS' (cutover) | 'POSTING' | 'COMPLETED' | 'FAILED'
  startedAt    DateTime? @db.Timestamptz
  cutoffAt     DateTime? @db.Timestamptz
  completedAt  DateTime? @db.Timestamptz
  runBy        String?   @db.Uuid // Staff ID, null if automated
  runReference String?   @unique

  roomChargesPosted Int     @default(0)
  totalRoomRevenue  Decimal @default(0) @db.Decimal(18, 4)
  totalRevenue      Decimal @default(0) @db.Decimal(18, 4)
  occupancy         Decimal @default(0) @db.Decimal(5, 2) // Percentage
  adr               Decimal @default(0) @db.Decimal(18, 4)
  revpar            Decimal @default(0) @db.Decimal(18, 4)

  tasksCreated Int @default(0)
  tasksSkipped Int @default(0)
  errors       Int @default(0)

  exceptions Json?
  notes      String?

  posUnresolvedVariances Int @default(0)
  posSessionsPending     Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  folioItems        FolioItem[]
  acknowledgements  NightAuditAcknowledgement[]
  financialSnapshot NightAuditFinancialSnapshot?
  closePackage      NightAuditClosePackage?
  movementSnapshots NightAuditMovementSnapshot[]
  journalEntries    JournalEntry[]

  @@unique([propertyId, businessDate])
}

// Immutable evidence bundle for a completed business-date close.
model NightAuditClosePackage {
  id              String    @id @default(uuid()) @db.Uuid
  nightAuditId    String    @unique @db.Uuid
  propertyId      String    @db.Uuid
  businessDate    DateTime  @db.Date
  status          String
  sourceTotals    Json
  balanceProof    Json
  controlSummary  Json
  reportManifest  Json
  journalEntryIds Json
  packageHash     String?   @unique
  createdBy       String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz
  finalizedAt     DateTime? @db.Timestamptz

  nightAudit      NightAudit                  @relation(fields: [nightAuditId], references: [id])
  property        Property                    @relation(fields: [propertyId], references: [id])
  accountBalances NightAuditBalanceSnapshot[]

  @@index([propertyId, businessDate])
  @@index([propertyId, status])
}

model NightAuditBalanceSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  closePackageId  String   @db.Uuid
  propertyId      String   @db.Uuid
  businessDate    DateTime @db.Date
  ledgerType      String
  accountKey      String
  openingBalance  Decimal  @db.Decimal(18, 4)
  activityDebit   Decimal  @default(0) @db.Decimal(18, 4)
  activityCredit  Decimal  @default(0) @db.Decimal(18, 4)
  expectedClosing Decimal  @db.Decimal(18, 4)
  actualClosing   Decimal? @db.Decimal(18, 4)
  variance        Decimal? @db.Decimal(18, 4)
  status          String
  resolution      String?
  createdAt       DateTime @default(now()) @db.Timestamptz

  closePackage NightAuditClosePackage @relation(fields: [closePackageId], references: [id], onDelete: Cascade)
  property     Property               @relation(fields: [propertyId], references: [id])

  @@unique([closePackageId, ledgerType, accountKey])
  @@index([propertyId, businessDate, ledgerType])
}

model NightAuditFinancialSnapshot {
  id           String     @id @default(uuid()) @db.Uuid
  nightAuditId String     @unique @db.Uuid
  nightAudit   NightAudit @relation(fields: [nightAuditId], references: [id])

  roomRevenue         Decimal @default(0) @db.Decimal(18, 4)
  guestAmenityCost    Decimal @default(0) @db.Decimal(18, 4)
  netRoomContribution Decimal @default(0) @db.Decimal(18, 4)
  fnbRevenue          Decimal @default(0) @db.Decimal(18, 4)
  otherRevenue        Decimal @default(0) @db.Decimal(18, 4)
  taxes               Decimal @default(0) @db.Decimal(18, 4)
  discounts           Decimal @default(0) @db.Decimal(18, 4)
  refunds             Decimal @default(0) @db.Decimal(18, 4)
  grossRevenue        Decimal @default(0) @db.Decimal(18, 4)
  netRevenue          Decimal @default(0) @db.Decimal(18, 4)

  paymentTotals            Json?
  cashExpected             Decimal?  @db.Decimal(18, 4)
  cashDeclared             Decimal?  @db.Decimal(18, 4)
  cashVariance             Decimal?  @db.Decimal(18, 4)
  unresolvedExceptionCount Int       @default(0)
  latePostingCount         Int       @default(0)
  voidCount                Int       @default(0)
  adjustmentCount          Int       @default(0)
  journalEntryIds          Json?
  reconciliationStatus     String?
  snapshotHash             String?   @unique
  finalizedAt              DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
}

// Immutable arrivals/departures captured at night-audit completion. Historical
// reports must not recalculate movement status from live reservations.
model NightAuditMovementSnapshot {
  id                 String   @id @default(uuid()) @db.Uuid
  nightAuditId       String   @db.Uuid
  propertyId         String   @db.Uuid
  businessDate       DateTime @db.Date
  reservationId      String   @db.Uuid
  movementType       String
  confirmationNumber String
  guestName          String
  roomNumber         String?
  roomType           String?
  source             String?
  status             String
  adults             Int
  children           Int
  folioBalance       Decimal  @default(0) @db.Decimal(18, 4)
  capturedAt         DateTime @db.Timestamptz

  nightAudit  NightAudit  @relation(fields: [nightAuditId], references: [id], onDelete: Restrict)
