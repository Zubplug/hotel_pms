model GuestDocument {
  id         String    @id @default(uuid()) @db.Uuid
  guestId    String    @db.Uuid
  guest      Guest     @relation(fields: [guestId], references: [id])
  type       String
  fileUrl    String
  uploadedAt DateTime  @default(now()) @db.Timestamptz
  expiresAt  DateTime? @db.Timestamptz
}

enum ReservationSource {
  WALK_IN
  PHONE
  EMAIL
  WEBSITE
  OTA
  CORPORATE
  OTHER
}

enum ReservationStatus {
  INQUIRY
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  EXPIRED
}

// Actor type for who/what created a reservation.
// STAFF   = created by an authenticated staff user in Front Desk
// GUEST   = created via the public Booking Engine (no staff session)
// SYSTEM  = created by an automated/system process (e.g. night audit, scheduled task)
// OTA     = created via OTA channel manager integration
enum ReservationCreatedByType {
  STAFF
  GUEST
  SYSTEM
  OTA
}

model CorporateAccount {
  id                    String  @id @default(uuid()) @db.Uuid
  organizationId        String  @db.Uuid
  propertyId            String  @db.Uuid
  name                  String
  code                  String
  contactPerson         String?
  contactEmail          String?
  contactPhone          String?
  companyAddress        String?
  companyCity           String?
  companyCountry        String?
  creditLimit           Decimal @default(0) @db.Decimal(18, 4)
  exemptFromHighBalance Boolean @default(false)
  depositPolicy         String  @default("WAIVED") // 'WAIVED', 'STANDARD'
  isActive              Boolean @default(true)
  ratePlanId            String? @db.Uuid
  cityLedgerAccountId   String? @db.Uuid

  property          Property           @relation(fields: [propertyId], references: [id])
  organization      Organization       @relation(fields: [organizationId], references: [id])
  ratePlan          RatePlan?          @relation(fields: [ratePlanId], references: [id])
  cityLedgerAccount CityLedgerAccount? @relation(fields: [cityLedgerAccountId], references: [id])

  reservations                 Reservation[]
  folios                       Folio[]
  events                       Event[]
  leaseContracts               LeaseContract[]
  corporateContracts           CorporateContract[]
  rateNegotiationRequests      CorporateRateNegotiationRequest[]
  apiPartnerMappings           ApiPartnerCorporateAccount[]
  corporatePaymentGroups       CorporatePaymentGroup[]
  corporateBookingApplications CorporateBookingApplication[]
  portalIdentity               CorporatePortalIdentity?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([propertyId, code])
}

/// Commercial agreement for a PMS CorporateAccount. This is intentionally
/// separate from the legacy CorporateAccount.ratePlanId compatibility link.
model CorporateContract {
  id                            String    @id @default(uuid()) @db.Uuid
  organizationId                String    @db.Uuid
  corporateAccountId            String?   @db.Uuid
  corporateBookingApplicationId String?   @db.Uuid
  isPropertyDefault             Boolean   @default(false)
  defaultPropertyId             String?   @db.Uuid
  reference                     String
  name                          String
  status                        String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | ACTIVE | SUSPENDED | EXPIRED
  defaultCurrency               String
  depositMinimumPercent         Decimal?  @db.Decimal(5, 2)
  negotiationEnabled            Boolean   @default(false)
  negotiationMinRooms           Int?
  negotiationMinNights          Int?
  fallbackPolicy                String    @default("NONE") // NONE | EXPLICIT_RULE_ONLY
  effectiveFrom                 DateTime  @db.Date
  effectiveTo                   DateTime? @db.Date

  organization                Organization                      @relation(fields: [organizationId], references: [id])
  corporateAccount            CorporateAccount?                 @relation(fields: [corporateAccountId], references: [id])
  corporateBookingApplication CorporateBookingApplication?      @relation(fields: [corporateBookingApplicationId], references: [id])
  defaultProperty             Property?                        @relation("CorporateContractDefaultProperty", fields: [defaultPropertyId], references: [id])
  properties                  CorporateContractProperty[]
  versions                    CorporateContractVersion[]
  negotiationRequests         CorporateRateNegotiationRequest[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([organizationId, reference])
  @@index([corporateAccountId, status, effectiveFrom, effectiveTo])
  @@index([corporateBookingApplicationId, status, effectiveFrom, effectiveTo])
}

/// Property scope for a corporate contract. Eligibility must match this row;
/// organization membership alone is never sufficient.
model CorporateContractProperty {
  id            String    @id @default(uuid()) @db.Uuid
  contractId    String    @db.Uuid
  propertyId    String    @db.Uuid
  status        String    @default("ACTIVE")
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  contract CorporateContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  property Property          @relation(fields: [propertyId], references: [id])

  @@unique([contractId, propertyId])
  @@index([propertyId, status, effectiveFrom, effectiveTo])
}

/// Immutable commercial version. Approved versions are never edited in place.
model CorporateContractVersion {
  id            String    @id @default(uuid()) @db.Uuid
  contractId    String    @db.Uuid
  version       Int
  status        String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | ACTIVE | REJECTED | EXPIRED
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  termsSnapshot Json?
  submittedBy   String?   @db.Uuid
  submittedAt   DateTime? @db.Timestamptz
  approvedBy    String?   @db.Uuid
  approvedAt    DateTime? @db.Timestamptz

  contract CorporateContract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  rules    CorporateRateRule[]

  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([contractId, version])
  @@index([contractId, status, effectiveFrom, effectiveTo])
}

/// A deterministic negotiated-rate rule belonging to an immutable contract
/// version. Cross-row overlap/conflict checks remain transactional service
/// validation because ordinary unique constraints cannot express them.
model CorporateRateRule {
  id                   String     @id @default(uuid()) @db.Uuid
  contractVersionId    String     @db.Uuid
  propertyId           String     @db.Uuid
  roomTypeId           String     @db.Uuid
  sourceRatePlanId     String?    @db.Uuid
  rateMethod           String // FIXED_NIGHTLY | PERCENTAGE_DISCOUNT | DERIVED_RATE
  amount               Decimal?   @db.Decimal(18, 4)
  discountPercent      Decimal?   @db.Decimal(9, 4)
  currency             String
  priority             Int        @default(100)
  minAdults            Int        @default(1)
  maxAdults            Int?
  minChildren          Int        @default(0)
  maxChildren          Int?
  minOccupancy         Int        @default(1)
  maxOccupancy         Int?
  minStay              Int        @default(1)
  maxStay              Int?
  minLeadTimeHours     Int        @default(0)
  maxAdvanceDays       Int?
  minRooms             Int        @default(1)
  maxRooms             Int?
  weekdays             Int[]
  blackoutDates        DateTime[] @db.Date
  fallbackAllowed      Boolean    @default(false)
  /// Optional, validated factor tiers for stay length, room count, and payment mode.
  /// Example: {"stayLength":[{"minNights":7,"adjustmentType":"PERCENT_DISCOUNT","value":10}]}
  pricingFactors       Json?
  inclusions           Json?
  taxTreatment         Json?
  cancellationPolicyId String?    @db.Uuid
  depositPolicyId      String?    @db.Uuid
  noShowPolicyId       String?    @db.Uuid

  contractVersion    CorporateContractVersion @relation(fields: [contractVersionId], references: [id], onDelete: Cascade)
  property           Property                 @relation(fields: [propertyId], references: [id])
  roomType           RoomType                 @relation(fields: [roomTypeId], references: [id])
  sourceRatePlan     RatePlan?                @relation(fields: [sourceRatePlanId], references: [id])
  cancellationPolicy CancellationPolicy?      @relation(fields: [cancellationPolicyId], references: [id])
  depositPolicy      DepositPolicy?           @relation(fields: [depositPolicyId], references: [id])
  noShowPolicy       NoShowPolicy?            @relation(fields: [noShowPolicyId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([propertyId, roomTypeId, priority])
  @@index([contractVersionId, priority])
}

/// A commercial request for a new or revised negotiated corporate rate.
/// This is a request workflow only; it never activates pricing by itself.
model CorporateRateNegotiationRequest {
  id                            String    @id @default(uuid()) @db.Uuid
  organizationId                String    @db.Uuid
  propertyId                    String    @db.Uuid
  corporateAccountId            String?   @db.Uuid
  corporateBookingApplicationId String?   @db.Uuid
  status                        String    @default("DRAFT") // DRAFT | SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED | WITHDRAWN
  requestedByType               String    @default("CORPORATE") // CORPORATE | STAFF
  requestedById                 String?
  reference                     String?
  requestedTerms                Json
  proposedRates                 Json
  reviewerNotes                 String?
  reviewedBy                    String?   @db.Uuid
  reviewedAt                    DateTime? @db.Timestamptz
  resultingContractId           String?   @db.Uuid
  quoteId                       String?   @db.Uuid
  approvedQuoteId               String?   @db.Uuid
  createdAt                     DateTime  @default(now()) @db.Timestamptz
  updatedAt                     DateTime  @updatedAt @db.Timestamptz

  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property                    Property                     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  corporateAccount            CorporateAccount?            @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)
  corporateBookingApplication CorporateBookingApplication? @relation(fields: [corporateBookingApplicationId], references: [id], onDelete: Cascade)
  resultingContract           CorporateContract?           @relation(fields: [resultingContractId], references: [id], onDelete: SetNull)
  quote                       BookingQuote?                @relation("CorporateRateNegotiationQuote", fields: [quoteId], references: [id], onDelete: SetNull)
  approvedQuote               BookingQuote?                @relation("CorporateRateNegotiationApprovedQuote", fields: [approvedQuoteId], references: [id], onDelete: SetNull)

  @@index([propertyId, corporateAccountId, status])
  @@index([propertyId, corporateBookingApplicationId, status])
  @@index([organizationId, status, createdAt])
  @@index([quoteId])
  @@index([approvedQuoteId])
}

model Reservation {
  id                 String   @id @default(uuid()) @db.Uuid
  propertyId         String   @db.Uuid
  property           Property @relation(fields: [propertyId], references: [id])
  confirmationNumber String   @unique

  primaryGuestId                String                       @db.Uuid
  primaryGuest                  Guest                        @relation(fields: [primaryGuestId], references: [id])
  companyId                     String?                      @db.Uuid // Legacy field
  corporateAccountId            String?                      @db.Uuid
  corporateAccount              CorporateAccount?            @relation(fields: [corporateAccountId], references: [id])
  corporateBookingApplicationId String?                      @db.Uuid
  corporateBookingApplication   CorporateBookingApplication? @relation(fields: [corporateBookingApplicationId], references: [id])

  source           ReservationSource
  channelRef       String?
  status           ReservationStatus
  /// Deadline for corporate prepaid/deposit reservations awaiting verified payment.
  paymentExpiresAt DateTime?         @db.Timestamptz

  checkIn  DateTime @db.Date
  checkOut DateTime @db.Date
  adults   Int
  children Int

  ratePlanId       String   @db.Uuid
  ratePlan         RatePlan @relation(fields: [ratePlanId], references: [id])
  ratePlanSnapshot Json

  cancellationPolicyId String?             @db.Uuid
  cancellationPolicy   CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])
  depositPolicyId      String?             @db.Uuid
  depositPolicy        DepositPolicy?      @relation(fields: [depositPolicyId], references: [id])
  noShowPolicyId       String?             @db.Uuid
  noShowPolicy         NoShowPolicy?       @relation(fields: [noShowPolicyId], references: [id])

  depositRequired Decimal? @db.Decimal(18, 4)
  depositPaid     Decimal? @db.Decimal(18, 4)
  currency        String

  specialRequests String?
  internalNotes   String?

  earlyCheckIn       Boolean  @default(false)
  lateCheckOut       Boolean  @default(false)
  earlyCheckInCharge Decimal? @db.Decimal(18, 4)
  lateCheckOutCharge Decimal? @db.Decimal(18, 4)

  cancelledAt        DateTime? @db.Timestamptz
  cancelledBy        String?   @db.Uuid // Staff ID
  cancellationReason String?

  noShowAt               DateTime? @db.Timestamptz
  noShowBy               String?   @db.Uuid // Staff ID
  lateArrivalExpected    Boolean   @default(false)
  lateArrivalNotes       String?
  lateArrivalAt          DateTime? @db.Timestamptz
  lateArrivalBy          String?   @db.Uuid
  noShowAssessedAt       DateTime? @db.Timestamptz
  noShowChargeAmount     Decimal?  @db.Decimal(18, 4)
  noShowRefundableAmount Decimal?  @db.Decimal(18, 4)
  reinstatedAt           DateTime? @db.Timestamptz
  reinstatedBy           String?   @db.Uuid
  reinstatementReason    String?

  version       Int                      @default(1) // Optimistic locking
  // Actor who created this reservation. Null when createdByType = GUEST (public booking)
  // or SYSTEM (automated). For STAFF/OTA this is the User.id of the actor.
  createdBy     String?                  @db.Uuid
  createdByType ReservationCreatedByType @default(STAFF)

  // Booking Engine fields — populated only for source = WEBSITE reservations
  bookingChannelRef          String? // Reference to BookingHold.id at creation time
  // SHA-256(token) stored here; the raw token is issued to the guest only
  guestConfirmationTokenHash String? @unique
  guestCancellationTokenHash String? @unique

  reservationGuests                 ReservationGuest[]
  reservationRooms                  ReservationRoom[]
  folios                            Folio[]
  payments                          Payment[]
  corporatePaymentGroupReservations CorporatePaymentGroupReservation[]
  folioCredits                      FolioCredit[]
  refundRequests                    RefundRequest[]
  guestServiceReqs                  GuestServiceRequest[]
  lockCredentials                   LockCredential[]
  lockOperations                    LockOperation[]
  priorities                        ReservationPriority[]
  referralBookings                  ReferralBooking[]
  CheckInBypass                     CheckInBypass[]

  createdAt                     DateTime                     @default(now()) @db.Timestamptz
  updatedAt                     DateTime                     @updatedAt @db.Timestamptz
  deletedAt                     DateTime?                    @db.Timestamptz
  laundryOrders                 LaundryOrder[]
  CityLedgerEntry               CityLedgerEntry[]
  folioItems                    FolioItem[]
  breakfastRedemptions          BreakfastRedemption[]
  poolEntries                   PoolEntry[]
  guestAmenityStockTransactions StockTransaction[]           @relation("GuestAmenityStock")
  nightAuditMovementSnapshots   NightAuditMovementSnapshot[]
}

model ReservationGuest {
  id            String      @id @default(uuid()) @db.Uuid
  reservationId String      @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  guestId       String      @db.Uuid
  guest         Guest       @relation(fields: [guestId], references: [id])
  isPrimary     Boolean     @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz
}

model ReservationRoom {
  id            String      @id @default(uuid()) @db.Uuid
  reservationId String      @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  roomTypeId    String      @db.Uuid
  roomId        String?     @db.Uuid
  room          Room?       @relation(fields: [roomId], references: [id])

  checkIn  DateTime @db.Date
  checkOut DateTime @db.Date
  adults   Int
  children Int

  ratePlanId String  @db.Uuid
  rateAmount Decimal @db.Decimal(18, 4)
  currency   String

  discountType       String? // 'PERCENTAGE', 'FIXED_AMOUNT'
  discountAmount     Decimal? @db.Decimal(18, 4)
  discountPercent    Decimal? @db.Decimal(5, 2)
  discountReason     String?
  discountApprovalId String?

  status String // 'ACTIVE', 'CANCELLED', 'NO_SHOW'

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Note: Exclusion constraint will be added via migration:
  // EXCLUDE USING GIST (roomId WITH =, daterange(checkIn, checkOut, '[)') WITH &&)
  // WHERE (status NOT IN ('CANCELLED', 'NO_SHOW'))
}

// -----------------------------------------------------------------------------
// FINANCIAL
// -----------------------------------------------------------------------------

enum TransactionVerificationStatus {
  UNVERIFIED
  VERIFIED
  QUESTIONED
  RESOLUTION_REQUESTED
  RESOLVED
  REJECTED
}

enum TransactionExceptionReason {
  BANK_DELAY
  BANK_TRANSFER_PENDING
  BANK_TRANSFER_CONFIRMED
  STAFF_DEDUCTION
  STAFF_REIMBURSEMENT
  CASHIER_ACCOUNTABILITY
  DUPLICATE_TRANSACTION
  WRONG_AMOUNT
  WRONG_ACCOUNT
  WRONG_PAYMENT_METHOD
  TRANSACTION_CORRECTION
  OTHER
}

enum TransactionExceptionStatus {
  OPEN
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model TransactionException {
  id String @id @default(uuid()) @db.Uuid

  paymentId String?  @db.Uuid
  payment   Payment? @relation(fields: [paymentId], references: [id])

  posPaymentId String?     @db.Uuid
  posPayment   PosPayment? @relation(fields: [posPaymentId], references: [id])

  status TransactionExceptionStatus @default(OPEN)

  questionReason String
  questionedById String   @db.Uuid
  questionedAt   DateTime @default(now()) @db.Timestamptz(3)

  proposedResolution TransactionExceptionReason?
  resolutionNotes    String?
  requestedById      String?                     @db.Uuid
  requestedAt        DateTime?                   @db.Timestamptz(3)

  rejectionReason String?
  rejectedById    String?   @db.Uuid
  rejectedAt      DateTime? @db.Timestamptz(3)

  approvedById String?   @db.Uuid
  approvedAt   DateTime? @db.Timestamptz(3)

  propertyId   String   @db.Uuid
  businessDate DateTime @db.Timestamptz(3)

  @@index([propertyId])
  @@index([status])
  @@index([businessDate])
}

model Folio {
  id                 String            @id @default(uuid()) @db.Uuid
  reservationId      String?           @db.Uuid // null for master/city ledgers
  reservation        Reservation?      @relation(fields: [reservationId], references: [id])
  corporateAccountId String?           @db.Uuid
  corporateAccount   CorporateAccount? @relation(fields: [corporateAccountId], references: [id])
  propertyId         String            @db.Uuid
  property           Property          @relation(fields: [propertyId], references: [id])
  guestId            String?           @db.Uuid
  guest              Guest?            @relation(fields: [guestId], references: [id])

  folioNumber String @unique
  type        String // 'ROOM' | 'MASTER' | 'CITY_LEDGER'
  status      String // 'OPEN' | 'CLOSED' | 'VOID'
  currency    String

  totalCharges  Decimal @default(0) @db.Decimal(18, 4)
  totalPayments Decimal @default(0) @db.Decimal(18, 4)
  balance       Decimal @default(0) @db.Decimal(18, 4)

  closedAt DateTime? @db.Timestamptz
  closedBy String?   @db.Uuid

  version Int @default(1)

  items                 FolioItem[]
  payments              Payment[]
  credits               FolioCredit[]
  creditApplications    FolioCreditApplication[]
  refunds               Refund[]
  refundRequests        RefundRequest[]
  posOrders             PosOrder[]
  cityLedgerAllocations CityLedgerAllocation[]   @relation("FolioCityLedgerAllocations")

  createdAt       DateTime          @default(now()) @db.Timestamptz
  updatedAt       DateTime          @updatedAt @db.Timestamptz
  CityLedgerEntry CityLedgerEntry[]
  eventInvoices   EventInvoice[]
  poolEntries     PoolEntry[]

  @@index([propertyId, corporateAccountId, type])
}

model FolioCredit {
