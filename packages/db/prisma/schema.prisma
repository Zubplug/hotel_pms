model EmployeeDocument {
  id      String @id @default(uuid()) @db.Uuid
  staffId String @db.Uuid
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  category       String // CONTRACT | ID_PROOF | DEGREE | CERTIFICATION | MEDICAL | APPRAISAL | EXIT
  title          String
  fileUrl        String
  expiresAt      DateTime? @db.Date
  isConfidential Boolean   @default(false)

  uploadedBy String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([staffId, category])
}

model CompanyPolicy {
  id                      String       @id @default(uuid()) @db.Uuid
  organizationId          String       @db.Uuid
  organization            Organization @relation(fields: [organizationId], references: [id])
  title                   String
  version                 String       @default("1.0")
  category                String // CODE_OF_CONDUCT | SAFETY | LEAVE_POLICY | IT_USAGE | HOSPITALITY_STANDARDS
  fileUrl                 String
  effectiveDate           DateTime     @db.Date
  requiresAcknowledgement Boolean      @default(true)
  isActive                Boolean      @default(true)

  acknowledgements PolicyAcknowledgement[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([organizationId, isActive])
}

model PolicyAcknowledgement {
  id             String        @id @default(uuid()) @db.Uuid
  policyId       String        @db.Uuid
  policy         CompanyPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  staffId        String        @db.Uuid
  staff          Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime      @default(now()) @db.Timestamptz
  ipAddress      String?
  userAgent      String?

  @@unique([policyId, staffId])
  @@index([staffId, acknowledgedAt])
}

model HrServiceDeskTicket {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  staffId    String   @db.Uuid
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  ticketNumber String @unique
  category     String // EMPLOYMENT_LETTER | SALARY_INQUIRY | LEAVE_INQUIRY | GRIEVANCE | PROFILE_UPDATE | BENEFIT
  priority     String @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  subject      String
  description  String

  status          String    @default("OPEN") // OPEN | IN_PROGRESS | AWAITING_EMPLOYEE | RESOLVED | CLOSED
  assignedToUser  String?   @db.Uuid
  resolutionNotes String?
  resolvedAt      DateTime? @db.Timestamptz

  messages HrServiceDeskMessage[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([propertyId, status])
  @@index([staffId])
}

// -----------------------------------------------------------------------------
// SWIMMING POOL OPERATIONS
// -----------------------------------------------------------------------------

model PoolFacility {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  code       String
  capacity   Int
  status     String   @default("OPEN") // OPEN | CLOSED | MAINTENANCE | WEATHER_HOLD
  notes      String?
  isActive   Boolean  @default(true)

  passTypes    PoolPassType[]
  entries      PoolEntry[]
  resources    PoolResource[]
  safetyChecks PoolSafetyCheck[]
  incidents    PoolIncident[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([propertyId, code])
  @@index([propertyId, isActive])
}

model PoolPassType {
  id              String       @id @default(uuid()) @db.Uuid
  propertyId      String       @db.Uuid
  property        Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  facilityId      String       @db.Uuid
  facility        PoolFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  productId       String?      @db.Uuid
  name            String
  code            String
  guestClass      String       @default("ADULT")
  price           Decimal      @default(0) @db.Decimal(18, 4)
  currency        String       @default("NGN")
  maxDuration     Int          @default(480)
  isComplimentary Boolean      @default(false)
  isActive        Boolean      @default(true)

  entries PoolEntry[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([propertyId, code])
  @@index([facilityId, isActive])
}

model PoolEntry {
  id            String       @id @default(uuid()) @db.Uuid
  propertyId    String       @db.Uuid
  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  facilityId    String       @db.Uuid
  facility      PoolFacility @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  passTypeId    String       @db.Uuid
  passType      PoolPassType @relation(fields: [passTypeId], references: [id], onDelete: Restrict)
  guestId       String?      @db.Uuid
  guest         Guest?       @relation(fields: [guestId], references: [id], onDelete: SetNull)
  reservationId String?      @db.Uuid
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  folioId       String?      @db.Uuid
  folio         Folio?       @relation(fields: [folioId], references: [id], onDelete: SetNull)
  posOrderId    String?      @db.Uuid
  posOrder      PosOrder?    @relation(fields: [posOrderId], references: [id], onDelete: SetNull)

  entryNumber    String    @unique
  identifier     String?
  status         String    @default("RESERVED") // RESERVED | ACTIVE | COMPLETED | CANCELLED
  entryDate      DateTime  @db.Date
  admittedAt     DateTime? @db.Timestamptz
  exitedAt       DateTime? @db.Timestamptz
  guestCount     Int       @default(1)
  waiverAccepted Boolean   @default(false)
  notes          String?
  createdBy      String?   @db.Uuid
  checkedInBy    String?   @db.Uuid
  checkedOutBy   String?   @db.Uuid
  operationId    String?   @unique
  deviceId       String?

  resourceBookings PoolResourceBooking[]
  incidents        PoolIncident[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([propertyId, entryDate, status])
  @@index([facilityId, entryDate, status])
  @@index([identifier, status])
}

model PoolResource {
  id         String       @id @default(uuid()) @db.Uuid
  propertyId String       @db.Uuid
  property   Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  facilityId String       @db.Uuid
  facility   PoolFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  name       String
  code       String
  type       String // CABANA | LOUNGER | LOCKER | TOWEL
  status     String       @default("AVAILABLE") // AVAILABLE | OCCUPIED | CLEANING | MAINTENANCE
  isActive   Boolean      @default(true)

  bookings PoolResourceBooking[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([propertyId, code])
  @@index([facilityId, type, status])
}

model PoolResourceBooking {
  id         String       @id @default(uuid()) @db.Uuid
  propertyId String       @db.Uuid
  property   Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  resourceId String       @db.Uuid
  resource   PoolResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  entryId    String?      @db.Uuid
  entry      PoolEntry?   @relation(fields: [entryId], references: [id], onDelete: SetNull)
  startAt    DateTime     @db.Timestamptz
  endAt      DateTime     @db.Timestamptz
  status     String       @default("BOOKED") // BOOKED | ACTIVE | COMPLETED | CANCELLED
  notes      String?
  createdBy  String?      @db.Uuid
  createdAt  DateTime     @default(now()) @db.Timestamptz
  updatedAt  DateTime     @updatedAt @db.Timestamptz

  @@index([propertyId, startAt, endAt])
  @@index([resourceId, startAt, endAt])
}

model PoolSafetyCheck {
  id         String       @id @default(uuid()) @db.Uuid
  propertyId String       @db.Uuid
  property   Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  facilityId String       @db.Uuid
  facility   PoolFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  checkType  String // OPENING | WATER_QUALITY | LIFEGUARD | CLOSING
  status     String       @default("PASS") // PASS | ATTENTION | FAILED
  chlorine   Decimal?     @db.Decimal(8, 3)
  ph         Decimal?     @db.Decimal(8, 3)
  notes      String?
  checkedBy  String?      @db.Uuid
  checkedAt  DateTime     @default(now()) @db.Timestamptz

  @@index([propertyId, checkedAt])
  @@index([facilityId, checkType, checkedAt])
}

model PoolIncident {
  id          String       @id @default(uuid()) @db.Uuid
  propertyId  String       @db.Uuid
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  facilityId  String       @db.Uuid
  facility    PoolFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  entryId     String?      @db.Uuid
  entry       PoolEntry?   @relation(fields: [entryId], references: [id], onDelete: SetNull)
  severity    String       @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL
  status      String       @default("OPEN") // OPEN | INVESTIGATING | RESOLVED
  title       String
  description String
  resolvedAt  DateTime?    @db.Timestamptz
  createdBy   String?      @db.Uuid
  resolvedBy  String?      @db.Uuid
  createdAt   DateTime     @default(now()) @db.Timestamptz
  updatedAt   DateTime     @updatedAt @db.Timestamptz

  @@index([propertyId, status, severity])
  @@index([facilityId, createdAt])
}
