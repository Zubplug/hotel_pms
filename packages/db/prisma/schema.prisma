// NIGERIAN STATUTORY CONFIGURATION, LOANS, ADVANCES & EXPENSES
// -----------------------------------------------------------------------------

model StatutoryConfiguration {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  organization     Organization @relation(fields: [organizationId], references: [id])
  versionTag       String       @default("PITA_2020_CURRENT") // e.g. "PITA_2020_CURRENT", "FINANCE_REFORMS_2026"
  taxRegime        String       @default("PITA_2011") // PITA_2011 | NTA_2026
  effectiveFrom    DateTime     @db.Date
  effectiveTo      DateTime?    @db.Date
  minimumWageFloor Decimal      @default(70000) @db.Decimal(18, 4)

  // Tax Reliefs & Bands
  craPercentGross  Decimal @default(0.20) @db.Decimal(5, 4) // 20%
  craBaseAmount    Decimal @default(200000) @db.Decimal(18, 4) // ₦200,000 annual
  craHigherPercent Decimal @default(0.01) @db.Decimal(5, 4) // 1% gross
  taxBands         Json // [{ limit: 300000, rate: 0.07 }, { limit: 300000, rate: 0.11 }, ...]

  // Pension Reform Act 2014
  pensionEmployeeRate    Decimal @default(0.08) @db.Decimal(5, 4) // 8%
  pensionEmployerRate    Decimal @default(0.10) @db.Decimal(5, 4) // 10%
  pensionEnabled         Boolean @default(true)
  pensionExemptionReason String?

  // Other statutory levies
  nhfRate            Decimal @default(0.025) @db.Decimal(5, 4) // 2.5% on basic
  nhfEnabled         Boolean @default(true)
  nhfExemptionReason String?
  nsitfRate          Decimal @default(0.01) @db.Decimal(5, 4) // 1% employer levy
  itfRate            Decimal @default(0.01) @db.Decimal(5, 4) // 1% employer levy

  standardWorkWeekHours     Decimal @default(40) @db.Decimal(5, 2)
  overtimeRateMultiplier    Decimal @default(1.5) @db.Decimal(5, 2)
  holidayOvertimeMultiplier Decimal @default(2) @db.Decimal(5, 2)
  gracePeriodMinutes        Int     @default(15)
  glSalaryExpense           String  @default("6000")
  glEmployerPensionExpense  String  @default("6010")
  glNetSalariesPayable      String  @default("2100")
  glPayePayable             String  @default("2110")
  glPensionPayable          String  @default("2120")

  isActive    Boolean @default(true)
  createdById String  @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([organizationId, versionTag])
}

model AttendancePenaltyPolicy {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String       @db.Uuid
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  code             String
  name             String
  trigger          String // LATE_ARRIVAL | EARLY_DEPARTURE | ABSENCE | MISSED_PUNCH
  calculationType  String // FIXED_AMOUNT | PER_MINUTE | PERCENT_BASIC
  amount           Decimal                       @db.Decimal(18, 4)
  graceMinutes     Int                           @default(0)
  maximumAmount    Decimal?                      @db.Decimal(18, 4)
  requiresApproval Boolean                       @default(true)
  effectiveFrom    DateTime                      @db.Date
  effectiveTo      DateTime?                     @db.Date
  isActive         Boolean                       @default(true)
  createdById      String                        @db.Uuid
  createdAt        DateTime                      @default(now()) @db.Timestamptz
  updatedAt        DateTime                      @updatedAt @db.Timestamptz
  assessments      AttendancePenaltyAssessment[]

  @@unique([propertyId, code])
  @@index([organizationId, propertyId, isActive])
  @@index([propertyId, trigger, effectiveFrom])
}

model AttendancePenaltyAssessment {
  id                 String                  @id @default(uuid()) @db.Uuid
  organizationId     String                  @db.Uuid
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId         String                  @db.Uuid
  property           Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  staffId            String                  @db.Uuid
  staff              Staff                   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  policyId           String                  @db.Uuid
  policy             AttendancePenaltyPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  attendanceRecordId String?                 @db.Uuid
  attendanceRecord   AttendanceRecord?       @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  payrollPeriodId    String?                 @db.Uuid
  payrollPeriod      PayrollPeriod?          @relation(fields: [payrollPeriodId], references: [id], onDelete: SetNull)

  eventDate          DateTime  @db.Date
  trigger            String
  minutes            Int       @default(0)
  assessedAmount     Decimal   @db.Decimal(18, 4)
  status             String    @default("PENDING")
  notes              String?
  rejectionReason    String?
  appealStatus       String?
  appealReason       String?
  appealedAt         DateTime? @db.Timestamptz
  appealReviewedById String?   @db.Uuid
  appealReviewedAt   DateTime? @db.Timestamptz
  createdById        String    @db.Uuid
  reviewedById       String?   @db.Uuid
  reviewedAt         DateTime? @db.Timestamptz
  appliedAt          DateTime? @db.Timestamptz
  createdAt          DateTime  @default(now()) @db.Timestamptz
  updatedAt          DateTime  @updatedAt @db.Timestamptz

  @@unique([staffId, policyId, eventDate])
  @@index([propertyId, status, eventDate])
  @@index([staffId, eventDate])
  @@index([payrollPeriodId])
}

model EmployeeLoan {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  staffId    String   @db.Uuid
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  loanNumber       String   @unique
  principalAmount  Decimal  @db.Decimal(18, 4)
  interestRate     Decimal  @default(0) @db.Decimal(5, 2)
  termMonths       Int      @default(12)
  monthlyDeduction Decimal  @db.Decimal(18, 4)
  remainingBalance Decimal  @db.Decimal(18, 4)
  disbursementDate DateTime @db.Date
  reason           String

  status          String    @default("ACTIVE") // PENDING | MANAGER_REVIEW | ACTIVE | FULLY_PAID | WRITTEN_OFF | REJECTED
  approvedBy      String?   @db.Uuid
  approvedAt      DateTime? @db.Timestamptz
  hrApprovedBy    String?   @db.Uuid
  hrApprovedAt    DateTime? @db.Timestamptz
  requestedBy     String?   @db.Uuid
  rejectedBy      String?   @db.Uuid
  rejectedAt      DateTime? @db.Timestamptz
  rejectionReason String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

