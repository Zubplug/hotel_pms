// POS TERMINALS & SESSIONS
// -----------------------------------------------------------------------------

enum PosTerminalType {
  RESTAURANT_POS
  BAR_POS
  CLUB_POS
  FRONT_DESK
  KITCHEN_DISPLAY
  BACK_OFFICE
}

enum PosRegistrationState {
  UNREGISTERED
  PROVISIONING
  REGISTERED
  REVOKED
}

enum PosLicenseState {
  VALID
  EXPIRED
  RESTRICTED
}

model PosTerminal {
  id                   String               @id @default(uuid()) @db.Uuid
  terminalCode         String               @unique
  name                 String
  terminalType         PosTerminalType
  organisationId       String               @db.Uuid
  propertyId           String               @db.Uuid
  outletId             String               @db.Uuid
  outlet               PosOutlet            @relation(fields: [outletId], references: [id])
  deviceCredentialHash String
  registrationState    PosRegistrationState @default(REGISTERED)
  licenseState         PosLicenseState      @default(VALID)
  licenseExpiresAt     DateTime?
  autoLockSeconds      Int?
  lastSyncAt           DateTime?
  lastSeenAt           DateTime?
  registeredAt         DateTime             @default(now())
  revokedAt            DateTime?

  configurationVersion Int @default(0)
  staffVersion         Int @default(0)
  menuVersion          Int @default(0)

  operatorSessions PosOperatorSession[]
  activationKey    PosActivationKey?

  @@map("pos_terminals")
}

// One-time bootstrap credentials for Desktop/POS terminal activation. The raw
// key is never persisted; it is shown to an administrator exactly once.
model PosActivationKey {
  id                  String       @id @default(uuid()) @db.Uuid
  keyHash             String       @unique
  organizationId      String       @db.Uuid
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId          String?      @db.Uuid
  property            Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  outletId            String?      @db.Uuid
  outlet              PosOutlet?   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  activatedTerminalId String?      @unique @db.Uuid
  activatedTerminal   PosTerminal? @relation(fields: [activatedTerminalId], references: [id], onDelete: SetNull)
  status              String       @default("ACTIVE") // ACTIVE | USED | REVOKED | EXPIRED
  expiresAt           DateTime?    @db.Timestamptz
  createdBy           String?      @db.Uuid
  activatedAt         DateTime?    @db.Timestamptz
  revokedAt           DateTime?    @db.Timestamptz
  createdAt           DateTime     @default(now()) @db.Timestamptz
  updatedAt           DateTime     @updatedAt @db.Timestamptz

  @@index([organizationId, status])
  @@index([propertyId, status])
  @@map("pos_activation_keys")
}

enum PosOperatorSessionStatus {
  ACTIVE
  LOCKED
  ENDED
}

model PosOperatorSession {
  id                   String                   @id @default(uuid()) @db.Uuid
  version              Int                      @default(1)
  terminalId           String                   @db.Uuid
  terminal             PosTerminal              @relation(fields: [terminalId], references: [id])
  outletId             String                   @db.Uuid
  operatorId           String                   @db.Uuid
  operator             Staff                    @relation(fields: [operatorId], references: [id])
  startedAt            DateTime                 @default(now())
  lastActivityAt       DateTime                 @default(now())
  lockedAt             DateTime?
  endedAt              DateTime?
  status               PosOperatorSessionStatus @default(ACTIVE)
  authenticationMethod String                   @default("PIN")
  deviceSessionId      String?

  @@map("pos_operator_sessions")
}

model PosProcessedEvent {
  eventId    String   @id // The OperationId from local SQLite
  terminalId String   @db.Uuid
  outletId   String   @db.Uuid
  sessionId  String?  @db.Uuid
  operatorId String?  @db.Uuid
  entityType String
  entityId   String
  operation  String
  payload    Json
  createdAt  DateTime @default(now())

  @@index([terminalId])
  @@map("pos_processed_events")
}

// Maps a locally-created offline shift ID to the canonical server shift when
// a reinstall or concurrent terminal opened against an already-open shift.
// This keeps later offline orders attached to the existing financial shift.
model PosSessionAlias {
  localSessionId     String   @id @db.Uuid
  canonicalSessionId String   @db.Uuid
  propertyId         String   @db.Uuid
  terminalId         String?  @db.Uuid
  operatorId         String?  @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz

  @@index([canonicalSessionId])
  @@index([propertyId, operatorId])
}

