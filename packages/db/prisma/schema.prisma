model BanquetPackageItem {
  id               String         @id @default(uuid()) @db.Uuid
  banquetPackageId String         @db.Uuid
  banquetPackage   BanquetPackage @relation(fields: [banquetPackageId], references: [id])

  // Link to existing F&B inventory for automatic consumption
  posProductId String?     @db.Uuid
  posProduct   PosProduct? @relation(fields: [posProductId], references: [id])

