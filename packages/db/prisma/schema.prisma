  creditId       String      @db.Uuid
  credit         FolioCredit @relation(fields: [creditId], references: [id])
  folioId        String      @db.Uuid
  folio          Folio       @relation(fields: [folioId], references: [id])
  amount         Decimal     @db.Decimal(18, 4)
  currency       String
  source         String
