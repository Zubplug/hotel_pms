// Controlled operating expenses paid from the General Cashier Safe.
// This is the operational expense subledger; future GL posting can consume
// the journal entry created at payment time.
model CashExpense {
  id                   String    @id @default(uuid()) @db.Uuid
  propertyId           String    @db.Uuid
  property             Property  @relation(fields: [propertyId], references: [id])
  expenseReference     String    @unique
  status               String    @default("PENDING_APPROVAL")
  amount               Decimal   @db.Decimal(18, 4)
  currency             String    @default("NGN")
  category             String
  categoryId           String?   @db.Uuid
  description          String
  payee                String
  receiptUrl           String?
  costCenter           String?
  costCenterId         String?   @db.Uuid
  requestedBy          String    @db.Uuid
  approvedBy           String?   @db.Uuid
  paidBy               String?   @db.Uuid
  cashAccountId        String?   @db.Uuid
  approvalNotes        String?
  rejectionReason      String?
  requestedAt          DateTime  @default(now()) @db.Timestamptz
  approvedAt           DateTime? @db.Timestamptz
  rejectedAt           DateTime? @db.Timestamptz
  paidAt               DateTime? @db.Timestamptz
  currentApprovalStage String?
  paymentMethod        String? // CASH | BANK_TRANSFER
  paymentReference     String?
  createdAt            DateTime  @default(now()) @db.Timestamptz
  updatedAt            DateTime  @updatedAt @db.Timestamptz

  cashAccount     CashAccount?          @relation(fields: [cashAccountId], references: [id])
  expenseCategory ExpenseCategory?      @relation(fields: [categoryId], references: [id])
  costCenterRef   CostCenter?           @relation(fields: [costCenterId], references: [id])
  journal         CashExpenseJournal?
  audits          CashExpenseAudit[]
  approvals       CashExpenseApproval[]
  lineItems       CashExpenseLineItem[]

  @@index([propertyId, status])
  @@index([propertyId, createdAt])
}

model CashExpenseLineItem {
  id          String      @id @default(uuid()) @db.Uuid
  expenseId   String      @db.Uuid
  expense     CashExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  description String
  unit        String?
  quantity    Decimal     @db.Decimal(18, 4)
  unitPrice   Decimal     @db.Decimal(18, 4)
  total       Decimal     @db.Decimal(18, 4)
  createdAt   DateTime    @default(now()) @db.Timestamptz

  @@index([expenseId])
}

// Segregated approval chain for controlled operating expenses.
model CashExpenseApproval {
  id         String      @id @default(uuid()) @db.Uuid
  expenseId  String      @db.Uuid
  expense    CashExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  stage      String // GENERAL_CASHIER | ACCOUNTANT | GENERAL_MANAGER
  status     String      @default("PENDING") // PENDING | APPROVED | REJECTED
  approverId String?     @db.Uuid
  notes      String?
  actedAt    DateTime?   @db.Timestamptz
  createdAt  DateTime    @default(now()) @db.Timestamptz
  updatedAt  DateTime    @updatedAt @db.Timestamptz

  @@unique([expenseId, stage])
  @@index([expenseId, status])
  @@index([stage, status])
}

model ExpenseCategory {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @db.Uuid
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
