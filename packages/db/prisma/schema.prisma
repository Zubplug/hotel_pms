  closedBy   String?   @db.Uuid
  approvedBy String?   @db.Uuid
  openedAt   DateTime  @default(now()) @db.Timestamptz
  closedAt   DateTime? @db.Timestamptz
  approvedAt DateTime? @db.Timestamptz

  deviceId String?    @db.Uuid // Made optional to allow Cashier Takeovers across devices
  device   PosDevice? @relation(fields: [deviceId], references: [id])

  propertyId String?   @db.Uuid
  property   Property? @relation(fields: [propertyId], references: [id])

  orders   PosOrder[]
  payments PosPayment[]

  cashMovements       PosCashMovement[]
  receiptAudits       PosReceiptAudit[]
  authorizationAudits PosAuthorizationAudit[]
