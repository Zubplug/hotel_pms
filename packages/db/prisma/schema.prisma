model CityLedgerEntry {
  id            String  @id @default(uuid()) @db.Uuid
  accountId     String  @db.Uuid
  propertyId    String  @db.Uuid
  guestId       String? @db.Uuid
  reservationId String? @db.Uuid
  folioId       String? @db.Uuid
  invoiceId     String? @db.Uuid

