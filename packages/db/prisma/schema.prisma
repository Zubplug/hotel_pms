  cashHandover           CashHandover?           @relation(fields: [cashHandoverId], references: [id])
  bankDepositAllocations BankDepositAllocation[]
  reasonNotes            String?
  handoverAt             DateTime?               @db.Timestamptz
  depositedAt            DateTime?               @db.Timestamptz

  openingCash  Decimal  @default(0) @db.Decimal(18, 4)
  cashSales    Decimal  @default(0) @db.Decimal(18, 4)
  cashRefunds  Decimal  @default(0) @db.Decimal(18, 4)
  cashIn       Decimal  @default(0) @db.Decimal(18, 4)
  cashOut      Decimal  @default(0) @db.Decimal(18, 4)
  expectedCash Decimal  @default(0) @db.Decimal(18, 4)
  actualCash   Decimal? @db.Decimal(18, 4)
  variance     Decimal? @db.Decimal(18, 4)

