  bookingEngineConfigs       BookingEngineConfig[]
  bookingSites               BookingSite[]
  bookingPaymentAccounts     BookingPaymentAccount[]
  referralPrograms           ReferralProgram[]
  referralPartners           ReferralPartner[]
  referralCampaigns          ReferralCampaign[]
  referralClicks             ReferralClick[]
  referralAttributions       ReferralAttribution[]
  referralBookings           ReferralBooking[]
  referralCommissions        ReferralCommission[]
  referralLedgerEntries      ReferralLedgerEntry[]
  reachCreativeGenerations   ReachCreativeGeneration[]
  referralPayouts            ReferralPayout[]
  referralPlatformFees       ReferralPlatformFee[]
  referralActivationPayments ReferralActivationPayment[]
