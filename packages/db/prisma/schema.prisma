  POS_REFUND
}

model StockTransaction {
  id          String    @id @default(uuid()) @db.Uuid
  propertyId  String    @db.Uuid
  property    Property  @relation(fields: [propertyId], references: [id])
  stockItemId String    @db.Uuid
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])

  source   StockTransactionSource
  quantity Decimal                @db.Decimal(18, 4)
  unitCost Decimal                @db.Decimal(18, 4)

  reference  String?
  notes      String?
  reason     AdjustmentReason?
  approvalId String?

  businessDate DateTime @db.Date

  operationId String? @unique
  deviceId    String?
  userId      String? @db.Uuid

  timestamp DateTime @default(now()) @db.Timestamptz
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
}

model PurchaseOrder {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  poNumber     String              @unique
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?           @db.Date
  totalAmount  Decimal             @default(0) @db.Decimal(18, 4)
  notes        String?

  items PurchaseOrderItem[]
  grns  GoodsReceivedNote[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

model PurchaseOrderItem {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  stockItemId     String?       @db.Uuid
  description     String

  quantity      Decimal       @db.Decimal(18, 4)
  unitOfMeasure UnitOfMeasure
  unitPrice     Decimal       @db.Decimal(18, 4)
  totalPrice    Decimal       @db.Decimal(18, 4)

  receivedQty Decimal @default(0) @db.Decimal(18, 4)
}

enum GoodsReceivedNoteStatus {
  DRAFT
  POSTED
  CANCELLED
}

model GoodsReceivedNote {
  id              String         @id @default(uuid()) @db.Uuid
  propertyId      String         @db.Uuid
  property        Property       @relation(fields: [propertyId], references: [id])
  purchaseOrderId String?        @db.Uuid
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  grnNumber       String                  @unique
  status          GoodsReceivedNoteStatus @default(DRAFT)
  deliveryNoteRef String?
  receivedDate    DateTime                @db.Date
  notes           String?

  items GoodsReceivedNoteItem[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

enum InventoryAlertStatus {
  OPEN
  RESOLVED
}

model InventoryAlert {
  id          String    @id @default(uuid()) @db.Uuid
  propertyId  String    @db.Uuid
  property    Property  @relation(fields: [propertyId], references: [id])
  stockItemId String    @db.Uuid
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])

  type    String // 'NEGATIVE_STOCK', 'REORDER_LEVEL'
  message String
  status  InventoryAlertStatus @default(OPEN)

  resolvedBy String?   @db.Uuid
  resolvedAt DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model GoodsReceivedNoteItem {
  id          String            @id @default(uuid()) @db.Uuid
  grnId       String            @db.Uuid
  grn         GoodsReceivedNote @relation(fields: [grnId], references: [id])
  stockItemId String            @db.Uuid
  description String?

  receivedQty   Decimal       @db.Decimal(18, 4)
  unitOfMeasure UnitOfMeasure
  unitCost      Decimal       @db.Decimal(18, 4)
  totalCost     Decimal       @db.Decimal(18, 4)
}

// -----------------------------------------------------------------------------
// POINT OF SALE (POS) (Phase 1)
