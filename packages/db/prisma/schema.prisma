  maxAmount  Decimal? @db.Decimal(18, 4)
  roleId     String?  @db.Uuid
  approverId String?  @db.Uuid
  role       Role?    @relation("RefundRuleRole", fields: [roleId], references: [id], onDelete: SetNull)
  approver   User?    @relation("RefundRuleApprover", fields: [approverId], references: [id], onDelete: SetNull)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

