  reachMedia                        ReachPropertyMedia[]
  reachCreativeAssets               ReachCreativeAsset[]
  reachCreativeGenerations          ReachCreativeGeneration[]
  partnerPropertyWallets            ReferralPartnerPropertyWallet[]
  partnerPropertyWalletTransactions ReferralPartnerPropertyWalletTransaction[]

  cashHandovers            CashHandover[]
  bankDeposits             BankDeposit[]
