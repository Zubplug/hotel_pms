  VOID
}

enum PayrollPeriodStatus {
  DRAFT
  PROCESSING
  PENDING_APPROVAL
  APPROVED
  PAID
  CANCELLED
}

enum PayslipStatus {
  DRAFT
  CONFIRMED
  PAID
}

enum AssetStatus {
  ACTIVE
  DISPOSED
  FULLY_DEPRECIATED
  UNDER_MAINTENANCE
  WRITTEN_OFF
}

enum DepreciationMethod {
  STRAIGHT_LINE
  REDUCING_BALANCE
  UNITS_OF_PRODUCTION
}

enum BudgetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ACTIVE
  CLOSED
}

// -----------------------------------------------------------------------------
// GROUP 1 — ACCOUNTS PAYABLE
// -----------------------------------------------------------------------------

model SupplierInvoice {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])

  supplierId      String         @db.Uuid
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?        @db.Uuid
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  invoiceNumber String
  invoiceDate   DateTime  @db.Date
  dueDate       DateTime  @db.Date
  receivedDate  DateTime? @db.Date

  subtotal          Decimal @db.Decimal(18, 4)
  taxAmount         Decimal @default(0) @db.Decimal(18, 4)
  totalAmount       Decimal @db.Decimal(18, 4)
  paidAmount        Decimal @default(0) @db.Decimal(18, 4)
  outstandingAmount Decimal @db.Decimal(18, 4)
  currency          String  @default("NGN")

  status        SupplierInvoiceStatus @default(RECEIVED)
  notes         String?
  attachmentUrl String?

  grnLinks SupplierInvoiceGRN[]
  items    SupplierInvoiceItem[]
  payments SupplierPayment[]

  createdBy  String    @db.Uuid
  approvedBy String?   @db.Uuid
  approvedAt DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([propertyId, invoiceNumber])
  @@index([propertyId, status])
  @@index([propertyId, dueDate])
  @@index([supplierId])
}

model SupplierInvoiceGRN {
  id        String @id @default(uuid()) @db.Uuid
  invoiceId String @db.Uuid
  grnId     String @db.Uuid

  invoice         SupplierInvoice   @relation(fields: [invoiceId], references: [id])
  grn             GoodsReceivedNote @relation(fields: [grnId], references: [id])
  allocatedAmount Decimal           @db.Decimal(18, 4)

  @@unique([invoiceId, grnId])
  @@index([invoiceId])
  @@index([grnId])
}

model SupplierInvoiceItem {
  id        String          @id @default(uuid()) @db.Uuid
  invoiceId String          @db.Uuid
  invoice   SupplierInvoice @relation(fields: [invoiceId], references: [id])

  grnItemId   String? @db.Uuid
  description String
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 4)
  totalPrice  Decimal @db.Decimal(18, 4)
  taxAmount   Decimal @default(0) @db.Decimal(18, 4)

  @@index([invoiceId])
}

model SupplierPayment {
  id              String  @id @default(uuid()) @db.Uuid
  propertyId      String  @db.Uuid
  invoiceId       String? @db.Uuid
  supplierId      String  @db.Uuid
  purchaseOrderId String? @db.Uuid

  invoice       SupplierInvoice? @relation(fields: [invoiceId], references: [id])
  purchaseOrder PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])

  amount           Decimal  @db.Decimal(18, 4)
  currency         String   @default("NGN")
  paymentDate      DateTime @db.Date
  paymentMethod    String // BANK_TRANSFER | CHEQUE | CASH | OTHER
  bankReference    String?
  paymentReference String   @unique
  notes            String?

  paidBy         String  @db.Uuid
  journalEntryId String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([propertyId, paymentDate])
  @@index([invoiceId])
}

// -----------------------------------------------------------------------------
// GROUP 2 — TAX REMITTANCE
// -----------------------------------------------------------------------------

model TaxRemittance {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])

  taxId String? @db.Uuid
  tax   Tax?    @relation(fields: [taxId], references: [id])

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  taxType     String // VAT | WHT | SERVICE_CHARGE | OTHER

  collectedAmount Decimal @db.Decimal(18, 4)
  remittedAmount  Decimal @db.Decimal(18, 4)
  currency        String  @default("NGN")

  remittanceDate DateTime @db.Date
  remittanceRef  String?
  authorityName  String? // FIRS | LIRS | etc.
  attachmentUrl  String?
  notes          String?

  status          TaxRemittanceStatus @default(DRAFT)
  recordedBy      String              @db.Uuid
  submittedBy     String?             @db.Uuid
  submittedAt     DateTime?           @db.Timestamptz
  approvedBy      String?             @db.Uuid
  approvedAt      DateTime?           @db.Timestamptz
  remittedBy      String?             @db.Uuid
  remittedAt      DateTime?           @db.Timestamptz
  rejectionReason String?

  journalEntryId String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([propertyId, periodStart, periodEnd])
  @@index([propertyId, status])
}

// -----------------------------------------------------------------------------
// GROUP 3 — ACCOUNTING PERIOD
// -----------------------------------------------------------------------------

model AccountingPeriod {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])

  name        String
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  status AccountingPeriodStatus @default(OPEN)

  openedBy String?   @db.Uuid
  closedBy String?   @db.Uuid
  closedAt DateTime? @db.Timestamptz
  notes    String?

  journalEntries     JournalEntry[]
  assetDepreciations AssetDepreciation[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([propertyId, periodStart])
  @@index([propertyId, status])
}

// -----------------------------------------------------------------------------
// GROUP 4 — GENERAL LEDGER
// -----------------------------------------------------------------------------

model ChartOfAccount {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])

  code          String
  name          String
  type          AccountType
  category      String // e.g. "Current Assets", "Room Revenue"
  normalBalance BalanceSide
  parentCode    String?
  description   String?
  isActive      Boolean     @default(true)

  journalLines JournalEntryLine[]
  cashAccounts CashAccount[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([propertyId, code])
  @@index([propertyId, type])
}

model JournalEntry {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])

  periodId     String?           @db.Uuid
  period       AccountingPeriod? @relation(fields: [periodId], references: [id])
  nightAuditId String?           @db.Uuid
  nightAudit   NightAudit?       @relation(fields: [nightAuditId], references: [id])

  entryNumber  String             @unique
  entryDate    DateTime           @db.Date
  description  String
  reference    String?
  source       String             @default("MANUAL") // MANUAL | AUTO_REVENUE | AUTO_PAYMENT | AUTO_EXPENSE | AUTO_DEPRECIATION | AUTO_PAYROLL
  status       JournalEntryStatus @default(DRAFT)
  totalDebit   Decimal            @default(0) @db.Decimal(18, 4)
  totalCredit  Decimal            @default(0) @db.Decimal(18, 4)
  isReversed   Boolean            @default(false)
  reversalOfId String?            @db.Uuid

  postedBy  String?   @db.Uuid
  postedAt  DateTime? @db.Timestamptz
  createdBy String    @db.Uuid

  lines JournalEntryLine[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([propertyId, nightAuditId])
  @@index([propertyId, entryDate])
  @@index([propertyId, status])
  @@index([propertyId, periodId])
  @@index([propertyId, nightAuditId])
}

model JournalEntryLine {
  id      String       @id @default(uuid()) @db.Uuid
  entryId String       @db.Uuid
  entry   JournalEntry @relation(fields: [entryId], references: [id])

  accountId String         @db.Uuid
  account   ChartOfAccount @relation(fields: [accountId], references: [id])

  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  outletId String?    @db.Uuid
  outlet   PosOutlet? @relation(fields: [outletId], references: [id])

  description String?
  debit       Decimal @default(0) @db.Decimal(18, 4)
  credit      Decimal @default(0) @db.Decimal(18, 4)

  // Drill-down: links to source transaction (Phase 2 auto-posting hooks)
  sourceType String? // FOLIO_ITEM | PAYMENT | CASH_EXPENSE | DEPRECIATION | PAYROLL | AP_PAYMENT
  sourceId   String? @db.Uuid

  @@index([entryId])
  @@index([accountId])
}

// -----------------------------------------------------------------------------
// GROUP 5 — PAYROLL
// -----------------------------------------------------------------------------

model SalaryStructure {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  propertyId     String @db.Uuid
  staffId        String @unique @db.Uuid
  staff          Staff  @relation(fields: [staffId], references: [id])

  basicSalary        Decimal @db.Decimal(18, 4)
  housingAllowance   Decimal @default(0) @db.Decimal(18, 4)
  transportAllowance Decimal @default(0) @db.Decimal(18, 4)
  otherAllowances    Decimal @default(0) @db.Decimal(18, 4)
  currency           String  @default("NGN")

  bankName                  String?
  bankAccountNumber         String?
  bankSortCode              String?
  bankAccountName           String?
  bankVerifiedAt            DateTime? @db.Timestamptz
  bankVerificationReference String?
  pensionFundAdmin          String?
  pensionNumber             String?

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  isActive      Boolean   @default(true)

  createdBy String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

/// Immutable effective-dated compensation snapshots. SalaryStructure remains
/// the legacy/current-record contract used by operational modules.
model SalaryStructureVersion {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  propertyId     String @db.Uuid
  staffId        String @db.Uuid
  staff          Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  basicSalary        Decimal @db.Decimal(18, 4)
  housingAllowance   Decimal @default(0) @db.Decimal(18, 4)
  transportAllowance Decimal @default(0) @db.Decimal(18, 4)
  otherAllowances    Decimal @default(0) @db.Decimal(18, 4)
  currency           String  @default("NGN")
  bankName           String?
  bankAccountNumber  String?
  bankSortCode       String?
  pensionFundAdmin   String?
  pensionNumber      String?

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  createdBy     String    @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz

  @@index([staffId, effectiveFrom, effectiveTo])
  @@index([organizationId, propertyId, effectiveFrom])
}

model PayrollPeriod {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  propertyId     String   @db.Uuid
  property       Property @relation(fields: [propertyId], references: [id])

  name        String
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  paymentDate DateTime? @db.Date

  status PayrollPeriodStatus @default(DRAFT)

  totalGross           Decimal @default(0) @db.Decimal(18, 4)
  totalDeductions      Decimal @default(0) @db.Decimal(18, 4)
  totalNet             Decimal @default(0) @db.Decimal(18, 4)
  totalEmployerPension Decimal @default(0) @db.Decimal(18, 4)
  totalPAYE            Decimal @default(0) @db.Decimal(18, 4)
  currency             String  @default("NGN")

  createdBy   String    @db.Uuid
  approvedBy  String?   @db.Uuid
  approvedAt  DateTime? @db.Timestamptz
  processedBy String?   @db.Uuid
  processedAt DateTime? @db.Timestamptz

  journalEntryId String? @db.Uuid

  // Audit, exception and payment disbursement tracking
  snapshot        Json? // Frozen calculation inputs and outputs for immutable audit trail
  exceptions      Json? // Anomalies detected (negative net pay, bank errors, >20% variance)
  approvalTrail   Json? // Submitter ID, approval timestamp, approver comments
  paymentBatchRef String? // NIP/CBN disbursement batch reference
  paymentStatus   String? // UNPAID | PROCESSING | PAID | PARTIAL | FAILED
  reversalOfId    String? // Pointer to reversed payroll period if applicable
  reversalReason  String? // Reason for rollback/reversal

  payslips                     Payslip[]
  payrollPayouts               PayrollPayout[]
  attendancePenaltyAssessments AttendancePenaltyAssessment[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([organizationId, propertyId, startDate])
  @@index([propertyId, status])
  @@index([organizationId, startDate])
}

model Payslip {
  id              String        @id @default(uuid()) @db.Uuid
  payrollPeriodId String        @db.Uuid
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
  staffId         String        @db.Uuid
  staff           Staff         @relation(fields: [staffId], references: [id])
  propertyId      String        @db.Uuid

  // Earnings
  basicSalary        Decimal @db.Decimal(18, 4)
  housingAllowance   Decimal @default(0) @db.Decimal(18, 4)
  transportAllowance Decimal @default(0) @db.Decimal(18, 4)
  otherAllowances    Decimal @default(0) @db.Decimal(18, 4)
  overtime           Decimal @default(0) @db.Decimal(18, 4)
  grossEarnings      Decimal @db.Decimal(18, 4)
  referralCommission Decimal @default(0) @db.Decimal(18, 4)

  // Statutory Deductions (Nigeria)
  payeTax         Decimal @default(0) @db.Decimal(18, 4) // PAYE — progressive bands
  pensionEmployee Decimal @default(0) @db.Decimal(18, 4) // 8% of pensionable earnings
  pensionEmployer Decimal @default(0) @db.Decimal(18, 4) // 10% of pensionable earnings
  nhf             Decimal @default(0) @db.Decimal(18, 4) // NHF — 2.5% of basic
  nsitf           Decimal @default(0) @db.Decimal(18, 4) // NSITF — 1% of gross

  // Other Deductions
  staffLiabilityDeductions Decimal @default(0) @db.Decimal(18, 4) // From StaffReceivable
  loanDeductions           Decimal @default(0) @db.Decimal(18, 4)
  otherDeductions          Decimal @default(0) @db.Decimal(18, 4)
  totalDeductions          Decimal @db.Decimal(18, 4)

  netPay   Decimal       @db.Decimal(18, 4)
  currency String        @default("NGN")
  status   PayslipStatus @default(DRAFT)

  bankName      String?
  accountNumber String?
  bankSortCode  String?
  bvn           String?
  tin           String?
  rsaPin        String?
  pfaName       String?

  components          PayslipComponent[]
  referralCommissions ReferralCommission[]
  payout              PayrollPayout?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([payrollPeriodId, staffId])
  @@index([propertyId, payrollPeriodId])
}

model PayslipComponent {
  id        String  @id @default(uuid()) @db.Uuid
  payslipId String  @db.Uuid
  payslip   Payslip @relation(fields: [payslipId], references: [id])

  name   String
  type   String // EARNING | DEDUCTION | STATUTORY
  amount Decimal @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([payslipId])
}

model PayrollPayout {
  id                 String        @id @default(uuid()) @db.Uuid
  organizationId     String        @db.Uuid
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId         String        @db.Uuid
  property           Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  payrollPeriodId    String        @db.Uuid
  payrollPeriod      PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  payslipId          String        @unique @db.Uuid
  payslip            Payslip       @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  staffId            String        @db.Uuid
  staff              Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  provider           String        @default("FLUTTERWAVE")
  providerReference  String        @unique
  providerTransferId String?
  providerBatchId    String?
  providerStatus     String?
  amount             Decimal       @db.Decimal(18, 4)
  currency           String        @default("NGN")
  status             String        @default("QUEUED")
  failureReason      String?
  rawResponse        Json?
  initiatedAt        DateTime?     @db.Timestamptz
  completedAt        DateTime?     @db.Timestamptz
  createdAt          DateTime      @default(now()) @db.Timestamptz
  updatedAt          DateTime      @updatedAt @db.Timestamptz

  @@index([organizationId, propertyId, status])
  @@index([payrollPeriodId, status])
  @@index([providerTransferId])
}

// -----------------------------------------------------------------------------
// GROUP 6 — FIXED ASSETS
// -----------------------------------------------------------------------------

model FixedAssetCategory {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])

  name               String
  depreciationMethod DepreciationMethod @default(STRAIGHT_LINE)
  usefulLifeYears    Int
  salvagePercent     Decimal            @default(0) @db.Decimal(5, 2)

  // GL account codes (Phase 2: link to ChartOfAccount.code)
  glAccountCode      String?
  depreciationGlCode String?
  accumulatedGlCode  String?

  isActive Boolean @default(true)

  assets FixedAsset[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model FixedAsset {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])

  categoryId String             @db.Uuid
  category   FixedAssetCategory @relation(fields: [categoryId], references: [id])

  assetNumber String  @unique
  name        String
  description String?
  location    String?

  acquisitionDate    DateTime           @db.Date
  acquisitionCost    Decimal            @db.Decimal(18, 4)
  salvageValue       Decimal            @default(0) @db.Decimal(18, 4)
  usefulLifeYears    Int
  depreciationMethod DepreciationMethod

  currentBookValue        Decimal @db.Decimal(18, 4)
  accumulatedDepreciation Decimal @default(0) @db.Decimal(18, 4)

  status AssetStatus @default(ACTIVE)

  disposalDate   DateTime? @db.Date
  disposalAmount Decimal?  @db.Decimal(18, 4)
  disposalReason String?

  supplier       String?
  invoiceRef     String?
  warrantyExpiry DateTime? @db.Date

  createdBy String @db.Uuid

  depreciationSchedule AssetDepreciation[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([propertyId, status])
  @@index([propertyId, categoryId])
}

model AssetDepreciation {
  id         String     @id @default(uuid()) @db.Uuid
  assetId    String     @db.Uuid
  asset      FixedAsset @relation(fields: [assetId], references: [id])
  propertyId String     @db.Uuid
  property   Property   @relation(fields: [propertyId], references: [id])

  periodId String?           @db.Uuid
  period   AccountingPeriod? @relation(fields: [periodId], references: [id])

  depreciationDate DateTime @db.Date
  amount           Decimal  @db.Decimal(18, 4)
  bookValueBefore  Decimal  @db.Decimal(18, 4)
  bookValueAfter   Decimal  @db.Decimal(18, 4)
  accumulatedAfter Decimal  @db.Decimal(18, 4)

  status         String  @default("POSTED") // DRAFT | POSTED
  postedBy       String? @db.Uuid
  journalEntryId String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([assetId, depreciationDate])
  @@index([propertyId, depreciationDate])
}

// -----------------------------------------------------------------------------
// GROUP 7 — BUDGETING
// -----------------------------------------------------------------------------

model Budget {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])

  name        String
  budgetType  String // ANNUAL | MONTHLY | QUARTERLY | CUSTOM
  periodStart DateTime     @db.Date
  periodEnd   DateTime     @db.Date
  currency    String       @default("NGN")
  status      BudgetStatus @default(DRAFT)

  totalRevenueBudget Decimal @default(0) @db.Decimal(18, 4)
  totalExpenseBudget Decimal @default(0) @db.Decimal(18, 4)

  lines BudgetLine[]

  createdBy  String    @db.Uuid
  approvedBy String?   @db.Uuid
  approvedAt DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([propertyId, status])
  @@index([propertyId, periodStart])
}

model BudgetLine {
  id       String @id @default(uuid()) @db.Uuid
  budgetId String @db.Uuid
  budget   Budget @relation(fields: [budgetId], references: [id])

  category    String // ROOM_REVENUE | FNB_REVENUE | LAUNDRY_REVENUE | OTHER_REVENUE | FNB_COST | PAYROLL | UTILITIES | MAINTENANCE | MARKETING | ADMIN | DEPRECIATION | OTHER_EXPENSE
  department  String? // ROOMS | FNB | LAUNDRY | SPA | ADMINISTRATION | MAINTENANCE
  description String?

  jan Decimal @default(0) @db.Decimal(18, 4)
  feb Decimal @default(0) @db.Decimal(18, 4)
  mar Decimal @default(0) @db.Decimal(18, 4)
  apr Decimal @default(0) @db.Decimal(18, 4)
  may Decimal @default(0) @db.Decimal(18, 4)
  jun Decimal @default(0) @db.Decimal(18, 4)
  jul Decimal @default(0) @db.Decimal(18, 4)
  aug Decimal @default(0) @db.Decimal(18, 4)
  sep Decimal @default(0) @db.Decimal(18, 4)
  oct Decimal @default(0) @db.Decimal(18, 4)
  nov Decimal @default(0) @db.Decimal(18, 4)
  dec Decimal @default(0) @db.Decimal(18, 4)

  totalAmount Decimal @db.Decimal(18, 4)

  @@index([budgetId, category])
