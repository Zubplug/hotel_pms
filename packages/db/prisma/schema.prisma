// BOOKING ENGINE
// =============================================================================

/// Per-property configuration for the public-facing Booking Engine.
/// Controls availability rules, rate plan exposure, and payment behaviour.
model BookingEngineConfig {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  propertyId     String @unique @db.Uuid

  /// Whether the Booking Engine is enabled for this property. Requires
  /// ADDON_BOOKING_ENGINE entitlement. Toggled from Hub settings.
  enabled              Boolean  @default(false)
  /// URL-safe slug: book.lodgecore.com/[publicSlug]
  publicSlug           String   @unique
  /// Minimum hours before arrival that a guest can book. 0 = same-day allowed.
  bookingLeadTimeHours Int      @default(0)
  /// How many days ahead guests can book. Null = unlimited.
  maxAdvanceDays       Int?
  /// Whitelist of RatePlan IDs exposed publicly. Empty array = all public plans.
  allowedRatePlanIds   String[]
  /// FULL = full payment at booking, DEPOSIT = deposit only, PAY_LATER = no online payment
  paymentMode          String   @default("PAY_LATER")
  minStay              Int      @default(1)
  maxStay              Int?
  settings             Json?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  property     Property     @relation(fields: [propertyId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([publicSlug])
}

/// White-label booking website configuration for a property.
/// Controls the public booking site appearance and domain settings.
model BookingSite {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  propertyId     String @unique @db.Uuid

  publicSlug String @unique
  siteName   String
  /// DRAFT | PUBLISHED | SUSPENDED
  status     String @default("DRAFT")

  /// Built-in template key: CLASSIC_HOTEL | MODERN_BOUTIQUE | RESORT | BUSINESS_HOTEL
  templateKey    String  @default("CLASSIC_HOTEL")
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  /// Additional theme tokens (fonts, radius, etc.) as JSON
  theme          Json?
  /// Editable page content (hero text, amenities list, etc.) as JSON
  content        Json?

  /// Custom domain (e.g. book.hotel.com). Null until configured.
  customDomain      String?   @unique
  /// PENDING | VERIFYING | VERIFIED | ACTIVE | FAILED | SUSPENDED
  domainStatus      String?
  /// TXT record value the hotel must add for DNS verification
  verificationToken String?
  verifiedAt        DateTime? @db.Timestamptz
  publishedAt       DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  property     Property     @relation(fields: [propertyId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([publicSlug])
  @@index([customDomain])
}

/// Short-lived inventory hold placed by a guest during the online booking flow.
/// A hold consumes room-type inventory until it is CONVERTED (reservation created),
/// EXPIRED (TTL elapsed), or CANCELLED.
///
/// IMPORTANT: The exclusion constraint on ReservationRoom covers roomId only
/// (physical rooms). Room-type level overbooking for holds is prevented at the
/// application layer inside a serialized transaction.
model BookingHold {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  propertyId     String @db.Uuid
  roomTypeId     String @db.Uuid

  checkIn  DateTime @db.Date
  checkOut DateTime @db.Date
  quantity Int      @default(1)

  /// SHA-256 of the hold token issued to the guest. The raw token is never stored.
  tokenHash String
  /// ACTIVE | CONVERTED | EXPIRED | CANCELLED
  status    String
  expiresAt DateTime @db.Timestamptz

  /// Immutable price snapshot captured when the hold was created.
  /// Used to detect rate changes between hold and reservation conversion.
  quoteSnapshot Json

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([propertyId, roomTypeId, checkIn, checkOut, status])
  @@index([tokenHash])
  /// For the expiry cron: find all ACTIVE holds past their TTL
  @@index([status, expiresAt])
}

/// Immutable, short-lived corporate pricing result.
///
/// `principalId` is the authenticated corporate/API principal resolved by the
/// server. It is intentionally opaque until the partner credential model is
/// finalized; callers must never be able to choose it from request payloads.
model BookingQuote {
  id                            String                       @id @default(uuid()) @db.Uuid
  organizationId                String                       @db.Uuid
  propertyId                    String                       @db.Uuid
  principalId                   String
  corporateAccountId            String?                      @db.Uuid
  corporateBookingApplicationId String?                      @db.Uuid
  corporateBookingApplication   CorporateBookingApplication? @relation(fields: [corporateBookingApplicationId], references: [id], onDelete: SetNull)
  corporateRateNegotiations       CorporateRateNegotiationRequest[] @relation("CorporateRateNegotiationQuote")
  approvedCorporateNegotiations   CorporateRateNegotiationRequest[] @relation("CorporateRateNegotiationApprovedQuote")
  requestFingerprint            String
  status                        String                       @default("ACTIVE") // ACTIVE | EXPIRED | CONSUMED | INVALIDATED
  expiresAt                     DateTime                     @db.Timestamptz
  consumedAt                    DateTime?                    @db.Timestamptz
  invalidatedAt                 DateTime?                    @db.Timestamptz
  reservationId                 String?                      @db.Uuid

  /// Full immutable contract, rate, tax/fee, inclusion, and policy snapshot.
  snapshot Json

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([principalId, propertyId, status, expiresAt])
  @@index([organizationId, propertyId, requestFingerprint])
  @@index([corporateAccountId, status, expiresAt])
  @@index([corporateBookingApplicationId, status, expiresAt])
}

/// Short-lived identity for a corporate website/API buyer. A permanent PMS
/// CorporateAccount and City Ledger account are materialized only after a
/// verified prepaid settlement or an authorized pay-later approval.
model CorporateBookingApplication {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  propertyId         String   @db.Uuid
  companyName        String
  contactPerson      String
  contactEmail       String
  contactPhone       String?
  companyAddress     String?
  companyCity        String?
  companyCountry     String?
  status             String   @default("PENDING") // PENDING | CONVERTED | REJECTED | EXPIRED
  paymentMode        String
  requestedCurrency  String
  sourceChannel      String // CORPORATE_API | STANDALONE_CORPORATE_WEBSITE
  principalId        String?
  accessTokenHash    String?  @unique
  expiresAt          DateTime @db.Timestamptz
  corporateAccountId String?  @db.Uuid

  organization            Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property                Property                          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  corporateAccount        CorporateAccount?                 @relation(fields: [corporateAccountId], references: [id], onDelete: SetNull)
  quotes                  BookingQuote[]
  reservations            Reservation[]
  paymentGroups           CorporatePaymentGroup[]
  contracts               CorporateContract[]
  rateNegotiationRequests CorporateRateNegotiationRequest[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([organizationId, propertyId, status, expiresAt])
  @@index([propertyId, contactEmail, status])
}

/// Payment boundary for one or more corporate reservations. Gateway payment
/// remains one economic payment and is settled once into City Ledger; the join
/// rows identify the reservations covered by that payment requirement.
model CorporatePaymentGroup {
  id                            String  @id @default(uuid()) @db.Uuid
  organizationId                String  @db.Uuid
  propertyId                    String  @db.Uuid
  corporateAccountId            String? @db.Uuid
  corporateBookingApplicationId String? @db.Uuid
  requiredAmount                Decimal @db.Decimal(18, 4)
  currency                      String
  status                        String  @default("PENDING") // PENDING | PARTIALLY_SETTLED | SETTLED | EXPIRED | FAILED

  organization                Organization                       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property                    Property                           @relation(fields: [propertyId], references: [id])
  corporateAccount            CorporateAccount?                  @relation(fields: [corporateAccountId], references: [id])
  corporateBookingApplication CorporateBookingApplication?       @relation(fields: [corporateBookingApplicationId], references: [id])
  reservations                CorporatePaymentGroupReservation[]
  transactions                BookingPaymentTransaction[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([propertyId, status, createdAt])
  @@index([corporateAccountId, status])
  @@index([corporateBookingApplicationId, status])
}

model CorporatePaymentGroupReservation {
  id             String  @id @default(uuid()) @db.Uuid
  groupId        String  @db.Uuid
  reservationId  String  @unique @db.Uuid
  amountRequired Decimal @db.Decimal(18, 4)

  group       CorporatePaymentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  reservation Reservation           @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([groupId, reservationId])
}

/// Gateway-level record for a payment transaction initiated via the Booking Engine.
/// On success, this drives creation of a native Payment record in the existing
/// Folio/accounting pipeline. It is NOT a parallel accounting system.
model BookingPaymentTransaction {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  propertyId     String  @db.Uuid
  reservationId  String? @db.Uuid
  holdId         String? @db.Uuid
  cityLedgerInvoiceId String? @unique @db.Uuid

  /// PAYSTACK | FLUTTERWAVE
  provider     String
  /// Provider's reference for this transaction (e.g. Paystack reference)
  providerRef  String? @unique
  /// Provider's internal transaction ID after verification
  providerTxId String?

  amount   Decimal @db.Decimal(18, 4)
  currency String

  /// PENDING | SUCCESS | FAILED | REFUNDED
  status String

  /// Server-generated key — prevents duplicate payment processing from webhook replays
  idempotencyKey  String  @unique
  webhookVerified Boolean @default(false)
  webhookPayload  Json?

  /// Set after a successful webhook: the ID of the Payment record created in the folio
  paymentId String? @db.Uuid

  /// Set only for CORPORATE_API settlements. This is the durable one-to-one
  /// link between the verified gateway transaction and its City Ledger
  /// payment entry. It prevents a retry from creating a second spendable
  /// corporate advance.
  cityLedgerEntryId       String?                @unique @db.Uuid
  cityLedgerEntry         CityLedgerEntry?       @relation("CorporateSettlementEntry", fields: [cityLedgerEntryId], references: [id])
  corporatePaymentGroupId String?                @db.Uuid
  corporatePaymentGroup   CorporatePaymentGroup? @relation(fields: [corporatePaymentGroupId], references: [id])
  cityLedgerInvoice       CityLedgerInvoice?      @relation(fields: [cityLedgerInvoiceId], references: [id])

  metadata Json?

  lateRefund Refund? @relation("BookingPaymentLateRefund")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([providerRef])
  @@index([reservationId])
  @@index([idempotencyKey])
  @@index([corporatePaymentGroupId, status])
}

/// Idempotency guard for the reservation creation step of the booking flow.
/// Prevents duplicate reservations from browser retries, network replays, or
/// double-clicks. One record per booking attempt keyed by a client-generated UUID.
model BookingRequest {
  /// Client-generated UUID, unique per booking attempt
  idempotencyKey     String  @id
  propertyId         String  @db.Uuid
  /// Authenticated corporate/API principal for non-public booking attempts.
  principalId        String?
  operation          String?
  requestFingerprint String?

  /// PROCESSING | COMPLETED | FAILED
  status         String
  reservationId  String? @db.Uuid
  /// All reservations created by a multi-room corporate booking, in creation order.
  reservationIds Json?
  errorMessage   String?

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([propertyId, createdAt])
  @@index([principalId, propertyId, operation, createdAt])
}

/// Payment provider account configuration for the Booking Engine.
/// Supports both LodgeCore platform accounts (PLATFORM mode) and
/// customer-owned merchant accounts (CUSTOMER mode).
/// Customer credentials are encrypted at rest; platform credentials continue
/// to use environment-variable references.
model BookingPaymentAccount {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  /// Null = org-level account; set = property-specific account
  propertyId     String?   @db.Uuid
  property       Property? @relation(fields: [propertyId], references: [id])

  /// PAYSTACK | FLUTTERWAVE
  provider String
  /// BOOKING_ENGINE | STANDALONE_API
  target   String @default("BOOKING_ENGINE")
  /// PLATFORM = LodgeCore's own account; CUSTOMER = hotel's own merchant account
  mode     String

  publicKey               String?
  /// Name of the environment variable that holds the secret key. Never the raw key.
  secretRef               String?
  /// Name of the environment variable that holds the webhook secret.
  webhookSecretRef        String?
  /// Encrypted customer-owned provider credentials. Never expose these fields
  /// to portal clients or API responses.
  secretCiphertext        String?
  webhookSecretCiphertext String?

  currency       String
  isActive       Boolean @default(false)
  payrollEnabled Boolean @default(true)

  createdAt    DateTime     @default(now()) @db.Timestamptz
  updatedAt    DateTime     @updatedAt @db.Timestamptz
  Organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, provider, isActive])
}

