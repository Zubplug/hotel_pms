enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ApprovalExecutionStatus {
  NOT_APPLIED
  APPLYING
  APPLIED
  FAILED
}

model ApprovalRequest {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  outletId   String?  @db.Uuid

  type            String // 'REFUND', 'VOID', 'DISCOUNT', 'INVENTORY_ADJUSTMENT'
  status          ApprovalRequestStatus   @default(PENDING)
  executionStatus ApprovalExecutionStatus @default(NOT_APPLIED)

  requestedBy String   @db.Uuid // Staff ID
  requestedAt DateTime @default(now()) @db.Timestamptz

  beneficiaryType       String?
  beneficiaryGuestId    String? @db.Uuid
  beneficiaryStaffId    String? @db.Uuid
  acknowledgedByStaffId String? @db.Uuid
  acknowledgedAt        DateTime? @db.Timestamptz
  acknowledgedBy        Staff? @relation("ApprovalAcknowledgement", fields: [acknowledgedByStaffId], references: [id])
  beneficiaryStaff       Staff? @relation("ApprovalStaffBeneficiary", fields: [beneficiaryStaffId], references: [id])

  reviewedBy String?   @db.Uuid // Staff ID
  reviewedAt DateTime? @db.Timestamptz

  amount   Decimal? @db.Decimal(18, 4)
  currency String?

  reason         String
  details        Json? // Payload/Context
  snapshot       Json? // Immutable snapshot of what was approved
  idempotencyKey String? @unique

  expiresAt DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  mutations ApprovalMutation[]
}

model ApprovalMutation {
  id             String          @id @default(uuid()) @db.Uuid
  idempotencyKey String          @unique
  userId         String          @db.Uuid
  approvalId     String          @db.Uuid
  approval       ApprovalRequest @relation(fields: [approvalId], references: [id])

  action          String
  requestHash     String
  status          String
  responsePayload Json?

  createdAt   DateTime  @default(now()) @db.Timestamptz
  completedAt DateTime? @db.Timestamptz

  @@index([idempotencyKey])
}

