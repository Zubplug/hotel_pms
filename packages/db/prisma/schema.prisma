  eventBookingId String       @db.Uuid
  eventBooking   EventBooking @relation(fields: [eventBookingId], references: [id])

  equipmentId String         @db.Uuid
  equipment   EventEquipment @relation(fields: [equipmentId], references: [id])

  quantity Int @default(1)

