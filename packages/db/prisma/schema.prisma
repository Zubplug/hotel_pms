  category       String
  brand          String?
  model          String?
  serialNumber   String?
  status         String                 @default("IN_STOCK")
  warrantyEndsAt DateTime?              @db.Timestamptz
  metadata       Json?
  installations  HardwareInstallation[]
  createdAt      DateTime               @default(now()) @db.Timestamptz
  updatedAt      DateTime               @updatedAt @db.Timestamptz

  @@unique([organizationId, serialNumber])
  @@index([organizationId, category, status])
  @@index([propertyId])
}

model HardwareInstallation {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @db.Uuid
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId       String?            @db.Uuid
  property         Property?          @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  inventoryId      String?            @db.Uuid
  inventory        HardwareInventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  status           String             @default("REQUESTED")
  installationType String
  requestedAt      DateTime           @default(now()) @db.Timestamptz
  scheduledAt      DateTime?          @db.Timestamptz
  completedAt      DateTime?          @db.Timestamptz
  installer        String?
  notes            String?
  siteInfo         Json?
  createdAt        DateTime           @default(now()) @db.Timestamptz
  updatedAt        DateTime           @updatedAt @db.Timestamptz

  @@index([organizationId, status])
  @@index([propertyId, scheduledAt])
}

model SupportTicket {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String       @unique
  subject        String
  description    String
  status         String       @default("OPEN")
  priority       String       @default("NORMAL")
  requesterEmail String
  assignee       String?
  slaDueAt       DateTime?    @db.Timestamptz
  resolvedAt     DateTime?    @db.Timestamptz
  metadata       Json?
  createdAt      DateTime     @default(now()) @db.Timestamptz
  updatedAt      DateTime     @updatedAt @db.Timestamptz

  @@index([organizationId, status, priority])
}

model IntegrationDefinition {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String?                @db.Uuid
  organization   Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug           String                 @unique
  name           String
  category       String
  description    String
  active         Boolean                @default(true)
  setupSchema    Json?
  metadata       Json?
  installed      InstalledIntegration[]
  createdAt      DateTime               @default(now()) @db.Timestamptz
  updatedAt      DateTime               @updatedAt @db.Timestamptz
}

model InstalledIntegration {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  definitionId   String                @db.Uuid
  definition     IntegrationDefinition @relation(fields: [definitionId], references: [id])
  propertyId     String?               @db.Uuid
  property       Property?             @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  status         String                @default("PENDING")
  credentialsRef String?
  config         Json?
  lastSyncAt     DateTime?             @db.Timestamptz
  createdAt      DateTime              @default(now()) @db.Timestamptz
  updatedAt      DateTime              @updatedAt @db.Timestamptz

  @@unique([organizationId, definitionId, propertyId])
  @@index([organizationId, status])
}

model PropertyIntegration {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String       @db.Uuid
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  name     String // e.g. "Main Website", "Partner Booking Widget"
  provider String @default("LODGECORE_CMS") // e.g. LODGECORE_CMS, CUSTOM_WEBSITE, WIDGET
  status   String @default("ACTIVE") // ACTIVE, SUSPENDED

  publishableKeys PublishableKey[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([propertyId])
  @@index([organizationId])
}

model PublishableKey {
  id            String              @id @default(uuid()) @db.Uuid
  integrationId String              @db.Uuid
  integration   PropertyIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  key            String   @unique // e.g. "pk_live_..."
  environment    String   @default("LIVE") // TEST, LIVE
  status         String   @default("ACTIVE") // ACTIVE, REVOKED
  allowedOrigins String[] @default([]) // e.g. ["https://myhotel.com", "https://*.myhotel.com"]

  lastUsedAt DateTime? @db.Timestamptz
  revokedAt  DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @updatedAt @db.Timestamptz

  @@index([key])
  @@index([integrationId, status])
}

model WebsiteProject {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String       @db.Uuid
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  status                        String    @default("DRAFT") // DRAFT, PUBLISHED, SUSPENDED
  name                          String
  customDomain                  String?   @unique
  customDomainVerifiedAt        DateTime? @db.Timestamptz
  customDomainVerificationToken String?   @unique

  primaryColor   String?
  secondaryColor String?
  logoUrl        String?
  faviconUrl     String?

  contactEmail String?
  contactPhone String?
  socialLinks  Json? // { facebook, instagram, twitter, etc }
  seoMetadata  Json? // { defaultTitleFormat, defaultDescription }

  activeRevisionId  String?          @db.Uuid
  activeRevision    WebsiteRevision? @relation("ActiveRevision", fields: [activeRevisionId], references: [id])
  previewRevisionId String?          @db.Uuid
  previewRevision   WebsiteRevision? @relation("PreviewRevision", fields: [previewRevisionId], references: [id])

  revisions WebsiteRevision[] @relation("ProjectRevisions")
  assets    WebsiteAsset[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([propertyId])
  @@index([organizationId])
  @@index([customDomain])
