}

model ExpenseClaim {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  staffId    String   @db.Uuid
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  claimNumber String  @unique
  category    String // TRAVEL | HOTEL_SUPPLIES | MEDICAL | MEALS | OTHER
  amount      Decimal @db.Decimal(18, 4)
  currency    String  @default("NGN")
  receiptUrl  String?
  description String

  // SUBMITTED/HR_REVIEW -> ACCOUNTANT_REVIEW -> GENERAL_MANAGER_REVIEW
  // -> APPROVED_FOR_PAYMENT -> REIMBURSED. REJECTED is terminal.
  status                   String    @default("HR_REVIEW")
  approvedBy               String?   @db.Uuid
  approvedAt               DateTime? @db.Timestamptz
  hrReviewedBy             String?   @db.Uuid
  hrReviewedAt             DateTime? @db.Timestamptz
  accountantReviewedBy     String?   @db.Uuid
  accountantReviewedAt     DateTime? @db.Timestamptz
  managerApprovedBy        String?   @db.Uuid
  managerApprovedAt        DateTime? @db.Timestamptz
  rejectionReason          String?
  requestedPaymentMethod   String    @default("CASH") // CASH | BANK_TRANSFER
  autoPaymentStatus        String? // PENDING | PROCESSING | SUCCESSFUL | FAILED | MANUAL_REQUIRED
  paymentMethod            String?
  paymentReference         String?
  paidBy                   String?   @db.Uuid
  paidAt                   DateTime? @db.Timestamptz
  paymentAccountId         String?   @db.Uuid
  accountingJournalEntryId String?   @db.Uuid
  reimbursedInPeriodId     String?   @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([propertyId, status])
  @@index([staffId, createdAt])
}

// -----------------------------------------------------------------------------
// PERFORMANCE, TRAINING & DISCIPLINARY
// -----------------------------------------------------------------------------

model PerformanceAppraisal {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  staffId    String   @db.Uuid
  staff      Staff    @relation("AppraisalStaff", fields: [staffId], references: [id], onDelete: Cascade)
  reviewerId String   @db.Uuid
  reviewer   Staff    @relation("AppraisalReviewer", fields: [reviewerId], references: [id])

  cycleName   String // e.g. "Q1 2026", "Annual 2025"
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  kpis            Json // [{ kpi: "Guest Satisfaction", target: "95%", actual: "92%", score: 4 }]
  selfScore       Decimal? @db.Decimal(3, 1) // 1.0 - 5.0
  managerScore    Decimal? @db.Decimal(3, 1)
  finalRating     String? // OUTSTANDING | EXCEEDS_EXPECTATIONS | MEETS_EXPECTATIONS | NEEDS_IMPROVEMENT | UNSATISFACTORY
  developmentPlan String?
  promotionReady  Boolean  @default(false)

  status String @default("DRAFT") // DRAFT | SUBMITTED | REVIEWED | ACKNOWLEDGED

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([propertyId, cycleName])
  @@index([staffId])
}

model TrainingRecord {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  staffId    String   @db.Uuid
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  courseTitle    String // Food Safety, Fire Safety, Customer Service, Opera/LodgeCore PMS
  provider       String?
  completedAt    DateTime  @db.Date
  expiresAt      DateTime? @db.Date
  certificateUrl String?
  score          Decimal?  @db.Decimal(5, 2)
  isMandatory    Boolean   @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([propertyId, courseTitle])
  @@index([staffId])
}

model DisciplinaryRecord {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  staffId    String   @db.Uuid
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  incidentDate   DateTime @db.Date
  type           String // VERBAL_WARNING | WRITTEN_WARNING | SUSPENSION | INQUIRY | FINAL_WARNING | TERMINATION
  subject        String
  description    String
  actionTaken    String
  isConfidential Boolean  @default(true)

  issuedByUserId  String    @db.Uuid
  documentUrl     String?
  status          String    @default("OPEN")
  reviewedBy      String?   @db.Uuid
  reviewedAt      DateTime? @db.Timestamptz
  resolutionNotes String?
  closedAt        DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([propertyId, type])
  @@index([staffId])
}

