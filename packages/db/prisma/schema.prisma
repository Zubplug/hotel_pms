  openedAt               DateTime                @default(now()) @db.Timestamptz
  closingAt              DateTime?               @db.Timestamptz
  closedAt               DateTime?               @db.Timestamptz
  reconciledAt           DateTime?               @db.Timestamptz
  reconciledBy           String?                 @db.Uuid
  reconciliationDecision String?
  reconciliationNotes    String?
  submittedAt            DateTime?               @db.Timestamptz
  submittedBy            String?                 @db.Uuid
  reviewStartedAt        DateTime?               @db.Timestamptz
  reviewStartedBy        String?                 @db.Uuid
  approvalDecision       String?
  approvalNotes          String?
  approvedBy             String?                 @db.Uuid
  approvedAt             DateTime?               @db.Timestamptz
