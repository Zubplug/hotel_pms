  property      Property     @relation(fields: [propertyId], references: [id])

  amount          Decimal       @db.Decimal(18, 4)
  remainingAmount Decimal       @db.Decimal(18, 4)
  currency        String
  method          PaymentMethod
  status          String        @default("AVAILABLE") // AVAILABLE | PARTIALLY_APPLIED | EXHAUSTED | REFUNDED
  reference       String?
  notes           String?
  receivedBy      String        @db.Uuid
  deviceId        String?
  operationId     String?
  idempotencyKey  String        @unique
  businessDate    DateTime      @db.Date
  approvalId      String?
  approvalStatus  String        @default("NOT_REQUIRED") // NOT_REQUIRED | PENDING_APPROVAL | APPROVED | REJECTED

