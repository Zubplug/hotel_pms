// INVENTORY & PROCUREMENT (Phase 1)
// -----------------------------------------------------------------------------

enum UnitOfMeasure {
  KG
  GRAM
  LITRE
  ML
  PIECE
  BOX
  BOTTLE
  PACK
}

model UnitOfMeasureConversion {
  id         String        @id @default(uuid()) @db.Uuid
  propertyId String        @db.Uuid
  property   Property      @relation(fields: [propertyId], references: [id])
  fromUnit   UnitOfMeasure
  toUnit     UnitOfMeasure
  ratio      Decimal       @db.Decimal(18, 6)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  propertyId    String   @db.Uuid
  property      Property @relation(fields: [propertyId], references: [id])
  name          String
  contactName   String?
  email         String?
  phone         String?
  address       String?
  taxIdentifier String?
  isActive      Boolean  @default(true)

  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

model Warehouse {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  name       String
  location   String?
  isActive   Boolean  @default(true)
  posOutletId String? @unique @db.Uuid
  posOutlet   PosOutlet? @relation(fields: [posOutletId], references: [id])

  stockItems    StockItem[]
  transactions  StockTransaction[]
  transfersFrom StockTransfer[]    @relation("TransferFrom")
  transfersTo   StockTransfer[]    @relation("TransferTo")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

model InventoryCategory {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  name       String
  isActive   Boolean  @default(true)

  stockItems StockItem[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@unique([propertyId, name])
}

model StockItem {
  id          String    @id @default(uuid()) @db.Uuid
  propertyId  String    @db.Uuid
  property    Property  @relation(fields: [propertyId], references: [id])
  warehouseId String    @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  posProductId String?     @db.Uuid
  posProduct   PosProduct? @relation(fields: [posProductId], references: [id])
  
  categoryId       String?            @db.Uuid
  inventoryCategory InventoryCategory? @relation(fields: [categoryId], references: [id])

  name     String
  sku      String?
  barcode  String?
  baseUnit UnitOfMeasure

  costPrice      Decimal  @default(0) @db.Decimal(18, 4)
  quantityOnHand Decimal  @default(0) @db.Decimal(18, 4)
  reorderLevel   Decimal? @db.Decimal(18, 4)

  isActive Boolean @default(true)

  recipeIngredients RecipeIngredient[]
  transactions      StockTransaction[]
  alerts            InventoryAlert[]
  transferItems     StockTransferItem[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@unique([propertyId, barcode])
  @@unique([posProductId, warehouseId])
}

enum AdjustmentReason {
  SPOILAGE
  THEFT
  DAMAGE
  MISCOUNT
  WASTE
  EXPIRY
  OPENING_BALANCE
  OTHER
}

enum StockTransactionSource {
  RECEIPT
  SALE
  TRANSFER
  ADJUSTMENT
  WASTE
  RETURN
  POS_VOID
  POS_REFUND
}

model StockTransaction {
  id          String    @id @default(uuid()) @db.Uuid
  propertyId  String    @db.Uuid
  property    Property  @relation(fields: [propertyId], references: [id])
  stockItemId String    @db.Uuid
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])

  source   StockTransactionSource
  quantity Decimal                @db.Decimal(18, 4)
  unitCost Decimal                @db.Decimal(18, 4)

  reference  String?
  notes      String?
  reason     AdjustmentReason?
  approvalId String?

  businessDate DateTime @db.Date

  operationId String? @unique
  deviceId    String?
  userId      String? @db.Uuid

  timestamp DateTime @default(now()) @db.Timestamptz

  quantityBefore Decimal @default(0) @db.Decimal(18, 4)
  quantityAfter  Decimal @default(0) @db.Decimal(18, 4)
  totalValue     Decimal @default(0) @db.Decimal(18, 4)
  currency       String  @default("NGN")

  warehouseId String?    @db.Uuid
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  grnId String?            @db.Uuid
  grn   GoodsReceivedNote? @relation(fields: [grnId], references: [id])

  transferId String?        @db.Uuid
  transfer   StockTransfer? @relation(fields: [transferId], references: [id])
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  REJECTED
  CANCELLED
  CLOSED
}

model PurchaseOrder {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  poNumber     String              @unique
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?           @db.Date
  totalAmount  Decimal             @default(0) @db.Decimal(18, 4)
  notes        String?

  currency       String    @default("NGN")
  rejectedBy     String?   @db.Uuid
  rejectedAt     DateTime? @db.Timestamptz
  rejectedReason String?
  cancelledBy    String?   @db.Uuid
  cancelledAt    DateTime? @db.Timestamptz

  items PurchaseOrderItem[]
  grns  GoodsReceivedNote[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

model PurchaseOrderItem {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  stockItemId     String?       @db.Uuid
  description     String

  quantity      Decimal       @db.Decimal(18, 4)
  unitOfMeasure UnitOfMeasure
  unitPrice     Decimal       @db.Decimal(18, 4)
  totalPrice    Decimal       @db.Decimal(18, 4)

  receivedQty Decimal @default(0) @db.Decimal(18, 4)
}

enum GoodsReceivedNoteStatus {
  DRAFT
  POSTED
  CANCELLED
}

model GoodsReceivedNote {
  id              String         @id @default(uuid()) @db.Uuid
  propertyId      String         @db.Uuid
  property        Property       @relation(fields: [propertyId], references: [id])
  purchaseOrderId String?        @db.Uuid
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  grnNumber       String                  @unique
  status          GoodsReceivedNoteStatus @default(DRAFT)
  deliveryNoteRef String?
  receivedDate    DateTime                @db.Date
  notes           String?

  items        GoodsReceivedNoteItem[]
  transactions StockTransaction[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

enum InventoryAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model InventoryAlert {
  id          String    @id @default(uuid()) @db.Uuid
  propertyId  String    @db.Uuid
  property    Property  @relation(fields: [propertyId], references: [id])
  stockItemId String    @db.Uuid
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])

  type    String // 'NEGATIVE_STOCK', 'REORDER_LEVEL'
  message String
  status  InventoryAlertStatus @default(OPEN)

  acknowledgedBy String?   @db.Uuid
  acknowledgedAt DateTime? @db.Timestamptz

  resolvedBy String?   @db.Uuid
  resolvedAt DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model GoodsReceivedNoteItem {
  id          String            @id @default(uuid()) @db.Uuid
  grnId       String            @db.Uuid
  grn         GoodsReceivedNote @relation(fields: [grnId], references: [id])
  stockItemId String            @db.Uuid
  description String?

  receivedQty   Decimal       @db.Decimal(18, 4)
  unitOfMeasure UnitOfMeasure
  unitCost      Decimal       @db.Decimal(18, 4)
  totalCost     Decimal       @db.Decimal(18, 4)
}

// -----------------------------------------------------------------------------
// POINT OF SALE (POS) (Phase 1)
// -----------------------------------------------------------------------------

model PosOutlet {
  id              String   @id @default(uuid()) @db.Uuid
  propertyId      String   @db.Uuid
  property        Property @relation(fields: [propertyId], references: [id])
  name            String
  type            String
  isActive        Boolean  @default(true)
  autoLockSeconds Int      @default(60)

  categories ProductCategory[]
  sessions   PosSession[]
  orders     PosOrder[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  devices     PosDevice[]
  terminals   PosTerminal[]
  staffAccess StaffPosOutletAccess[]
  floorPlans  PosFloorPlan[]
  CashAccount CashAccount[]
  warehouse   Warehouse?
}

model PosFloorPlan {
  id       String    @id @default(uuid()) @db.Uuid
  outletId String    @db.Uuid
  outlet   PosOutlet @relation(fields: [outletId], references: [id])
  name     String
  isActive Boolean   @default(true)

  tables PosTable[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model PosTable {
  id          String       @id @default(uuid()) @db.Uuid
  floorPlanId String       @db.Uuid
  floorPlan   PosFloorPlan @relation(fields: [floorPlanId], references: [id])

  name      String
  capacity  Int
  positionX Int    @default(0)
  positionY Int    @default(0)

  currentOrderId String? @db.Uuid

  isActive Boolean @default(true)

  orders PosOrder[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model ProductCategory {
  id                String            @id @default(uuid()) @db.Uuid
  outletId          String            @db.Uuid
  outlet            PosOutlet         @relation(fields: [outletId], references: [id])
  name              String
  isActive          Boolean           @default(true)
  sortOrder         Int               @default(0)
  productionStation ProductionStation @default(KITCHEN)

  products PosProduct[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model PosProduct {
  id         String          @id @default(uuid()) @db.Uuid
  propertyId String          @db.Uuid
  property   Property        @relation(fields: [propertyId], references: [id])
  categoryId String          @db.Uuid
  category   ProductCategory @relation(fields: [categoryId], references: [id])

  name              String
  description       String?
  price             Decimal            @db.Decimal(18, 4)
  taxRate           Decimal            @default(0) @db.Decimal(5, 2)
  isActive          Boolean            @default(true)
  image             String?
  productionStation ProductionStation?

  ingredients RecipeIngredient[]
  modifiers   PosProductModifier[]
  stockItems  StockItem[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

model PosProductModifier {
  id        String     @id @default(uuid()) @db.Uuid
  productId String     @db.Uuid
  product   PosProduct @relation(fields: [productId], references: [id])

  name     String
  price    Decimal @default(0) @db.Decimal(18, 4)
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz
}

model RecipeIngredient {
  id          String     @id @default(uuid()) @db.Uuid
  productId   String     @db.Uuid
  product     PosProduct @relation(fields: [productId], references: [id])
  stockItemId String     @db.Uuid
  stockItem   StockItem  @relation(fields: [stockItemId], references: [id])

  quantity      Decimal       @db.Decimal(18, 4)
  unitOfMeasure UnitOfMeasure

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

enum PosSessionStatus {
  OPEN
  CLOSED
  RECONCILED
  RECONCILIATION_REQUIRED
}

model PosSession {
  id       String    @id @default(uuid()) @db.Uuid
  version  Int       @default(1)
  outletId String    @db.Uuid
  outlet   PosOutlet @relation(fields: [outletId], references: [id])

  bankingModel      String // 'SERVER_BANKING' or 'CENTRAL_CASHIER'
  bankType          String // 'SERVER', 'CENTRAL', or 'EMERGENCY'
  primaryOperatorId String? @db.Uuid
  primaryOperator   Staff?  @relation("PosSessionPrimaryOperator", fields: [primaryOperatorId], references: [id])
  authorizedBy      String? @db.Uuid
  reason            String?

  status       PosSessionStatus @default(OPEN)
  businessDate DateTime         @db.Date

  openingCash  Decimal  @default(0) @db.Decimal(18, 4)
  cashSales    Decimal  @default(0) @db.Decimal(18, 4)
  cashRefunds  Decimal  @default(0) @db.Decimal(18, 4)
  cashIn       Decimal  @default(0) @db.Decimal(18, 4)
  cashOut      Decimal  @default(0) @db.Decimal(18, 4)
  expectedCash Decimal  @default(0) @db.Decimal(18, 4)
  actualCash   Decimal? @db.Decimal(18, 4)
  variance     Decimal? @db.Decimal(18, 4)

  openedBy   String    @db.Uuid
  closedBy   String?   @db.Uuid
  approvedBy String?   @db.Uuid
  openedAt   DateTime  @default(now()) @db.Timestamptz
  closedAt   DateTime? @db.Timestamptz
  approvedAt DateTime? @db.Timestamptz

  deviceId String?    @db.Uuid // Made optional to allow Cashier Takeovers across devices
  device   PosDevice? @relation(fields: [deviceId], references: [id])

  propertyId String?   @db.Uuid
  property   Property? @relation(fields: [propertyId], references: [id])

  orders   PosOrder[]
  payments PosPayment[]

  cashMovements       PosCashMovement[]
  receiptAudits       PosReceiptAudit[]
  authorizationAudits PosAuthorizationAudit[]
  settlements         PosSettlement[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

enum PosCashMovementType {
  OPENING_FLOAT
  PAYMENT
  REFUND
  ADJUSTMENT
  PAID_OUT
  CASH_DROP
  CASH_TRANSFER_IN
  CASH_TRANSFER_OUT
  FLOAT_ADJUSTMENT
  SETTLED_ACTUAL
  VARIANCE
  SERVER_HANDOVER
  STATION_HANDOVER
  EMERGENCY_HANDOVER
}

model CashAccount {
  id         String     @id @default(uuid()) @db.Uuid
  propertyId String     @db.Uuid
  property   Property   @relation(fields: [propertyId], references: [id])
  outletId   String?    @db.Uuid
  outlet     PosOutlet? @relation(fields: [outletId], references: [id])
  name       String
  type       String // e.g. SAFE, SERVER_BANK, STATION_BANK, EMERGENCY_BANK, BANK_ACCOUNT, EXTERNAL
  balance    Decimal    @default(0) @db.Decimal(18, 4)
  ownerId    String?    @db.Uuid
  owner      Staff?     @relation(fields: [ownerId], references: [id])
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now()) @db.Timestamptz
  updatedAt  DateTime   @updatedAt @db.Timestamptz

  sourceMovements      PosCashMovement[]  @relation("SourceAccount")
  destinationMovements PosCashMovement[]  @relation("DestinationAccount")
  frontdeskSessions    FrontdeskSession[]
}

model PosCashMovement {
  id                   String              @id @default(uuid()) @db.Uuid
  propertyId           String              @db.Uuid
  deviceId             String
  posSessionId         String?             @db.Uuid
  frontdeskSessionId   String?             @db.Uuid
  userId               String              @db.Uuid
  amount               Decimal             @db.Decimal(18, 4)
  currency             String              @default("NGN")
  type                 PosCashMovementType
  sourceAccountId      String              @db.Uuid
  destinationAccountId String              @db.Uuid
  reasonCode           String
  notes                String?
  receiptReference     String?
  operationId          String              @unique
  businessDate         DateTime?           @db.Date
  authorizedBy         String?             @db.Uuid

  session            PosSession?       @relation(fields: [posSessionId], references: [id])
  frontdeskSession   FrontdeskSession? @relation(fields: [frontdeskSessionId], references: [id])
  sourceAccount      CashAccount       @relation("SourceAccount", fields: [sourceAccountId], references: [id])
  destinationAccount CashAccount       @relation("DestinationAccount", fields: [destinationAccountId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([frontdeskSessionId])
}

enum FrontdeskSessionStatus {
  OPEN
  CLOSING
  CLOSED
  UNDER_REVIEW
  RECONCILED
  REOPEN_REQUESTED
}

model FrontdeskSession {
  id                     String                 @id @default(uuid()) @db.Uuid
  propertyId             String                 @db.Uuid
  property               Property               @relation(fields: [propertyId], references: [id])
  staffId                String                 @db.Uuid
  staff                  Staff                  @relation(fields: [staffId], references: [id])
  cashAccountId          String                 @db.Uuid
  cashAccount            CashAccount            @relation(fields: [cashAccountId], references: [id])
  shiftReference         String                 @unique
  businessDate           DateTime               @db.Date
  status                 FrontdeskSessionStatus @default(OPEN)
  openingFloat           Decimal                @default(0) @db.Decimal(18, 4)
  systemExpectedCash     Decimal                @default(0) @db.Decimal(18, 4)
  declaredCash           Decimal?               @db.Decimal(18, 4)
  variance               Decimal?               @db.Decimal(18, 4)
  openedAt               DateTime               @default(now()) @db.Timestamptz
  closingAt              DateTime?              @db.Timestamptz
  closedAt               DateTime?              @db.Timestamptz
  reconciledAt           DateTime?              @db.Timestamptz
  reconciledBy           String?                @db.Uuid
  reconciliationDecision String?
  reconciliationNotes    String?

  payments      Payment[]
  cashMovements PosCashMovement[]
  audits        FrontdeskSessionAudit[]
  exceptions    ReconciliationException[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([propertyId, businessDate])
  @@index([staffId, status])
  @@index([cashAccountId, status])
}

model FrontdeskSessionAudit {
  id                 String           @id @default(uuid()) @db.Uuid
  frontdeskSessionId String           @db.Uuid
  frontdeskSession   FrontdeskSession @relation(fields: [frontdeskSessionId], references: [id])
  action             String
  performedBy        String           @db.Uuid
  performer          Staff            @relation(fields: [performedBy], references: [id])
  notes              String?
  metadata           Json?
  createdAt          DateTime         @default(now()) @db.Timestamptz

  @@index([frontdeskSessionId, createdAt])
}

model ReconciliationException {
  id                 String           @id @default(uuid()) @db.Uuid
  propertyId         String           @db.Uuid
  property           Property         @relation(fields: [propertyId], references: [id])
  frontdeskSessionId String           @db.Uuid
  frontdeskSession   FrontdeskSession @relation(fields: [frontdeskSessionId], references: [id])
  type               String
  severity           String
  amount             Decimal?         @db.Decimal(18, 4)
  source             String
  reason             String
  status             String           @default("OPEN")
  resolvedBy         String?          @db.Uuid
  resolvedAt         DateTime?        @db.Timestamptz
  createdAt          DateTime         @default(now()) @db.Timestamptz

  @@index([propertyId, status])
  @@index([frontdeskSessionId, status])
}

model PosSettlement {
  id             String    @id @default(uuid()) @db.Uuid
  sessionId      String    @db.Uuid
  propertyId     String    @db.Uuid
  outletId       String    @db.Uuid
  deviceId       String
  sessionOwnerId String    @db.Uuid
  operatorId     String    @db.Uuid
  businessDate   DateTime? @db.Date
  expectedCash   Decimal   @db.Decimal(18, 4)
  actualCash     Decimal   @db.Decimal(18, 4)
  variance       Decimal   @db.Decimal(18, 4)
  authorizerId   String?   @db.Uuid
  settledAt      DateTime  @db.Timestamptz
  status         String    @default("SETTLED")
  operationId    String    @unique

  session PosSession @relation(fields: [sessionId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
}

enum PosReceiptType {
  SALE_RECEIPT
  REFUND_RECEIPT
  VOID_RECEIPT
  REPRINT
  DUPLICATE_COPY
}

model PosReceiptAudit {
  id           String         @id @default(uuid()) @db.Uuid
  propertyId   String         @db.Uuid
  orderId      String?        @db.Uuid
  deviceId     String
  posSessionId String?        @db.Uuid
  userId       String         @db.Uuid
  type         PosReceiptType
  reason       String?
  printCount   Int            @default(1)
  operationId  String         @unique
  businessDate DateTime       @db.Date

  session PosSession? @relation(fields: [posSessionId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
}

model PosAuthorizationAudit {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @db.Uuid
  deviceId     String
  sessionId    String?  @db.Uuid
  requestedBy  String   @db.Uuid
  authorizedBy String   @db.Uuid
  action       String
  reason       String?
  operationId  String   @unique
  businessDate DateTime @db.Date

  session PosSession? @relation(fields: [sessionId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
}

enum PosOrderStatus {
  SUBMITTED
  IN_SERVICE
  CLOSED
  VOIDED
}

enum ProductionStation {
  KITCHEN
  BAR
  DIRECT
  NONE
}

enum PosProductionBatchStatus {
  PENDING
  ACKNOWLEDGED
  PREPARING
  READY
  COMPLETED
}

enum PosOrderPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PosOrderType {
  TABLE
  WALK_IN
  ROOM_SERVICE
  TAKEAWAY
  BAR
}

model PosOrder {
  id         String      @id @default(uuid()) @db.Uuid
  version    Int         @default(1)
  propertyId String      @db.Uuid
  property   Property    @relation(fields: [propertyId], references: [id])
  outletId   String      @db.Uuid
  outlet     PosOutlet   @relation(fields: [outletId], references: [id])
  sessionId  String?     @db.Uuid
  session    PosSession? @relation(fields: [sessionId], references: [id])
  folioId    String?     @db.Uuid
  folio      Folio?      @relation(fields: [folioId], references: [id])

  serverStaffId String? @db.Uuid
  serverStaff   Staff?  @relation(fields: [serverStaffId], references: [id])

  orderNumber   String                @unique
  orderType     PosOrderType          @default(TABLE)
  status        PosOrderStatus        @default(SUBMITTED)
  paymentStatus PosOrderPaymentStatus @default(UNPAID)
  businessDate  DateTime              @db.Date

  subtotal  Decimal @default(0) @db.Decimal(18, 4)
  taxAmount Decimal @default(0) @db.Decimal(18, 4)
  discount  Decimal @default(0) @db.Decimal(18, 4)
  total     Decimal @default(0) @db.Decimal(18, 4)

  notes         String?
  displayName   String?
  tableNumber   String?
  tableId       String?   @db.Uuid
  table         PosTable? @relation(fields: [tableId], references: [id])
  roomId        String?   @db.Uuid
  reservationId String?   @db.Uuid

  guestCount    Int     @default(1)
  serviceCharge Decimal @default(0) @db.Decimal(18, 4)
  tipAmount     Decimal @default(0) @db.Decimal(18, 4)

  operationId String?   @unique
  deviceId    String?
  closedAt    DateTime? @db.Timestamptz

  items             PosOrderItem[]
  payments          PosPayment[]
  voids             PosVoid[]
  discounts         PosDiscount[]
  checks            PosCheck[]
  kots              PosKot[]
  productionBatches PosProductionBatch[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

model PosOrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  order       PosOrder @relation(fields: [orderId], references: [id])
  productId   String?  @db.Uuid
  productName String

  quantity  Decimal @db.Decimal(18, 4)
  unitPrice Decimal @db.Decimal(18, 4)

  subtotal  Decimal @db.Decimal(18, 4)
  discount  Decimal @default(0) @db.Decimal(18, 4)
  taxRate   Decimal @default(0) @db.Decimal(5, 2)
  taxAmount Decimal @default(0) @db.Decimal(18, 4)
  total     Decimal @db.Decimal(18, 4)

  notes           String?
  course          Int?
  kitchenStatus   String?
  sentToKitchenAt DateTime? @db.Timestamptz
  voidReason      String?

  checkId String?   @db.Uuid
  check   PosCheck? @relation(fields: [checkId], references: [id])
  kotId   String?   @db.Uuid
  kot     PosKot?   @relation(fields: [kotId], references: [id])

  modifiers            PosOrderItemModifier[]
  productionBatchItems PosProductionBatchItem[]

  createdAt DateTime @default(now()) @db.Timestamptz
}

model PosOrderItemModifier {
  id          String       @id @default(uuid()) @db.Uuid
  orderItemId String       @db.Uuid
  orderItem   PosOrderItem @relation(fields: [orderItemId], references: [id])

  name  String
  price Decimal @default(0) @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @db.Timestamptz
}

model PosCheck {
  id      String   @id @default(uuid()) @db.Uuid
  version Int      @default(1)
  orderId String   @db.Uuid
  order   PosOrder @relation(fields: [orderId], references: [id])

  checkNumber  String
  total        Decimal  @default(0) @db.Decimal(18, 4)
  status       String   @default("OPEN")
  operationId  String?  @unique
  businessDate DateTime @db.Date

  items PosOrderItem[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model PosKot {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  order     PosOrder @relation(fields: [orderId], references: [id])
  outletId  String   @db.Uuid
  deviceId  String
  createdBy String   @db.Uuid

  kotNumber    String
  status       String   @default("PENDING")
  printStatus  String   @default("QUEUED")
  operationId  String?  @unique
  businessDate DateTime @db.Date
  printerId    String?
  attemptCount Int      @default(0)

  printedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  items PosOrderItem[]
}

enum PosPaymentStatus {
  PENDING
  AUTHORIZED
  CONFIRMED
  PAID
  FAILED
  REFUNDED
  VOIDED
  REQUIRES_REVIEW
  PENDING_GATEWAY
  REFUND_PENDING
  REFUND_COMPLETED
}

model PosPayment {
  id      String   @id @default(uuid()) @db.Uuid
  orderId String   @db.Uuid
  order   PosOrder @relation(fields: [orderId], references: [id])

  method   PaymentMethod
  status   PosPaymentStatus @default(PENDING)
  amount   Decimal          @db.Decimal(18, 4)
  currency String           @default("NGN")

  sessionId String?     @db.Uuid
  session   PosSession? @relation(fields: [sessionId], references: [id])

  processedById String? @db.Uuid
  processedBy   Staff?  @relation("PaymentProcessedBy", fields: [processedById], references: [id])

  reference            String?
  gateway              String?
  gatewayTransactionId String?

  operationId  String?  @unique
  businessDate DateTime @db.Date
  deviceId     String?

  paidAt DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model PosVoid {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  order       PosOrder @relation(fields: [orderId], references: [id])
  orderItemId String?  @db.Uuid

  reason       String
  authorizerId String? @db.Uuid

  operationId  String?  @unique
  businessDate DateTime @db.Date
  deviceId     String?

  createdAt DateTime @default(now()) @db.Timestamptz
}

model PosDiscount {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  order       PosOrder @relation(fields: [orderId], references: [id])
  orderItemId String?  @db.Uuid

  type         String // 'PERCENTAGE' | 'FLAT'
  amount       Decimal @db.Decimal(18, 4)
  authorizerId String? @db.Uuid

  operationId  String?  @unique
  businessDate DateTime @db.Date
  deviceId     String?

  createdAt DateTime @default(now()) @db.Timestamptz
}

// -----------------------------------------------------------------------------
// POS PRODUCTION BATCHES (Service-first waiter flow)
// -----------------------------------------------------------------------------

model PosProductionBatch {
  id             String                   @id @default(uuid()) @db.Uuid
  orderId        String                   @db.Uuid
  order          PosOrder                 @relation(fields: [orderId], references: [id])
  batchNumber    Int
  station        ProductionStation
  status         PosProductionBatchStatus @default(PENDING)
  firedAt        DateTime                 @default(now()) @db.Timestamptz
  firedByStaffId String?                  @db.Uuid
  firedByStaff   Staff?                   @relation(fields: [firedByStaffId], references: [id])
  items          PosProductionBatchItem[]
  createdAt      DateTime                 @default(now()) @db.Timestamptz
}

model PosProductionBatchItem {
  id          String             @id @default(uuid()) @db.Uuid
  batchId     String             @db.Uuid
  batch       PosProductionBatch @relation(fields: [batchId], references: [id])
  orderItemId String             @db.Uuid
  orderItem   PosOrderItem       @relation(fields: [orderItemId], references: [id])
  productName String
  quantity    Decimal            @db.Decimal(18, 4)
  modifiers   Json?
  course      Int?
  createdAt   DateTime           @default(now()) @db.Timestamptz
}

// -----------------------------------------------------------------------------
// POS TERMINALS & SESSIONS
// -----------------------------------------------------------------------------

enum PosTerminalType {
  RESTAURANT_POS
  BAR_POS
  FRONT_DESK
  KITCHEN_DISPLAY
  BACK_OFFICE
}

enum PosRegistrationState {
  UNREGISTERED
  PROVISIONING
  REGISTERED
  REVOKED
}

enum PosLicenseState {
  VALID
  EXPIRED
  RESTRICTED
}

model PosTerminal {
  id                   String               @id @default(uuid()) @db.Uuid
  terminalCode         String               @unique
  name                 String
  terminalType         PosTerminalType
  organisationId       String               @db.Uuid
  propertyId           String               @db.Uuid
  outletId             String               @db.Uuid
  outlet               PosOutlet            @relation(fields: [outletId], references: [id])
  deviceCredentialHash String
  registrationState    PosRegistrationState @default(REGISTERED)
  licenseState         PosLicenseState      @default(VALID)
  licenseExpiresAt     DateTime?
  autoLockSeconds      Int?
  lastSyncAt           DateTime?
  lastSeenAt           DateTime?
  registeredAt         DateTime             @default(now())
  revokedAt            DateTime?

  configurationVersion Int @default(0)
  staffVersion         Int @default(0)
  menuVersion          Int @default(0)

  operatorSessions PosOperatorSession[]

  @@map("pos_terminals")
}

enum PosOperatorSessionStatus {
  ACTIVE
  LOCKED
  ENDED
}

model PosOperatorSession {
  id                   String                   @id @default(uuid()) @db.Uuid
  version              Int                      @default(1)
  terminalId           String                   @db.Uuid
  terminal             PosTerminal              @relation(fields: [terminalId], references: [id])
  outletId             String                   @db.Uuid
  operatorId           String                   @db.Uuid
  operator             Staff                    @relation(fields: [operatorId], references: [id])
  startedAt            DateTime                 @default(now())
  lastActivityAt       DateTime                 @default(now())
  lockedAt             DateTime?
  endedAt              DateTime?
  status               PosOperatorSessionStatus @default(ACTIVE)
  authenticationMethod String                   @default("PIN")
  deviceSessionId      String?

  @@map("pos_operator_sessions")
}

model PosProcessedEvent {
  eventId    String   @id // The OperationId from local SQLite
  terminalId String   @db.Uuid
  outletId   String   @db.Uuid
  sessionId  String?  @db.Uuid
  operatorId String?  @db.Uuid
  entityType String
  entityId   String
  operation  String
  payload    Json
  createdAt  DateTime @default(now())

  @@index([terminalId])
  @@map("pos_processed_events")
}

// -----------------------------------------------------------------------------
// APPROVALS
// -----------------------------------------------------------------------------

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model ApprovalRequest {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  outletId   String?  @db.Uuid

  type   String // 'REFUND', 'VOID', 'DISCOUNT', 'INVENTORY_ADJUSTMENT'
  status ApprovalRequestStatus @default(PENDING)

  requestedBy String   @db.Uuid // Staff ID
  requestedAt DateTime @default(now()) @db.Timestamptz

  reviewedBy String?   @db.Uuid // Staff ID
  reviewedAt DateTime? @db.Timestamptz

  amount   Decimal? @db.Decimal(18, 4)
  currency String?

  reason         String
  details        Json? // Detailed payload/snapshot of the request
  idempotencyKey String? @unique

  expiresAt DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  mutations ApprovalMutation[]
}

model ApprovalMutation {
  id             String          @id @default(uuid()) @db.Uuid
  idempotencyKey String          @unique
  userId         String          @db.Uuid
  approvalId     String          @db.Uuid
  approval       ApprovalRequest @relation(fields: [approvalId], references: [id])

  action          String
  requestHash     String
  status          String
  responsePayload Json?

  createdAt   DateTime  @default(now()) @db.Timestamptz
  completedAt DateTime? @db.Timestamptz

  @@index([idempotencyKey])
}

// -----------------------------------------------------------------------------
// LAUNDRY MANAGEMENT
// -----------------------------------------------------------------------------

enum LaundryOrderStatus {
  PENDING
  COLLECTED
  WASHING
  READY
  DELIVERED
  CANCELLED
}

enum LaundryServiceType {
  STANDARD
  EXPRESS
  SAME_DAY
  DRY_CLEAN
  IRON_ONLY
  WASH_AND_FOLD
}

model LaundryItem {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])

  name        String
  category    String?
  description String?
  basePrice   Decimal @db.Decimal(18, 4)
  currency    String  @default("NGN")
  isActive    Boolean @default(true)

  servicePricingRules Json?

  orderItems LaundryOrderItem[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

enum LaundryCustomerType {
  IN_HOUSE
  WALK_IN
}

model LaundryOrder {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])

  customerType LaundryCustomerType @default(IN_HOUSE)

  reservationId String?      @db.Uuid
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  roomId  String? @db.Uuid
  room    Room?   @relation(fields: [roomId], references: [id])
  guestId String? @db.Uuid
  guest   Guest?  @relation(fields: [guestId], references: [id])

  folioItemId String? @unique @db.Uuid

  status      LaundryOrderStatus @default(PENDING)
  serviceType LaundryServiceType @default(STANDARD)

  totalAmount Decimal @db.Decimal(18, 4)
  currency    String  @default("NGN")

  specialNotes String?

  requestedAt     DateTime  @default(now()) @db.Timestamptz
  expectedReadyAt DateTime? @db.Timestamptz
  collectedAt     DateTime? @db.Timestamptz
  collectedBy     String?   @db.Uuid
  readyAt         DateTime? @db.Timestamptz
  deliveredAt     DateTime? @db.Timestamptz
  deliveredBy     String?   @db.Uuid

  version Int @default(1)

  items         LaundryOrderItem[]
  statusHistory LaundryOrderStatusHistory[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model LaundryOrderItem {
  id             String       @id @default(uuid()) @db.Uuid
  laundryOrderId String       @db.Uuid
  order          LaundryOrder @relation(fields: [laundryOrderId], references: [id], onDelete: Cascade)

  itemId String      @db.Uuid
  item   LaundryItem @relation(fields: [itemId], references: [id])

  quantity Int

  unitPrice  Decimal @db.Decimal(18, 4)
  totalPrice Decimal @db.Decimal(18, 4)
}

model LaundryOrderStatusHistory {
  id             String       @id @default(uuid()) @db.Uuid
  laundryOrderId String       @db.Uuid
  order          LaundryOrder @relation(fields: [laundryOrderId], references: [id], onDelete: Cascade)

  previousStatus LaundryOrderStatus?
  newStatus      LaundryOrderStatus

  changedBy String?  @db.Uuid
  changedAt DateTime @default(now()) @db.Timestamptz
  notes     String?
  deviceId  String?
}

enum StockTransferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  CANCELLED
}

model StockTransfer {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])

  fromWarehouseId String    @db.Uuid
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])

  toWarehouseId String    @db.Uuid
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])

  transferRef String              @unique
  status      StockTransferStatus @default(DRAFT)
  notes       String?

  items        StockTransferItem[]
  transactions StockTransaction[]

  requestedBy String?   @db.Uuid
  approvedBy  String?   @db.Uuid
  postedBy    String?   @db.Uuid
  approvedAt  DateTime? @db.Timestamptz
  postedAt    DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz
}

model StockTransferItem {
  id          String        @id @default(uuid()) @db.Uuid
  transferId  String        @db.Uuid
  transfer    StockTransfer @relation(fields: [transferId], references: [id])
  stockItemId String        @db.Uuid
  stockItem   StockItem     @relation(fields: [stockItemId], references: [id])

  quantity      Decimal       @db.Decimal(18, 4)
  unitOfMeasure UnitOfMeasure
  notes         String?
}
