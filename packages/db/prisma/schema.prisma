  state        String
  country      String
  phone        String
  email        String
  website      String?
  starRating   Int?
  checkInTime  String  @default("14:00")
  checkOutTime String  @default("12:00")

  baseCurrency        String   @default("NGN")
  supportedCurrencies String[]

  businessDate DateTime? @db.Date
  lastAuditAt  DateTime? @db.Timestamptz
  auditStatus  String? // 'OPEN' | 'IN_PROGRESS' | 'POSTING' | 'COMPLETED' | 'COMPLETED_WITH_EXCEPTIONS' | 'FAILED'

  isActive         Boolean   @default(true)
  suspendedAt      DateTime? @db.Timestamptz
  suspensionReason String?

  timezone          String @default("Africa/Lagos")
  locale            String @default("en-NG")
  settings          Json?
  lockConfiguration Json? // { provider: "DELUNS", dlsCoID: 12345, encoderPort: 1 }

  cashVarianceGeneralCashierLimit   Decimal?                                   @db.Decimal(18, 4)
  cashVarianceFinanceManagerLimit   Decimal?                                   @db.Decimal(18, 4)
  cashVarianceNightAuditTolerance   Decimal?                                   @db.Decimal(18, 4)
  // Folio balances above this threshold are flagged as warnings during Night Audit.
  // Default: 50,000 (property currency units). Replaces the former hardcoded 5,000 dummy check.
  nightAuditHighBalanceThreshold    Decimal                                    @default(1000000) @db.Decimal(18, 4)
  // When true, all Night Audit warnings must be explicitly acknowledged (via
  // NightAuditAcknowledgement tied to the specific run ID) before /execute proceeds.
  requireAuditAcknowledgements      Boolean                                    @default(false)
  // HR-controlled switch for employee claims requesting bank transfer.
  // Disabled means the General Cashier completes the bank transfer manually.
  autoBankReimbursementEnabled      Boolean                                    @default(false)
