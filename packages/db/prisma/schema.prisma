  staff   Staff?  @relation("ComplimentaryBeneficiary", fields: [staffId], references: [id])
  acknowledgedByStaffId String? @db.Uuid
  acknowledgedBy        Staff?  @relation("ComplimentaryAcknowledgement", fields: [acknowledgedByStaffId], references: [id])
  acknowledgedAt        DateTime? @db.Timestamptz

  grossAmount    Decimal @db.Decimal(18, 4)
  discountAmount Decimal @default(0) @db.Decimal(18, 4)
  complAmount    Decimal @db.Decimal(18, 4)
  netAmount      Decimal @db.Decimal(18, 4)
  amountPaid     Decimal @default(0) @db.Decimal(18, 4)
  staffLiability Decimal @default(0) @db.Decimal(18, 4)

