model PosOrder {
  id         String      @id @default(uuid()) @db.Uuid
  version    Int         @default(1)
  propertyId String      @db.Uuid
  property   Property    @relation(fields: [propertyId], references: [id])
  outletId   String      @db.Uuid
  outlet     PosOutlet   @relation(fields: [outletId], references: [id])
  sessionId  String?     @db.Uuid
  session    PosSession? @relation(fields: [sessionId], references: [id])
  folioId    String?     @db.Uuid
  folio      Folio?      @relation(fields: [folioId], references: [id])

  serverStaffId String? @db.Uuid
  serverStaff   Staff?  @relation(fields: [serverStaffId], references: [id])

  orderNumber   String                @unique
  orderType     PosOrderType          @default(TABLE)
  status        PosOrderStatus        @default(SUBMITTED)
  paymentStatus PosOrderPaymentStatus @default(UNPAID)
  businessDate  DateTime              @db.Date

  subtotal  Decimal @default(0) @db.Decimal(18, 4)
  taxAmount Decimal @default(0) @db.Decimal(18, 4)
  discount  Decimal @default(0) @db.Decimal(18, 4)
  total     Decimal @default(0) @db.Decimal(18, 4)

  notes         String?
  displayName   String?
  tableNumber   String?
  tableId       String?   @db.Uuid
  table         PosTable? @relation(fields: [tableId], references: [id])
  roomId        String?   @db.Uuid
  reservationId String?   @db.Uuid

  guestCount    Int     @default(1)
  serviceCharge Decimal @default(0) @db.Decimal(18, 4)
  tipAmount     Decimal @default(0) @db.Decimal(18, 4)

  operationId String?   @unique
  deviceId    String?
  closedAt    DateTime? @db.Timestamptz

  items                PosOrderItem[]
  payments             PosPayment[]
  voids                PosVoid[]
  discounts            PosDiscount[]
  checks               PosCheck[]
  kots                 PosKot[]
  productionBatches    PosProductionBatch[]
  breakfastRedemptions BreakfastRedemption[]
  poolEntries          PoolEntry[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

model PosOrderItem {
  id          String      @id @default(uuid()) @db.Uuid
  orderId     String      @db.Uuid
  order       PosOrder    @relation(fields: [orderId], references: [id])
  productId   String?     @db.Uuid
  product     PosProduct? @relation(fields: [productId], references: [id])
  productName String

  quantity  Decimal @db.Decimal(18, 4)
  unitPrice Decimal @db.Decimal(18, 4)

  subtotal  Decimal @db.Decimal(18, 4)
  discount  Decimal @default(0) @db.Decimal(18, 4)
  taxRate   Decimal @default(0) @db.Decimal(5, 2)
  taxAmount Decimal @default(0) @db.Decimal(18, 4)
  total     Decimal @db.Decimal(18, 4)

  notes           String?
  course          Int?
  kitchenStatus   String?
  sentToKitchenAt DateTime? @db.Timestamptz
  voidReason      String?

  checkId String?   @db.Uuid
  check   PosCheck? @relation(fields: [checkId], references: [id])
  kotId   String?   @db.Uuid
  kot     PosKot?   @relation(fields: [kotId], references: [id])

  modifiers            PosOrderItemModifier[]
  productionBatchItems PosProductionBatchItem[]

  createdAt DateTime @default(now()) @db.Timestamptz
}

model PosOrderItemModifier {
  id          String       @id @default(uuid()) @db.Uuid
  orderItemId String       @db.Uuid
  orderItem   PosOrderItem @relation(fields: [orderItemId], references: [id])

  name          String
  price         Decimal        @default(0) @db.Decimal(18, 4)
  stockItemId   String?        @db.Uuid
  quantity      Decimal        @default(0) @db.Decimal(18, 4)
  unitOfMeasure UnitOfMeasure?

  createdAt DateTime @default(now()) @db.Timestamptz
}

model PosCheck {
  id      String   @id @default(uuid()) @db.Uuid
  version Int      @default(1)
  orderId String   @db.Uuid
  order   PosOrder @relation(fields: [orderId], references: [id])

  checkNumber  String
  total        Decimal  @default(0) @db.Decimal(18, 4)
  status       String   @default("OPEN")
  operationId  String?  @unique
  businessDate DateTime @db.Date

  items PosOrderItem[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model PosKot {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  order     PosOrder @relation(fields: [orderId], references: [id])
  outletId  String   @db.Uuid
  deviceId  String
  createdBy String   @db.Uuid

  kotNumber    String
  status       String   @default("PENDING")
  printStatus  String   @default("QUEUED")
  operationId  String?  @unique
  businessDate DateTime @db.Date
  printerId    String?
  attemptCount Int      @default(0)

  printedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  items PosOrderItem[]
}

enum PosPaymentStatus {
  PENDING
  AUTHORIZED
  CONFIRMED
  PAID
  FAILED
  REFUNDED
  VOIDED
  REQUIRES_REVIEW
  PENDING_GATEWAY
  REFUND_PENDING
  REFUND_COMPLETED
}

model PosPayment {
  id      String   @id @default(uuid()) @db.Uuid
  orderId String   @db.Uuid
  order   PosOrder @relation(fields: [orderId], references: [id])

  method   PaymentMethod
  status   PosPaymentStatus @default(PENDING)
  amount   Decimal          @db.Decimal(18, 4)
  currency String           @default("NGN")

  sessionId String?     @db.Uuid
  session   PosSession? @relation(fields: [sessionId], references: [id])

  processedById String? @db.Uuid
  processedBy   Staff?  @relation("PaymentProcessedBy", fields: [processedById], references: [id])

  reference            String?
  gateway              String?
  gatewayTransactionId String?

  operationId  String?  @unique
  businessDate DateTime @db.Date
  deviceId     String?

  paidAt DateTime? @db.Timestamptz

  // Transaction Verification
  verificationStatus    TransactionVerificationStatus @default(UNVERIFIED)
  verifiedAt            DateTime?                     @db.Timestamptz
  verifiedById          String?                       @db.Uuid
  verificationNotes     String?
  transactionExceptions TransactionException[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model PosVoid {
  id               String   @id @default(uuid()) @db.Uuid
  orderId          String   @db.Uuid
  order            PosOrder @relation(fields: [orderId], references: [id])
  orderItemId      String?  @db.Uuid
  replacedByItemId String?  @db.Uuid

  reason       String
  authorizerId String? @db.Uuid

  operationId  String?  @unique
  businessDate DateTime @db.Date
  deviceId     String?

  createdAt DateTime @default(now()) @db.Timestamptz
}

model PosDiscount {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  order       PosOrder @relation(fields: [orderId], references: [id])
  orderItemId String?  @db.Uuid

  type         String // 'PERCENTAGE' | 'FLAT'
  amount       Decimal @db.Decimal(18, 4)
  authorizerId String? @db.Uuid

  operationId  String?  @unique
  businessDate DateTime @db.Date
  deviceId     String?

