}

// -----------------------------------------------------------------------------
// POS PRODUCTION BATCHES (Service-first waiter flow)
// -----------------------------------------------------------------------------

model PosProductionBatch {
  id             String                    @id @default(uuid()) @db.Uuid
  orderId        String                    @db.Uuid
  order          PosOrder                  @relation(fields: [orderId], references: [id])
  batchNumber    Int
  station        ProductionStation
  status         PosProductionBatchStatus  @default(PENDING)
  firedAt        DateTime                  @default(now()) @db.Timestamptz
  firedByStaffId String?                   @db.Uuid
  firedByStaff   Staff?                    @relation(fields: [firedByStaffId], references: [id])
  items          PosProductionBatchItem[]
  events         PosProductionBatchEvent[]
  createdAt      DateTime                  @default(now()) @db.Timestamptz

  // Populated only for room-service acknowledgement KOTs. Normal POS orders
  // may legitimately have multiple batches for the same order and station.
  roomServiceOperationId String? @unique
}

model PosProductionBatchEvent {
  id         String                   @id @default(uuid()) @db.Uuid
  batchId    String                   @db.Uuid
  batch      PosProductionBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  fromStatus PosProductionBatchStatus
  toStatus   PosProductionBatchStatus
  actorId    String?                  @db.Uuid
  notes      String?
  createdAt  DateTime                 @default(now()) @db.Timestamptz

  @@index([batchId, createdAt])
}

model PosProductionBatchItem {
  id          String             @id @default(uuid()) @db.Uuid
  batchId     String             @db.Uuid
  batch       PosProductionBatch @relation(fields: [batchId], references: [id])
  orderItemId String             @db.Uuid
  orderItem   PosOrderItem       @relation(fields: [orderItemId], references: [id])
  productName String
  quantity    Decimal            @db.Decimal(18, 4)
  modifiers   Json?
  course      Int?
  createdAt   DateTime           @default(now()) @db.Timestamptz
}

