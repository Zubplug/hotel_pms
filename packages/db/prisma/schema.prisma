model WebsiteRevision {
  id        String         @id @default(uuid()) @db.Uuid
  projectId String         @db.Uuid
  project   WebsiteProject @relation("ProjectRevisions", fields: [projectId], references: [id], onDelete: Cascade)

  status      String @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  versionName String // e.g. "Summer 2026 Update"

  publishedAt DateTime? @db.Timestamptz
  createdBy   String    @db.Uuid

  pages WebsitePage[]

  activeFor  WebsiteProject[] @relation("ActiveRevision")
  previewFor WebsiteProject[] @relation("PreviewRevision")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([projectId, status])
}

model WebsitePage {
  id         String          @id @default(uuid()) @db.Uuid
  revisionId String          @db.Uuid
  revision   WebsiteRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  slug           String // e.g. "/", "/about", "/rooms"
  title          String
  seoTitle       String?
  seoDescription String?

  status String @default("PUBLISHED") // PUBLISHED, DRAFT

  sections WebsiteSection[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([revisionId, slug])
}

model WebsiteSection {
  id     String      @id @default(uuid()) @db.Uuid
  pageId String      @db.Uuid
  page   WebsitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  type      String // HERO, GALLERY, TEXT_IMAGE, ROOM_LIST, AMENITIES, CONTACT, HTML
  sortOrder Int    @default(0)

  content Json // Zod validated content payload

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([pageId, sortOrder])
}

model WebsiteAsset {
  id        String         @id @default(uuid()) @db.Uuid
  projectId String         @db.Uuid
  project   WebsiteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  url      String
  type     String // IMAGE, VIDEO, DOCUMENT
  altText  String?
  fileSize Int?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([projectId])
}

model PortalApiKey {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  prefix         String       @unique
  secretHash     String
  lastUsedAt     DateTime?    @db.Timestamptz
  expiresAt      DateTime?    @db.Timestamptz
  revokedAt      DateTime?    @db.Timestamptz
  createdAt      DateTime     @default(now()) @db.Timestamptz
  updatedAt      DateTime     @updatedAt @db.Timestamptz

  @@index([organizationId, revokedAt])
}

// Dedicated server-to-server corporate API identity. This is intentionally
// separate from property-local CorporateAccount and public PublishableKey.
model ApiPartner {
  id                    String       @id @default(uuid()) @db.Uuid
  organizationId        String       @db.Uuid
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  status                String       @default("ACTIVE") // ACTIVE, SUSPENDED, REVOKED
  environment           String       @default("LIVE") // TEST, LIVE
  scopes                String[]     @default([])
  rateLimitPerMinute    Int          @default(60)
  requestSizeLimitBytes Int          @default(1048576)
  expiresAt             DateTime?    @db.Timestamptz

  credentials       ApiCredential[]
  properties        ApiPartnerProperty[]
  corporateAccounts ApiPartnerCorporateAccount[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([organizationId, status])
  @@index([organizationId, environment, status])
}

/// Explicit authorization from an API partner to a PMS corporate account.
