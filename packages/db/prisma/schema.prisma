model ReferralPartner {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String?   @db.Uuid
  staffId            String?   @unique @db.Uuid
  isStaffReferrer    Boolean   @default(false)
  firstName          String?
  middleName         String?
  lastName           String?
  businessName       String?
  directorName       String?
  displayName        String
  email              String?
  phone              String?
  passwordHash       String?
  lastLoginAt        DateTime? @db.Timestamptz
  status             String    @default("PENDING") // PENDING | ACTIVE | SUSPENDED | CLOSED
  verificationStatus String    @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REJECTED
  payoutProfile      Json?
  termsAcceptedAt    DateTime? @db.Timestamptz
  createdAt          DateTime  @default(now()) @db.Timestamptz
  updatedAt          DateTime  @updatedAt @db.Timestamptz

  organization               Organization?                              @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  staff                      Staff?                                     @relation(fields: [staffId], references: [id], onDelete: SetNull)
  campaigns                  ReferralCampaign[]
  clicks                     ReferralClick[]
  attributions               ReferralAttribution[]
  bookings                   ReferralBooking[]
  commissions                ReferralCommission[]
  payouts                    ReferralPayout[]
  creativeGenerations        ReachCreativeGeneration[]
  ledgerEntries              ReferralLedgerEntry[]
  sessions                   ReferralPartnerSession[]
  wallet                     ReferralPartnerWallet?
  walletTransactions         ReferralPartnerWalletTransaction[]
  propertyWallets            ReferralPartnerPropertyWallet[]
  propertyWalletTransactions ReferralPartnerPropertyWalletTransaction[]

  @@index([email])
  @@index([status, verificationStatus])
}

model ReferralPartnerSession {
  id         String   @id @default(uuid()) @db.Uuid
  partnerId  String   @db.Uuid
  tokenHash  String   @unique
  expiresAt  DateTime @db.Timestamptz
  lastSeenAt DateTime @default(now()) @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz

  partner ReferralPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, expiresAt])
}

model ReferralCampaign {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  propertyId     String    @db.Uuid
  programId      String    @db.Uuid
  partnerId      String    @db.Uuid
  name           String
  code           String    @unique
  category       String    @default("STAY") // STAY | VENUE | EVENT | CORPORATE
  targetUrl      String?
  commissionBps  Int       @default(700)
  budget         Decimal?  @db.Decimal(18, 4)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property            Property                  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  program             ReferralProgram           @relation(fields: [programId], references: [id], onDelete: Cascade)
  partner             ReferralPartner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  clicks              ReferralClick[]
  attributions        ReferralAttribution[]
  bookings            ReferralBooking[]
  creativeAssets      ReachCreativeAsset[]
  creativeGenerations ReachCreativeGeneration[]

  @@index([propertyId, isActive])
  @@index([partnerId, isActive])
}

model ReferralClick {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  propertyId     String   @db.Uuid
  programId      String   @db.Uuid
  campaignId     String?  @db.Uuid
  partnerId      String   @db.Uuid
  referralToken  String   @unique
  visitorId      String?
  landingPath    String?
  occurredAt     DateTime @default(now()) @db.Timestamptz
  expiresAt      DateTime @db.Timestamptz
  metadata       Json?

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  program      ReferralProgram       @relation(fields: [programId], references: [id], onDelete: Cascade)
  campaign     ReferralCampaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  partner      ReferralPartner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  attributions ReferralAttribution[]

  @@index([propertyId, occurredAt])
  @@index([partnerId, occurredAt])
  @@index([campaignId, visitorId, occurredAt])
}

model ReferralAttribution {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  propertyId     String    @db.Uuid
  programId      String    @db.Uuid
  partnerId      String    @db.Uuid
  campaignId     String?   @db.Uuid
  clickId        String?   @db.Uuid
  referralCode   String?
  bookingId      String?
  status         String    @default("QUALIFIED") // QUALIFIED | CONVERTED | EXPIRED | REJECTED
  policyVersion  String    @default("LAST_ELIGIBLE_V1")
  qualifiedAt    DateTime  @default(now()) @db.Timestamptz
  expiresAt      DateTime  @db.Timestamptz
  convertedAt    DateTime? @db.Timestamptz
  metadata       Json?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  program      ReferralProgram   @relation(fields: [programId], references: [id], onDelete: Cascade)
  partner      ReferralPartner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  campaign     ReferralCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  click        ReferralClick?    @relation(fields: [clickId], references: [id], onDelete: SetNull)
  booking      ReferralBooking?

  @@unique([propertyId, bookingId])
  @@index([propertyId, status, expiresAt])
  @@index([partnerId, qualifiedAt])
}

model ReferralBooking {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  propertyId       String    @db.Uuid
  programId        String    @db.Uuid
  partnerId        String    @db.Uuid
  campaignId       String?   @db.Uuid
  attributionId    String    @unique @db.Uuid
  reservationId    String?   @unique @db.Uuid
  eventId          String?   @unique @db.Uuid
  roomTypeId       String?   @db.Uuid
  category         String    @default("STAY")
  status           String    @default("BOOKED") // BOOKED | FULFILLED | CANCELLED | REFUNDED | DISPUTED
  eligibleRevenue  Decimal   @default(0) @db.Decimal(18, 4)
  collectedRevenue Decimal   @default(0) @db.Decimal(18, 4)
  currency         String    @default("NGN")
  fulfilledAt      DateTime? @db.Timestamptz
  cancelledAt      DateTime? @db.Timestamptz
  createdAt        DateTime  @default(now()) @db.Timestamptz
  updatedAt        DateTime  @updatedAt @db.Timestamptz

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  program      ReferralProgram      @relation(fields: [programId], references: [id], onDelete: Cascade)
  partner      ReferralPartner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  campaign     ReferralCampaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  attribution  ReferralAttribution  @relation(fields: [attributionId], references: [id], onDelete: Restrict)
  reservation  Reservation?         @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  event        Event?               @relation(fields: [eventId], references: [id], onDelete: SetNull)
  roomType     RoomType?            @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  commission   ReferralCommission?
  platformFee  ReferralPlatformFee?

  @@index([propertyId, status, createdAt])
  @@index([partnerId, status])
}

model ReferralCommission {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @db.Uuid
  propertyId            String    @db.Uuid
  programId             String    @db.Uuid
  partnerId             String    @db.Uuid
  referralBookingId     String    @unique @db.Uuid
  status                String    @default("PENDING") // PENDING | APPROVED | PAYABLE | PROCESSING | PAID | ON_HOLD | REVERSED | FAILED
  basisAmount           Decimal   @db.Decimal(18, 4)
  rateBps               Int
  amount                Decimal   @db.Decimal(18, 4)
  reversedAmount        Decimal   @default(0) @db.Decimal(18, 4)
  accrualJournalEntryId String?   @db.Uuid
  currency              String    @default("NGN")
  earnedAt              DateTime? @db.Timestamptz
  approvedAt            DateTime? @db.Timestamptz
  paidAt                DateTime? @db.Timestamptz
  payslipId             String?   @db.Uuid
  payslipInjectedAt     DateTime? @db.Timestamptz
  createdAt             DateTime  @default(now()) @db.Timestamptz
  updatedAt             DateTime  @updatedAt @db.Timestamptz

  organization               Organization                               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property                   Property                                   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  program                    ReferralProgram                            @relation(fields: [programId], references: [id], onDelete: Cascade)
  partner                    ReferralPartner                            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  referralBooking            ReferralBooking                            @relation(fields: [referralBookingId], references: [id], onDelete: Restrict)
  payslip                    Payslip?                                   @relation(fields: [payslipId], references: [id], onDelete: SetNull)
  ledgerEntries              ReferralLedgerEntry[]
  payoutItems                ReferralPayoutItem[]
  walletTransactions         ReferralPartnerWalletTransaction[]
  propertyWalletTransactions ReferralPartnerPropertyWalletTransaction[]

  @@index([propertyId, status])
  @@index([partnerId, status])
  @@index([payslipId])
}

model ReferralLedgerEntry {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  partnerId      String?  @db.Uuid
  commissionId   String?  @db.Uuid
  payoutId       String?  @db.Uuid
  entryType      String // COMMISSION | REVERSAL | PAYOUT | ADJUSTMENT
  amount         Decimal  @db.Decimal(18, 4)
  currency       String   @default("NGN")
  idempotencyKey String   @unique
  metadata       Json?
  journalEntryId String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  partner      ReferralPartner?    @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  commission   ReferralCommission? @relation(fields: [commissionId], references: [id], onDelete: SetNull)
  payout       ReferralPayout?     @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([partnerId, createdAt])
  @@index([commissionId, createdAt])
}

model ReferralPayout {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @db.Uuid
  propertyId          String    @db.Uuid
  partnerId           String    @db.Uuid
  status              String    @default("PENDING") // PENDING | PROCESSING | PAID | FAILED
  amount              Decimal   @db.Decimal(18, 4)
  currency            String    @default("NGN")
  payoutReference     String?
  failureReason       String?
  settlementMethod    String?
  settlementAccountId String?   @db.Uuid
  journalEntryId      String?   @db.Uuid
  processedAt         DateTime? @db.Timestamptz
  createdAt           DateTime  @default(now()) @db.Timestamptz
  updatedAt           DateTime  @updatedAt @db.Timestamptz

  organization               Organization                               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  partner                    ReferralPartner                            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  commissions                ReferralPayoutItem[]
  ledgerEntries              ReferralLedgerEntry[]
  walletTransactions         ReferralPartnerWalletTransaction[]
  propertyWalletTransactions ReferralPartnerPropertyWalletTransaction[]

  @@index([partnerId, status, createdAt])
}

model ReferralPartnerWallet {
  id               String   @id @default(uuid()) @db.Uuid
  partnerId        String   @unique @db.Uuid
  currency         String   @default("NGN")
  availableBalance Decimal  @default(0) @db.Decimal(18, 4)
  status           String   @default("ACTIVE") // ACTIVE | SUSPENDED | CLOSED
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz

  partner      ReferralPartner                    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  transactions ReferralPartnerWalletTransaction[]

  @@index([status, updatedAt])
}

model ReferralPartnerWalletTransaction {
  id             String    @id @default(uuid()) @db.Uuid
  walletId       String    @db.Uuid
  partnerId      String    @db.Uuid
  commissionId   String?   @db.Uuid
  payoutId       String?   @db.Uuid
  type           String // COMMISSION_CREDIT | WITHDRAWAL_HOLD | WITHDRAWAL_RELEASE | ADJUSTMENT
  status         String    @default("COMPLETED") // PENDING | COMPLETED | REVERSED
  amount         Decimal   @db.Decimal(18, 4)
  balanceAfter   Decimal   @db.Decimal(18, 4)
  currency       String    @default("NGN")
  idempotencyKey String    @unique
  metadata       Json?
  createdAt      DateTime  @default(now()) @db.Timestamptz
  completedAt    DateTime? @db.Timestamptz

  wallet     ReferralPartnerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  partner    ReferralPartner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  commission ReferralCommission?   @relation(fields: [commissionId], references: [id], onDelete: SetNull)
  payout     ReferralPayout?       @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([partnerId, createdAt])
  @@index([walletId, createdAt])
  @@index([payoutId])
}

model ReferralPartnerPropertyWallet {
  id               String   @id @default(uuid()) @db.Uuid
  partnerId        String   @db.Uuid
  propertyId       String   @db.Uuid
  currency         String   @default("NGN")
  availableBalance Decimal  @default(0) @db.Decimal(18, 4)
  status           String   @default("ACTIVE") // ACTIVE | SUSPENDED | CLOSED
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz

  partner      ReferralPartner                            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  property     Property                                   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  transactions ReferralPartnerPropertyWalletTransaction[]

  @@unique([partnerId, propertyId])
  @@index([partnerId, status, updatedAt])
  @@index([propertyId, status])
}

model ReferralPartnerPropertyWalletTransaction {
  id             String    @id @default(uuid()) @db.Uuid
  walletId       String    @db.Uuid
  partnerId      String    @db.Uuid
  propertyId     String    @db.Uuid
  commissionId   String?   @db.Uuid
  payoutId       String?   @db.Uuid
  type           String // COMMISSION_CREDIT | COMMISSION_REVERSAL | WITHDRAWAL_HOLD | WITHDRAWAL_RELEASE | ADJUSTMENT
  status         String    @default("COMPLETED") // PENDING | COMPLETED | REVERSED
  amount         Decimal   @db.Decimal(18, 4)
  balanceAfter   Decimal   @db.Decimal(18, 4)
  currency       String    @default("NGN")
  idempotencyKey String    @unique
  metadata       Json?
  createdAt      DateTime  @default(now()) @db.Timestamptz
  completedAt    DateTime?

  wallet     ReferralPartnerPropertyWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  partner    ReferralPartner               @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  property   Property                      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  commission ReferralCommission?           @relation(fields: [commissionId], references: [id], onDelete: SetNull)
  payout     ReferralPayout?               @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([partnerId, createdAt])
  @@index([walletId, createdAt])
  @@index([propertyId, createdAt])
  @@index([commissionId])
  @@index([payoutId])
}

model ReferralPayoutItem {
  id           String             @id @default(uuid()) @db.Uuid
  payoutId     String             @db.Uuid
  commissionId String             @db.Uuid
  amount       Decimal            @db.Decimal(18, 4)
  payout       ReferralPayout     @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  commission   ReferralCommission @relation(fields: [commissionId], references: [id], onDelete: Restrict)

  @@unique([payoutId, commissionId])
}

model ReferralPlatformFee {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @db.Uuid
  propertyId          String   @db.Uuid
  programId           String   @db.Uuid
  referralBookingId   String   @unique @db.Uuid
  basisAmount         Decimal  @db.Decimal(18, 4)
  rateBps             Int
  amount              Decimal  @db.Decimal(18, 4)
  reversedAmount      Decimal  @default(0) @db.Decimal(18, 4)
  hqJournalEntryId    String?  @db.Uuid
  walletAppliedAmount Decimal  @default(0) @db.Decimal(18, 4)
  outstandingAmount   Decimal  @default(0) @db.Decimal(18, 4)
  currency            String   @default("NGN")
  status              String   @default("EARNED") // EARNED | INVOICED | REVERSED
  createdAt           DateTime @default(now()) @db.Timestamptz

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property        Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  program         ReferralProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  referralBooking ReferralBooking @relation(fields: [referralBookingId], references: [id], onDelete: Restrict)

  @@index([propertyId, status, createdAt])
}

model ReferralActivationPayment {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @db.Uuid
  propertyId            String    @db.Uuid
  programId             String    @db.Uuid
  amount                Decimal   @db.Decimal(18, 4)
  currency              String    @default("NGN")
  status                String    @default("PENDING") // PENDING | PAID | FAILED
  provider              String    @default("FLUTTERWAVE")
  providerReference     String    @unique
  providerTransactionId String?
  hqJournalEntryId      String?   @db.Uuid
  createdAt             DateTime  @default(now()) @db.Timestamptz
  paidAt                DateTime? @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  program      ReferralProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([propertyId, status])
}

/// Organization-level customer wallet used to settle HQ-owned Reach fees.
/// The balance is a customer liability; it is never a hotel-property asset.
model ReachWallet {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @db.Uuid
  currency       String   @default("NGN")
  balance        Decimal  @default(0) @db.Decimal(18, 4)
  status         String   @default("ACTIVE") // ACTIVE | LOCKED
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions ReachWalletTransaction[]

  @@index([organizationId, status])
}

model ReachWalletTransaction {
  id                    String    @id @default(uuid()) @db.Uuid
  walletId              String    @db.Uuid
  organizationId        String    @db.Uuid
  propertyId            String?   @db.Uuid
  referralPlatformFeeId String?   @db.Uuid
  hqJournalEntryId      String?   @db.Uuid
  type                  String // FUNDING | FEE_SETTLEMENT | REFUND | ADJUSTMENT
  status                String    @default("PENDING") // PENDING | COMPLETED | FAILED
  amount                Decimal   @db.Decimal(18, 4) // positive credit/debit magnitude
  balanceAfter          Decimal?  @db.Decimal(18, 4)
  currency              String    @default("NGN")
  provider              String?
  providerReference     String?
  idempotencyKey        String    @unique
  description           String?
  metadata              Json?
  createdAt             DateTime  @default(now()) @db.Timestamptz
  completedAt           DateTime? @db.Timestamptz

  wallet ReachWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([propertyId, createdAt])
  @@index([providerReference])
  @@index([referralPlatformFeeId])
}

model ReachPropertyDebt {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @db.Uuid
  propertyId          String    @unique @db.Uuid
  currency            String    @default("NGN")
  outstandingAmount   Decimal   @default(0) @db.Decimal(18, 4)
  suspensionThreshold Decimal   @default(50000) @db.Decimal(18, 4)
  status              String    @default("CURRENT") // CURRENT | OVERDUE | SUSPENDED | CLEARED
  suspendedAt         DateTime? @db.Timestamptz
  clearedAt           DateTime? @db.Timestamptz
  lastEvaluatedAt     DateTime?
  createdAt           DateTime  @default(now()) @db.Timestamptz
  updatedAt           DateTime  @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([organizationId, propertyId])
  @@index([organizationId, status])
  @@index([status, outstandingAmount])
}

/// LodgeCore-owned accounting profile. This is intentionally not scoped to a
/// customer organization or hotel property.
model HqChartOfAccount {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  type          String
  normalBalance String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  lines HqJournalEntryLine[]
}

model HqJournalEntry {
  id          String   @id @default(uuid()) @db.Uuid
  entryNumber String   @unique
  entryDate   DateTime @db.Date
  description String
  reference   String?
  source      String   @default("REACH")
  status      String   @default("POSTED")
  totalDebit  Decimal  @default(0) @db.Decimal(18, 4)
  totalCredit Decimal  @default(0) @db.Decimal(18, 4)
  createdBy   String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz

  lines HqJournalEntryLine[]
}

model HqJournalEntryLine {
  id          String  @id @default(uuid()) @db.Uuid
  entryId     String  @db.Uuid
  accountId   String  @db.Uuid
  debit       Decimal @default(0) @db.Decimal(18, 4)
  credit      Decimal @default(0) @db.Decimal(18, 4)
  description String?
  sourceType  String?
  sourceId    String?

  entry   HqJournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account HqChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([sourceType, sourceId, accountId])
  @@index([entryId])
  @@index([accountId])
}

model BreakfastRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  propertyId     String   @db.Uuid
  reservationId  String   @db.Uuid
  roomNumber     String
  businessDate   DateTime @db.Date
  coversRedeemed Int      @default(1)
  posOrderId     String?  @db.Uuid
  method         String   @default("POS_TICKET") // 'POS_TICKET' or 'BUFFET_BATCH'
  serverStaffId  String?  @db.Uuid
  operationId    String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz

  property    Property    @relation(fields: [propertyId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])
  posOrder    PosOrder?   @relation(fields: [posOrderId], references: [id])

  @@unique([propertyId, reservationId, businessDate, operationId])
  @@index([propertyId, businessDate])
}

// -----------------------------------------------------------------------------
// ENTERPRISE HR & PAYROLL MANAGEMENT SUITE
// -----------------------------------------------------------------------------

model EmployeeProfile {
  id      String @id @default(uuid()) @db.Uuid
  staffId String @unique @db.Uuid
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  nin String? // National Identity Number
  tin String? // Tax Identification Number
  bvn String? // Bank Verification Number (masked in API responses)

  dateOfBirth        DateTime? @db.Date
  gender             String? // MALE | FEMALE | OTHER
  maritalStatus      String? // SINGLE | MARRIED | DIVORCED | WIDOWED
  nationality        String?   @default("Nigerian")
  stateOfOrigin      String?
  lgaOfOrigin        String?
  residentialAddress String?

