  roomId     String?  @db.Uuid
  room       Room?    @relation(fields: [roomId], references: [id])

  lockCode     String    @unique
  provider     String
  serialNumber String?
  status       String // 'ONLINE' | 'OFFLINE' | 'ERROR'
  batteryLevel Int?
  lastSyncAt   DateTime? @db.Timestamptz
  metadata     Json?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  credentials LockCredential[]
  operations  LockOperation[]
}

model LockCredential {
  id            String      @id @default(uuid()) @db.Uuid
  reservationId String      @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  guestId       String?     @db.Uuid
  guest         Guest?      @relation(fields: [guestId], references: [id])
  roomId        String      @db.Uuid
  room          Room        @relation(fields: [roomId], references: [id])
  lockId        String      @db.Uuid
  lock          DoorLock    @relation(fields: [lockId], references: [id])

  credentialType String // 'rfid' | 'pin' | 'mobile' | 'nfc'
  status         String // 'PENDING' | 'ACTIVE' | 'REVOKED' | 'EXPIRED' | 'FAILED'
  validFrom      DateTime @db.Timestamptz
  validUntil     DateTime @db.Timestamptz

  cardSerialNumber String?
  issueOperationId String? @db.Uuid

  issuedAt  DateTime? @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz
  metadata  Json?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model LockOperation {
  id             String       @id @default(uuid()) @db.Uuid
  idempotencyKey String?      @unique
  propertyId     String       @db.Uuid
  property       Property     @relation(fields: [propertyId], references: [id])
  lockId         String?      @db.Uuid
  lock           DoorLock?    @relation(fields: [lockId], references: [id])
  roomId         String?      @db.Uuid
  room           Room?        @relation(fields: [roomId], references: [id])
  reservationId  String?      @db.Uuid
  reservation    Reservation? @relation(fields: [reservationId], references: [id])
  credentialId   String?      @db.Uuid

  commandId String?      @unique @db.Uuid
  command   LockCommand? @relation(fields: [commandId], references: [id])

  operation String // 'CREATE_CREDENTIAL' | 'ENCODE_CARD' | 'VERIFY_CARD' | 'REVOKE_CREDENTIAL'
  status    String // 'QUEUED' | 'DISPATCHING' | 'WAITING_FOR_CARD' | 'CARD_DETECTED' | 'ENCODING' | 'VERIFYING' | 'ACTIVE' | 'FAILED' | 'REVOKING' | 'REVOKED'

  errorCode    String?
  errorMessage String?
  payloadHash  String?
  attemptCount Int     @default(0)

  requestedAt DateTime  @default(now()) @db.Timestamptz
  startedAt   DateTime? @db.Timestamptz
  completedAt DateTime? @db.Timestamptz

  agentId String?        @db.Uuid
  agent   HardwareAgent? @relation(fields: [agentId], references: [id])

  deviceId String?
  metadata Json?
}

model LockCommand {
  id          String         @id @default(uuid()) @db.Uuid
  operationId String         @db.Uuid
  operation   LockOperation?

  agentId String        @db.Uuid
  agent   HardwareAgent @relation(fields: [agentId], references: [id])

  commandType String
  payload     Json
  status      String // 'QUEUED' | 'CLAIMED' | 'PROCESSING' | 'COMPLETED' | 'FAILED' | 'DEAD_LETTER' | 'CANCELLED'

  attempts Int @default(0)

  availableAt    DateTime  @default(now()) @db.Timestamptz
  claimedAt      DateTime? @db.Timestamptz
  leaseExpiresAt DateTime? @db.Timestamptz
  completedAt    DateTime? @db.Timestamptz

  errorCode    String?
  errorMessage String?
  responseData Json?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

// Durable audit trail for every hardware step. Used for debugging guest key issues.
model LockEvent {
  id            String         @id @default(uuid()) @db.Uuid
  propertyId    String         @db.Uuid
  property      Property       @relation(fields: [propertyId], references: [id])
  agentId       String?        @db.Uuid
  agent         HardwareAgent? @relation(fields: [agentId], references: [id])
  roomId        String?        @db.Uuid
  reservationId String?        @db.Uuid
  credentialId  String?        @db.Uuid
  operationId   String?        @db.Uuid
  commandId     String?        @db.Uuid

  eventType String // AGENT_CONNECTED | AGENT_DISCONNECTED | COMMAND_RECEIVED | CARD_WAITING |
  // CARD_DETECTED | ENCODING_STARTED | ENCODING_COMPLETED | VERIFICATION_STARTED |
  // VERIFICATION_COMPLETED | REVOCATION_STARTED | REVOCATION_COMPLETED |
  // HARDWARE_ERROR | SDK_ERROR
  payload   Json?

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([propertyId, createdAt])
  @@index([operationId])
  @@index([reservationId])
}

model IntegrationConfig {
  id              String   @id @default(uuid()) @db.Uuid
  propertyId      String   @db.Uuid
  property        Property @relation(fields: [propertyId], references: [id])
  type            String // 'payment' | 'lock' | 'email' | 'sms' | 'ota' | 'pos' | 'gov'
