generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [btree_gist]
}

// -----------------------------------------------------------------------------
// CORE ENTITIES
// -----------------------------------------------------------------------------

model Organization {
  id              String  @id @default(uuid()) @db.Uuid
  name            String
  slug            String  @unique
  logoUrl         String?
  primaryColor    String?
  secondaryColor  String?
  defaultCurrency String  @default("NGN")
  defaultTimezone String  @default("Africa/Lagos")
  defaultLocale   String  @default("en-NG")
  settings        Json?

  properties    Property[]
  guests        Guest[]
  staff         Staff[]
  roles         Role[]
  notifications Notification[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model Property {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  name         String
  code         String  @unique
  address      String
  city         String
  state        String
  country      String
  phone        String
  email        String
  website      String?
  starRating   Int?
  checkInTime  String  @default("14:00")
  checkOutTime String  @default("12:00")

  baseCurrency        String   @default("NGN")
  supportedCurrencies String[]

  businessDate DateTime? @db.Date
  lastAuditAt  DateTime? @db.Timestamptz
  auditStatus  String? // 'OPEN' | 'IN_PROGRESS' | 'CLOSED'

  isActive Boolean @default(true)

  timezone          String @default("Africa/Lagos")
  locale            String @default("en-NG")
  settings          Json?
  lockConfiguration Json? // { provider: "DELUNS", dlsCoID: 12345, encoderPort: 1 }

  buildings            Building[]
  roomTypes            RoomType[]
  rooms                Room[]
  amenities            Amenity[]
  ratePlans            RatePlan[]
  exchangeRates        ExchangeRate[]
  reservations         Reservation[]
  folios               Folio[]
  payments             Payment[]
  refunds              Refund[]
  taxes                Tax[]
  discounts            Discount[]
  housekeepingTasks    HousekeepingTask[]
  housekeepingShifts   HousekeepingShift[]
  maintenanceTickets   MaintenanceTicket[]
  maintenanceCats      MaintenanceCategory[]
  doorLocks            DoorLock[]
  hardwareAgents       HardwareAgent[]
  lockOperations       LockOperation[]
  lockEvents           LockEvent[]
  integrationConfigs   IntegrationConfig[]
  govSubmissions       GovernmentSubmission[]
  nightAudits          NightAudit[]
  occupancySnapshots   OccupancySnapshot[]
  guestServiceRequests GuestServiceRequest[]
  cancellationPolicies CancellationPolicy[]
  depositPolicies      DepositPolicy[]
  noShowPolicies       NoShowPolicy[]
  userRoles            UserRole[]
  suppliers            Supplier[]
  warehouses           Warehouse[]
  stockItems           StockItem[]
  stockTransactions    StockTransaction[]
  purchaseOrders       PurchaseOrder[]
  goodsReceivedNotes   GoodsReceivedNote[]
  posOutlets           PosOutlet[]
  posDevices           PosDevice[]
  posProducts          PosProduct[]
  posOrders            PosOrder[]
  uomConversions       UnitOfMeasureConversion[]
  enrollmentTokens     AgentEnrollmentToken[]
  syncConflicts        SyncConflict[]
  inventoryAlerts      InventoryAlert[]

  createdAt  DateTime     @default(now()) @db.Timestamptz
  updatedAt  DateTime     @updatedAt @db.Timestamptz
  deletedAt  DateTime?    @db.Timestamptz
  PosSession PosSession[]
}

model Building {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @db.Uuid
  property    Property @relation(fields: [propertyId], references: [id])
  name        String
  code        String
  floorsCount Int      @map("floors")
  description String?
  isActive    Boolean  @default(true)

  floors Floor[]
  rooms  Room[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model Floor {
  id          String   @id @default(uuid()) @db.Uuid
  buildingId  String   @db.Uuid
  building    Building @relation(fields: [buildingId], references: [id])
  propertyId  String   @db.Uuid
  number      Int
  name        String
  code        String?
  description String?
  isActive    Boolean  @default(true)

  rooms Room[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([buildingId, number])
}

model RoomType {
  id               String   @id @default(uuid()) @db.Uuid
  propertyId       String   @db.Uuid
  property         Property @relation(fields: [propertyId], references: [id])
  name             String
  code             String
  description      String?
  maxOccupancy     Int
  maxAdults        Int      @default(2)
  maxChildren      Int      @default(0)
  defaultBedConfig String
  amenities        String[]
  photos           String[]
  baseRate         Decimal  @db.Decimal(18, 4)
  currency         String
  isActive         Boolean  @default(true)

  rooms         Room[]
  rates         Rate[]
  seasonalRates SeasonalRate[]

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz
}

enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  DIRTY
  CLEANING
  CLEAN
  INSPECTED
  OUT_OF_ORDER
  OUT_OF_SERVICE
  MAINTENANCE
  BLOCKED
}

enum HousekeepingStatus {
  PENDING
  ASSIGNED
  CLEANING
  CLEAN
  INSPECTED
  CANCELLED
  MAINTENANCE_REQUIRED
}

enum RoomMaintenanceStatus {
  NONE
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum RoomStatusSource {
  MANUAL
  CHECK_IN
  CHECK_OUT
  HOUSEKEEPING
  MAINTENANCE
  RESERVATION
  SYSTEM
}

model Room {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  buildingId String   @db.Uuid
  building   Building @relation(fields: [buildingId], references: [id])
  floorId    String   @db.Uuid
  floor      Floor    @relation(fields: [floorId], references: [id])
  roomTypeId String   @db.Uuid
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])

  number           String
  code             String?  @unique // optional globally-unique identifier
  displayName      String?
  name             String?
  maxOccupancy     Int
  maxAdults        Int      @default(2)
  maxChildren      Int      @default(0)
  floorPosition    Int? // position on floor plan
  bedConfiguration String
  squareMeters     Decimal? @db.Decimal(8, 2)
  view             String?
  amenities        String[]
  photos           String[]
  description      String?

  status             RoomStatus
  housekeepingStatus HousekeepingStatus
  maintenanceStatus  RoomMaintenanceStatus @default(NONE)
  isAccessible       Boolean               @default(false)
  isActive           Boolean               @default(true)
  notes              String?

  roomBlocks        RoomBlock[]
  reservationRooms  ReservationRoom[]
  housekeepingTasks HousekeepingTask[]
  doorLocks         DoorLock[]
  lockCredentials   LockCredential[]
  lockOperations    LockOperation[]
  statusHistory     RoomStatusHistory[]

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  @@unique([propertyId, number])
}

model Amenity {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  name       String
  category   String
  icon       String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

enum BlockType {
  MAINTENANCE
  OUT_OF_ORDER
  OUT_OF_SERVICE
  HOUSE_USE
  OWNER_USE
  COMPLIMENTARY
  INVENTORY_BLOCK
  DEEP_CLEAN
  OTHER
}

model RoomBlock {
  id           String    @id @default(uuid()) @db.Uuid
  roomId       String    @db.Uuid
  room         Room      @relation(fields: [roomId], references: [id])
  propertyId   String    @db.Uuid
  type         BlockType
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  reason       String
  notes        String?
  authorizedBy String    @db.Uuid // Staff ID
  status       String    @default("ACTIVE") // ACTIVE | CANCELLED

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model RoomStatusHistory {
  id         String @id @default(uuid()) @db.Uuid
  roomId     String @db.Uuid
  room       Room   @relation(fields: [roomId], references: [id])
  propertyId String @db.Uuid

  previousStatus RoomStatus
  newStatus      RoomStatus
  source         RoomStatusSource
  referenceId    String? // e.g. reservation ID, block ID
  changedBy      String?          @db.Uuid // Staff ID; null if system
  reason         String?

  createdAt DateTime @default(now()) @db.Timestamptz
}

// -----------------------------------------------------------------------------
// AVAILABILITY & RATES
// -----------------------------------------------------------------------------

enum RatePlanType {
  STANDARD
  CORPORATE
  GROUP
  PROMOTIONAL
  SEASONAL
  GOVERNMENT
  CUSTOM
}

model RatePlan {
  id          String       @id @default(uuid()) @db.Uuid
  propertyId  String       @db.Uuid
  property    Property     @relation(fields: [propertyId], references: [id])
  name        String
  code        String
  description String?
  type        RatePlanType
  isPublic    Boolean      @default(true)
  isActive    Boolean      @default(true)

  minStay            Int        @default(1)
  maxStay            Int?
  advanceBookingDays Int?
  blackoutDates      DateTime[] @db.Date

  cancellationPolicyId String?             @db.Uuid
  cancellationPolicy   CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])
  depositPolicyId      String?             @db.Uuid
  depositPolicy        DepositPolicy?      @relation(fields: [depositPolicyId], references: [id])
  noShowPolicyId       String?             @db.Uuid
  noShowPolicy         NoShowPolicy?       @relation(fields: [noShowPolicyId], references: [id])

  rates         Rate[]
  seasonalRates SeasonalRate[]
  reservations  Reservation[]

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz
}

model Rate {
  id         String   @id @default(uuid()) @db.Uuid
  ratePlanId String   @db.Uuid
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id])
  roomTypeId String   @db.Uuid
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])
  propertyId String   @db.Uuid

  amount   Decimal @db.Decimal(18, 4)
  currency String

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  dayOfWeek     Int[] // 0=Sun, 6=Sat

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model SeasonalRate {
  id         String   @id @default(uuid()) @db.Uuid
  ratePlanId String   @db.Uuid
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id])
  roomTypeId String   @db.Uuid
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])

  name     String
  amount   Decimal @db.Decimal(18, 4)
  currency String

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model CancellationPolicy {
  id                 String   @id @default(uuid()) @db.Uuid
  propertyId         String   @db.Uuid
  property           Property @relation(fields: [propertyId], references: [id])
  name               String
  type               String // 'FLEXIBLE' | 'MODERATE' | 'STRICT' | 'NON_REFUNDABLE'
  hoursBeforeCheckIn Int
  penaltyType        String // 'NONE' | 'FIRST_NIGHT' | 'PERCENTAGE' | 'FLAT'
  penaltyValue       Decimal  @db.Decimal(18, 4)

  ratePlans    RatePlan[]
  reservations Reservation[]
}

model DepositPolicy {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @db.Uuid
  property     Property @relation(fields: [propertyId], references: [id])
  name         String
  required     Boolean
  type         String // 'PERCENTAGE' | 'FLAT' | 'FIRST_NIGHT'
  value        Decimal  @db.Decimal(18, 4)
  dueAtBooking Boolean

  ratePlans    RatePlan[]
  reservations Reservation[]
}

model NoShowPolicy {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @db.Uuid
  property    Property @relation(fields: [propertyId], references: [id])
  name        String
  chargeType  String // 'NONE' | 'FIRST_NIGHT' | 'FULL_STAY' | 'PERCENTAGE'
  chargeValue Decimal  @db.Decimal(18, 4)

  ratePlans    RatePlan[]
  reservations Reservation[]
}

model ExchangeRate {
  id            String   @id @default(uuid()) @db.Uuid
  propertyId    String   @db.Uuid
  property      Property @relation(fields: [propertyId], references: [id])
  fromCurrency  String
  toCurrency    String
  rate          Decimal  @db.Decimal(18, 8)
  source        String
  effectiveDate DateTime @db.Date
  createdBy     String   @db.Uuid // Staff ID

  createdAt DateTime @default(now()) @db.Timestamptz
}

// -----------------------------------------------------------------------------
// GUEST & RESERVATION
// -----------------------------------------------------------------------------

model Guest {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  firstName String
  lastName  String
  email     String?
  phone     String?

  dateOfBirth DateTime? @db.Date
  gender      String?
  nationality String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?

  idType            String?
  idNumberEncrypted String?
  idNumberHint      String?

  companyName String?
  companyId   String? @db.Uuid

  isVip       Boolean @default(false)
  vipLevel    String?
  preferences Json?
  notes       String?

  documents         GuestDocument[]
  reservations      Reservation[]
  folios            Folio[]
  guestServiceReqs  GuestServiceRequest[]
  reservationGuests ReservationGuest[]
  lockCredentials   LockCredential[]

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz
}

model GuestDocument {
  id         String    @id @default(uuid()) @db.Uuid
  guestId    String    @db.Uuid
  guest      Guest     @relation(fields: [guestId], references: [id])
  type       String
  fileUrl    String
  uploadedAt DateTime  @default(now()) @db.Timestamptz
  expiresAt  DateTime? @db.Timestamptz
}

enum ReservationSource {
  WALK_IN
  PHONE
  EMAIL
  WEBSITE
  OTA
  CORPORATE
  OTHER
}

enum ReservationStatus {
  INQUIRY
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  EXPIRED
}

model Reservation {
  id                 String   @id @default(uuid()) @db.Uuid
  propertyId         String   @db.Uuid
  property           Property @relation(fields: [propertyId], references: [id])
  confirmationNumber String   @unique

  primaryGuestId String  @db.Uuid
  primaryGuest   Guest   @relation(fields: [primaryGuestId], references: [id])
  companyId      String? @db.Uuid

  source     ReservationSource
  channelRef String?
  status     ReservationStatus

  checkIn  DateTime @db.Date
  checkOut DateTime @db.Date
  adults   Int
  children Int

  ratePlanId       String   @db.Uuid
  ratePlan         RatePlan @relation(fields: [ratePlanId], references: [id])
  ratePlanSnapshot Json

  cancellationPolicyId String?             @db.Uuid
  cancellationPolicy   CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])
  depositPolicyId      String?             @db.Uuid
  depositPolicy        DepositPolicy?      @relation(fields: [depositPolicyId], references: [id])
  noShowPolicyId       String?             @db.Uuid
  noShowPolicy         NoShowPolicy?       @relation(fields: [noShowPolicyId], references: [id])

  depositRequired Decimal? @db.Decimal(18, 4)
  depositPaid     Decimal? @db.Decimal(18, 4)
  currency        String

  specialRequests String?
  internalNotes   String?

  earlyCheckIn       Boolean  @default(false)
  lateCheckOut       Boolean  @default(false)
  earlyCheckInCharge Decimal? @db.Decimal(18, 4)
  lateCheckOutCharge Decimal? @db.Decimal(18, 4)

  cancelledAt        DateTime? @db.Timestamptz
  cancelledBy        String?   @db.Uuid // Staff ID
  cancellationReason String?

  noShowAt DateTime? @db.Timestamptz
  noShowBy String?   @db.Uuid // Staff ID

  version   Int    @default(1) // Optimistic locking
  createdBy String @db.Uuid // Staff ID

  reservationGuests ReservationGuest[]
  reservationRooms  ReservationRoom[]
  folios            Folio[]
  payments          Payment[]
  guestServiceReqs  GuestServiceRequest[]
  lockCredentials   LockCredential[]
  lockOperations    LockOperation[]
  priorities        ReservationPriority[]

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz
}

model ReservationGuest {
  id            String      @id @default(uuid()) @db.Uuid
  reservationId String      @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  guestId       String      @db.Uuid
  guest         Guest       @relation(fields: [guestId], references: [id])
  isPrimary     Boolean     @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz
}

model ReservationRoom {
  id            String      @id @default(uuid()) @db.Uuid
  reservationId String      @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  roomTypeId    String      @db.Uuid
  roomId        String?     @db.Uuid
  room          Room?       @relation(fields: [roomId], references: [id])

  checkIn  DateTime @db.Date
  checkOut DateTime @db.Date
  adults   Int
  children Int

  ratePlanId String  @db.Uuid
  rateAmount Decimal @db.Decimal(18, 4)
  currency   String

  status String // 'ACTIVE', 'CANCELLED', 'NO_SHOW'

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Note: Exclusion constraint will be added via migration:
  // EXCLUDE USING GIST (roomId WITH =, daterange(checkIn, checkOut, '[)') WITH &&)
  // WHERE (status NOT IN ('CANCELLED', 'NO_SHOW'))
}

// -----------------------------------------------------------------------------
// FINANCIAL
// -----------------------------------------------------------------------------

model Folio {
  id            String       @id @default(uuid()) @db.Uuid
  reservationId String?      @db.Uuid // null for master/city ledgers
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  propertyId    String       @db.Uuid
  property      Property     @relation(fields: [propertyId], references: [id])
  guestId       String?      @db.Uuid
  guest         Guest?       @relation(fields: [guestId], references: [id])

  folioNumber String @unique
  type        String // 'ROOM' | 'MASTER' | 'CITY_LEDGER'
  status      String // 'OPEN' | 'CLOSED' | 'VOID'
  currency    String

  totalCharges  Decimal @default(0) @db.Decimal(18, 4)
  totalPayments Decimal @default(0) @db.Decimal(18, 4)
  balance       Decimal @default(0) @db.Decimal(18, 4)

  closedAt DateTime? @db.Timestamptz
  closedBy String?   @db.Uuid

  version Int @default(1)

  items     FolioItem[]
  payments  Payment[]
  refunds   Refund[]
  posOrders PosOrder[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

enum FolioItemSource {
  ROOM_CHARGE
  MANUAL
  POS
  RESTAURANT
  BAR
  SPA
  LAUNDRY
  TRANSPORT
  TELEPHONE
  INTERNET
  MINIBAR
  OTHER
}

model FolioItem {
  id      String @id @default(uuid()) @db.Uuid
  folioId String @db.Uuid
  folio   Folio  @relation(fields: [folioId], references: [id])

  businessDate DateTime        @db.Date
  type         String // 'CHARGE' | 'PAYMENT' | 'REFUND' | 'DISCOUNT' | 'ADJUSTMENT' | 'TAX'
  source       FolioItemSource
  description  String

  quantity   Decimal @default(1) @db.Decimal(10, 4)
  unitAmount Decimal @db.Decimal(18, 4)
  amount     Decimal @db.Decimal(18, 4)
  currency   String

  baseAmount   Decimal  @db.Decimal(18, 4)
  exchangeRate Decimal? @db.Decimal(18, 8)

  taxId            String? @db.Uuid
  discountId       String? @db.Uuid
  posTransactionId String?

  voidedAt   DateTime? @db.Timestamptz
  voidedBy   String?   @db.Uuid
  voidReason String?

  postedBy String @db.Uuid

  // Late Posting & Audit Fields
  deviceId             String?
  operationId          String?
  isLatePosting        Boolean   @default(false)
  latePostingReason    String?
  originalBusinessDate DateTime? @db.Date
  syncedAt             DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  POS
  CARD
  CARD_OFFLINE
  PAYMENT_GATEWAY
  MOBILE_PAYMENT
  CHEQUE
  ROOM_CHARGE
  OTHER
}

model Payment {
  id            String       @id @default(uuid()) @db.Uuid
  folioId       String       @db.Uuid
  folio         Folio        @relation(fields: [folioId], references: [id])
  reservationId String?      @db.Uuid
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  propertyId    String       @db.Uuid
  property      Property     @relation(fields: [propertyId], references: [id])

  method                PaymentMethod
  provider              String?
  providerTransactionId String?
  providerRef           String?

  amount       Decimal  @db.Decimal(18, 4)
  currency     String
  baseAmount   Decimal  @db.Decimal(18, 4)
  exchangeRate Decimal? @db.Decimal(18, 8)

  status         String // 'PENDING' | 'COMPLETED' | 'FAILED' | 'REFUNDED'
  idempotencyKey String? @unique
  receiptNumber  String? @unique

  receivedBy String  @db.Uuid // Staff ID
  notes      String?

  // Late Posting & Audit Fields
  deviceId             String?
  operationId          String?
  isLatePosting        Boolean   @default(false)
  latePostingReason    String?
  originalBusinessDate DateTime? @db.Date
  syncedAt             DateTime? @db.Timestamptz

  refunds Refund[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model Refund {
  id         String   @id @default(uuid()) @db.Uuid
  paymentId  String   @db.Uuid
  payment    Payment  @relation(fields: [paymentId], references: [id])
  folioId    String   @db.Uuid
  folio      Folio    @relation(fields: [folioId], references: [id])
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])

  amount           Decimal @db.Decimal(18, 4)
  currency         String
  reason           String
  authorizedBy     String  @db.Uuid
  providerRefundId String?

  status         String // 'PENDING' | 'COMPLETED' | 'FAILED'
  idempotencyKey String? @unique

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model Tax {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @db.Uuid
  property    Property @relation(fields: [propertyId], references: [id])
  name        String
  code        String
  type        String // 'PERCENTAGE' | 'FLAT'
  rate        Decimal  @db.Decimal(8, 4)
  appliesTo   String[]
  isInclusive Boolean  @default(false)
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model Discount {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  name       String
  code       String
  type       String // 'PERCENTAGE' | 'FLAT'
  value      Decimal  @db.Decimal(18, 4)

  maxUses   Int?
  usedCount Int       @default(0)
  validFrom DateTime  @db.Timestamptz
  validTo   DateTime? @db.Timestamptz
  isActive  Boolean   @default(true)

