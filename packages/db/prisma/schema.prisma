  email        String  @unique
  passwordHash String
  isSuperAdmin Boolean @default(false)

  lastLoginAt DateTime? @db.Timestamptz
  lastLoginIp String?

  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz
