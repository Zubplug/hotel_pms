{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "DIRECT_URL",
    "NEXTAUTH_URL",
    "AUTH_SECRET",
    "NEXTAUTH_SECRET",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "LODGECORE_FROM_EMAIL",
    "CRON_SECRET",
    "FIREBASE_SERVICE_ACCOUNT_KEY",
    "CHANNEX_ENABLED",
    "OTA_RESERVATION_IMPORT",
    "OTA_AVAILABILITY_PUSH",
    "OTA_RATE_PUSH",
    "FLW_SECRET_KEY",
    "FLW_WEBHOOK_SECRET_HASH",
    "LC_PUBLISHABLE_KEY",
    "LC_API_URL",
    "CONTACT_EMAIL_TO",
    "CONTACT_EMAIL_FROM",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "PAYMENT_CREDENTIALS_ENCRYPTION_KEY",
    "BLOB_STORE_ID",
    "BLOB_WEBHOOK_PUBLIC_KEY",
    "BLOB_READ_WRITE_TOKEN",
    "QSTASH_URL",
    "QSTASH_TOKEN",
    "QSTASH_CURRENT_SIGNING_KEY",
    "QSTASH_NEXT_SIGNING_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "type-check": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    }
  }
}
