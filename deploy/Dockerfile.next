FROM node:22-bookworm-slim AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV CI=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY apps/website/package.json apps/website/package.json
COPY apps/hotel-stanzel/package.json apps/hotel-stanzel/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/db/prisma/schema.prisma packages/db/prisma/schema.prisma
COPY packages/storage/package.json packages/storage/package.json
COPY packages/types/package.json packages/types/package.json

FROM base AS build
ARG APP
ARG AUTH_SECRET
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS=--max-old-space-size=4096
# Next.js middleware reads Auth.js configuration in the build output. Pass the
# production secret into the build so middleware and the runtime server use the
# same signing key. The runtime container still receives the secret via env_file.
ENV AUTH_SECRET=$AUTH_SECRET
RUN --mount=type=cache,id=hotel-pms-pnpm-store,target=/pnpm/store,sharing=locked pnpm install --frozen-lockfile
COPY . .
RUN pnpm --filter "$APP" build

# Next.js standalone tracing does not reliably include Prisma's native query
# engine when the client lives in a pnpm workspace package. Stage the engine
# explicitly so the runtime image can place it beside the standalone server.
RUN set -eux; \
    engine="$(find /app -type f -name 'libquery_engine-debian-openssl-3.0.x.so.node' -print -quit)"; \
    test -n "$engine"; \
    mkdir -p /app/prisma-engine; \
    cp "$engine" /app/prisma-engine/libquery_engine-debian-openssl-3.0.x.so.node

FROM base AS runtime
ARG APP
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV APP="$APP"

# Only ship the Next.js standalone server, static assets, and public files.
# This keeps each runtime image small enough for the EC2 root volume.
COPY --from=build /app/apps/${APP}/.next/standalone ./
COPY --from=build /app/apps/${APP}/.next/static ./apps/${APP}/.next/static
COPY --from=build /app/apps/${APP}/public ./apps/${APP}/public
# Prisma searches the standalone server directory for the native engine.
COPY --from=build /app/prisma-engine/libquery_engine-debian-openssl-3.0.x.so.node ./apps/${APP}/.next/server/

EXPOSE 3000
CMD ["sh", "-c", "node apps/$APP/server.js"]
