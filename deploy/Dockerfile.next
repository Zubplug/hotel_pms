FROM node:22-bookworm-slim AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV CI=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY apps/website/package.json apps/website/package.json
COPY apps/hotel-stanzel/package.json apps/hotel-stanzel/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/db/prisma/schema.prisma packages/db/prisma/schema.prisma
COPY packages/types/package.json packages/types/package.json

FROM base AS build
ARG APP
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS=--max-old-space-size=4096
RUN --mount=type=cache,id=hotel-pms-pnpm-store,target=/pnpm/store,sharing=locked pnpm install --frozen-lockfile
COPY . .
RUN pnpm --filter "$APP" build

FROM base AS runtime
ARG APP
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV APP="$APP"

# Keep the complete workspace in the runtime image. This is intentionally
# simple and reliable for the first EC2 deployment; it can later be changed
# to Next.js standalone output to reduce image size.
COPY --from=build /app /app
# Do not run `pnpm prune --prod` here: in this pnpm workspace it removes the
# app-level executable links, including `next`, from the runtime image.

EXPOSE 3000
CMD ["sh", "-c", "pnpm --filter \"$APP\" exec next start -p ${PORT:-3000} -H 0.0.0.0"]
