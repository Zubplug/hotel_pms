[Unit]
Description=LodgeCore Commerce sync recovery

[Service]
Type=oneshot
EnvironmentFile=/opt/hotel_pms/deploy/.env.aws
ExecStart=/opt/hotel_pms/deploy/cron/run-job.sh commerce-scheduled-orders https://pms.zubplug.com.ng/api/v1/cron/commerce-scheduled-orders GET
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/lock
