[Unit]
Description=LodgeCore Commerce sync watchdog

[Service]
Type=oneshot
EnvironmentFile=/opt/hotel_pms/deploy/.env.aws
ExecStart=/opt/hotel_pms/deploy/cron/run-job.sh commerce-sync-watchdog https://pms.zubplug.com.ng/api/v1/cron/commerce-sync-watchdog GET
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/lock
