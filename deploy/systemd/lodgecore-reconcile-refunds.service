[Unit]
Description=LodgeCore reconcile payment refunds

[Service]
Type=oneshot
EnvironmentFile=/opt/hotel_pms/deploy/.env.aws
ExecStart=/opt/hotel_pms/deploy/cron/run-job.sh reconcile-refunds https://lodgecore.zubplug.com.ng/api/v1/cron/reconcile-flutterwave-refunds GET
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/lock
