[Unit]
Description=LodgeCore expire demo accounts

[Service]
Type=oneshot
EnvironmentFile=/opt/hotel_pms/deploy/.env.aws
ExecStart=/opt/hotel_pms/deploy/cron/run-job.sh expire-demo-accounts https://lodgecore.zubplug.com.ng/api/cron/expire-demo-accounts GET
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/lock
