[Unit]
Description=LodgeCore expire booking holds

[Service]
Type=oneshot
EnvironmentFile=/opt/hotel_pms/deploy/.env.aws
ExecStart=/opt/hotel_pms/deploy/cron/run-job.sh expire-booking-holds https://lodgecore.zubplug.com.ng/api/v1/cron/expire-booking-holds POST
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/lock
