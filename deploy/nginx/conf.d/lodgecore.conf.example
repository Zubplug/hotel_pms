upstream lodgecore_pms { server pms:3000; }
upstream lodgecore_website { server website:3000; }
upstream lodgecore_stanzel { server stanzel:3000; }

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name pms.zubplug.com.ng lodgecore.zubplug.com.ng stanzelgrandresort.org www.stanzelgrandresort.org;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name pms.zubplug.com.ng;
    ssl_certificate /etc/letsencrypt/live/pms.zubplug.com.ng/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pms.zubplug.com.ng/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    # Auth.js JWT cookies can exceed Nginx's small default upstream header
    # buffers. Keep the full session response and subsequent Cookie header
    # available without weakening authentication.
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;
    large_client_header_buffers 4 32k;
    location / {
        proxy_pass http://lodgecore_pms;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name lodgecore.zubplug.com.ng;
    ssl_certificate /etc/letsencrypt/live/pms.zubplug.com.ng/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pms.zubplug.com.ng/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;
    large_client_header_buffers 4 32k;
    location / {
        proxy_pass http://lodgecore_website;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name stanzelgrandresort.org www.stanzelgrandresort.org;
    ssl_certificate /etc/letsencrypt/live/pms.zubplug.com.ng/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pms.zubplug.com.ng/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;
    large_client_header_buffers 4 32k;
    location / {
        proxy_pass http://lodgecore_stanzel;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
