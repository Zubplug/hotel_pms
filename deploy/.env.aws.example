# Copy to deploy/.env.aws on the EC2 host and chmod 600 it.
# Never commit deploy/.env.aws.

NODE_ENV=production
NEXT_PUBLIC_IS_DESKTOP=false

# S3 object storage. Keep the bucket private; use an S3_PUBLIC_BASE_URL backed
# by CloudFront (recommended) or an intentionally public media-only endpoint.
AWS_REGION=eu-north-1
S3_BUCKET=
S3_PUBLIC_BASE_URL=
S3_ENDPOINT=

# Neon production connection strings
DATABASE_URL=
DIRECT_URL=

# Authentication. NEXTAUTH_URL is overridden per service in
# docker-compose.aws.yml: PMS uses pms.zubplug.com.ng and the customer portal
# website uses lodgecore.zubplug.com.ng.
NEXTAUTH_URL=https://pms.example.com
NEXTAUTH_SECRET=
AUTH_SECRET=

# Scheduled route authentication
CRON_SECRET=

# Public origins used by clients and integrations
NEXT_PUBLIC_API_URL=https://pms.example.com/api
# Server-to-server booking API call: the public API is served by the website
# container, not the PMS container. Keep this on the private Compose network.
LC_API_URL=http://website:3000/api/v1/public
CORPORATE_API_URL=https://pms.example.com
CORPORATE_PORTAL_ORIGIN=https://www.stanzelgrandresort.org
CHANNEX_ENABLED=true
OTA_RESERVATION_IMPORT=true
OTA_AVAILABILITY_PUSH=false
OTA_RATE_PUSH=false

# Stanzel website
NEXT_PUBLIC_SITE_URL=https://stanzel.example.com
PUBLIC_SITE_ORIGIN=https://stanzel.example.com
CORPORATE_PROPERTY_ID=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
LC_PUBLISHABLE_KEY=

# Email and payments
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LODGECORE_FROM_EMAIL=
PAYSTACK_SECRET_KEY=
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET_HASH=

# Keep QStash/Upstash values if those integrations are active.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional integrations
FIREBASE_SERVICE_ACCOUNT_KEY=
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=
